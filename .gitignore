# Maven
target/
*.jar
*.war
*.class

# IDEs
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.vscode/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# the test suite loads pool-run/pool-watch with SourceFileLoader
.claude/pipeline/__pycache__/

# Isolated worktrees for review subagents. Created per agent, removed when it ends —
# never part of the source, and `git add -A` from the main checkout sweeps them in as
# embedded repositories if they are not ignored.
.claude/worktrees/

# Evidence logs under the skill-lessons artifact store are records, not build noise:
# mutation runs here ground published figures and must stay verifiable.
!.claude/skill-lessons/artifacts/**/*.log

# Run records of private tickets, and the PR pairings beside them, stay on the machine that ran
# them. skill-retro never mirrors confidential/; this keeps a recursive copy out of git anyway.
.claude/skill-lessons/confidential/

# skill-lint.py imported as a module, by a word count or a test, leaves this beside it
.claude/skills/skill-retro/__pycache__/
