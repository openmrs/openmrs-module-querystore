#!/usr/bin/env python3
"""Run one headless agent that is blind to the calling session: an empty folder, its own stores, a deadline.

Usage: blind-run [--deadline SECS] [--allow TOOL ...] [--repo PATH --ref REF] NAME BRIEF_FILE
       blind-run --self-test

Why it exists (2026-11-20 retro):
- An Agent-tool subagent is not blind. It loads the calling project's memory index: three "independent" refutation
  rounds that day all carried the chartsearchai index, which held the source notes of two findings they were judging, and
  a 2026-10-23 "blind classifier" carried the owner's stated position on what it classified. A `claude -p` started in a
  folder no project owns loads none; four rounds run that way loaded no index and cost $1.08 to $1.85 each.
- Replays kept their isolation in an untracked `.mvn/maven.config` that `git worktree add` does not copy (a control run
  used the default Maven and OpenMRS locations, 2026-11-18), and shared `/tmp` paths (a log overwritten by a concurrent
  replay, the same day). Here the isolation is in the environment every child inherits, as pool-run does with MAVEN_ARGS.
- The folder lives under ~/.claude/blind-runs, not /tmp: macOS tmp_cleaner deletes /tmp files untouched for 3 days.
  Claude Code still keeps its own per-session notes under /private/tmp; this script does not move those.
- --repo made a `git worktree` until 2026-11-22, and Claude Code takes a worktree's memory folder from its main
  repository: a canary run that way on a checkout a project owns quoted that project's memory index back, so every
  --repo run had loaded it. A worktree also shares the checkout's refs, so the agent could list the session's branches
  and worktrees, and its own git writes landed in the checkout. `work` is now a repository of its own, and
  CLAUDE_CODE_DISABLE_AUTO_MEMORY keeps a memory index out wherever `work` is.

Layout: ~/.claude/blind-runs/<date>-<NAME>/{work,m2,appdata,tmp,log}. `work` is empty, or a repository of its own
detached at --ref that reads --repo's objects through git's alternates and holds its tags, its origin/* and upstream/*
branches as --repo has them with those remotes' settings, --ref's own ref, and the ref it tracks when that is a
branch; the checkout's other branches, remotes, stash and worktrees stay out of its refs. The objects stay shared
read-only, so `git fsck` or `git cat-file --batch-all-objects` in `work` still reaches the checkout's other commits, as
reading the checkout's folder always could: blind-run is no sandbox (no earlier blind-run agent ran either, 0 of 876
Bash calls on 2026-11-22; copying only the reachable objects instead took 6.5 s and 258 MB for openmrs-core, against
0.6 s and 2.3 MB). The agent gets read-only tools plus Bash unless --allow says otherwise, and never
Agent, Write or Edit. The report (log/report.md) is its last text, with a short Stop-hook amendment appended and a
longer rewrite replacing it, as skill-retro's mine.py reads one. Exit 2 when the agent never started (no init event),
3 when the deadline hit.
"""
import argparse
import contextlib
import datetime
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time

DENY = ["Write", "Edit", "NotebookEdit", "WebFetch", "WebSearch", "Agent", "Task", "Skill", "Workflow",
        # Tools that reach other sessions or publish (ListAgents listed 32 peers on 2026-11-20). Bash stays allowed, and
        # Bash can still post or push, so a brief that must not change anything says so.
        "ListAgents", "SendMessage", "RemoteTrigger", "PushNotification", "CronCreate", "CronDelete", "ScheduleWakeup",
        "Artifact", "ArtifactData", "ArtifactComments", "AskUserQuestion", "PublishPlugin", "ShareOnboardingGuide",
        "DesignSync"]
ALLOW = ["Bash", "Read", "Grep", "Glob"]


def report(stream_path):
    texts, result = [], None
    with open(stream_path, errors="replace") as f:
        for line in f:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get("type") == "result":
                result = d
            if d.get("type") != "assistant":
                continue
            for b in (d.get("message") or {}).get("content") or []:
                if isinstance(b, dict) and b.get("type") == "text" and b.get("text", "").strip():
                    t = b["text"].strip()
                    if texts and len(t) < len(texts[-1]) / 2:
                        texts[-1] += "\n\n" + t
                    else:
                        texts.append(t)
    return (texts[-1] if texts else ""), result


def git(*args, stdin=None, need=True):
    p = subprocess.run(["git", *args], input=stdin, capture_output=True, text=True)
    if p.returncode and need:
        sys.exit(f"blind-run: git {' '.join(args)} failed: {p.stderr.strip()}")
    return p.stdout.strip() if p.returncode == 0 else ""


REMOTES = ("origin", "upstream")


def clone(repo, ref, sha, work):
    """Make `work` a repository of its own at `sha`, reading `repo`'s objects through alternates, so nothing is copied
    and nothing is written to `repo`. origin/* comes from `repo`'s own origin/*: a plain clone would turn `repo`'s local
    branches into origin/*, and openmrs-core's local master was 76 commits behind its origin/master on 2026-11-22.
    upstream/* comes too, for a checkout whose origin is a fork (1 of the owner's 220 checkouts, 2026-11-22).
    The copy needs those objects to stay. A gc in `repo` drops objects no ref there reaches once they are older than
    gc.pruneExpire (two weeks by default, at once with --prune=now), so a ref the copy holds, such as an origin/* branch
    a fetch --prune removed or a --ref whose branch was deleted, can break mid-run; a worktree's HEAD kept its commit."""
    git("init", "-q", "--object-format=" + git("-C", repo, "rev-parse", "--show-object-format"), work)
    meta = os.path.join(work, ".git")
    with open(os.path.join(meta, "objects", "info", "alternates"), "w") as f:
        f.write(git("-C", repo, "rev-parse", "--path-format=absolute", "--git-path", "objects") + "\n")
    shallow = git("-C", repo, "rev-parse", "--path-format=absolute", "--git-path", "shallow")
    if os.path.exists(shallow):
        shutil.copyfile(shallow, os.path.join(meta, "shallow"))
    keep = [f"refs/remotes/{r}/" for r in REMOTES] + ["refs/tags/"]
    # Without --verify, git 2.39 prints --end-of-options back as a line of its own.
    branch = git("-C", repo, "rev-parse", "--verify", "--quiet", "--symbolic-full-name", "--end-of-options",
                 ref or "HEAD", need=False)
    short = branch[len("refs/heads/"):] if branch.startswith("refs/heads/") else ""
    tracked = ""
    if branch.startswith("refs/"):
        keep.append(branch)  # --ref's own ref in any namespace (fork/x too), so the name the caller gave resolves
    if short:
        # and the one ref --ref's branch tracks, whatever remote that is on, so <branch>@{u} still resolves
        tracked = git("-C", repo, "rev-parse", "--verify", "--quiet", "--symbolic-full-name", f"{short}@{{u}}",
                      need=False)
        if tracked.startswith(("refs/remotes/", "refs/heads/")):
            keep.append(tracked)
    packed, links = [], []
    for line in git("-C", repo, "for-each-ref", "--format=%(objectname) %(refname) %(symref)", *keep).splitlines():
        oid, name, target = (line.split(" ") + [""])[:3]
        if target:
            links.append((name, target))
        else:
            packed.append(f"{oid} {name}\n")
    # One packed-refs file, not a file per ref: macOS folds case in file names, so two tags differing only in case
    # (ugandaemr has 3.3.10_Beta and 3.3.10_beta) collided as files, and update-ref refused a ref whose object is gone.
    with open(os.path.join(meta, "packed-refs"), "w") as f:
        f.writelines(packed)
    for name, target in links:
        git("-C", work, "symbolic-ref", name, target)
    # Every setting of those remotes, the partial-clone ones too: a copy of a partial clone (4 of the owner's checkouts)
    # then fetches the blobs it lacks into its own object store, where without them its checkout came out half empty.
    settings = []
    for entry in git("-C", repo, "config", "-z", "--get-regexp", r"^remote\.", need=False).split("\0"):
        key, sep, value = entry.partition("\n")
        if key:
            settings.append((key, value if sep else "true"))  # a key written with no value is a boolean true
    remote = git("-C", repo, "config", "--get", f"branch.{short}.remote", need=False) if tracked else ""
    partial = git("-C", repo, "config", "--get", "extensions.partialclone", need=False)
    for r in set(REMOTES) | ({remote} - {"", "."}):
        for key, value in settings:
            if key[len("remote."):key.rindex(".")] == r:
                git("-C", work, "config", "--add", key, value)
        if partial == r:
            git("-C", work, "config", f"remote.{r}.promisor", "true")
    if remote:
        git("-C", work, "config", f"branch.{short}.remote", remote)
        git("-C", work, "config", f"branch.{short}.merge", git("-C", repo, "config", "--get", f"branch.{short}.merge"))
    # git checkout can exit 0 after "error: unable to read sha1 file" lines, leaving files out of the tree.
    p = subprocess.run(["git", "-C", work, "-c", "advice.detachedHead=false", "checkout", "-q", "--detach", sha],
                       capture_output=True, text=True)
    errors = [line for line in p.stderr.splitlines() if line.startswith(("error:", "fatal:"))]
    if p.returncode or errors:
        sys.exit(f"blind-run: checking out {sha} from {repo} failed: {' / '.join(errors[:3]) or p.stderr.strip()}")


def run(name, brief, deadline, allow, repo=None, ref=None, base=None):
    base = base or os.path.join(os.path.expanduser("~"), ".claude", "blind-runs")
    d = os.path.join(base, datetime.date.today().isoformat() + "-" + name)
    dirs = {k: os.path.join(d, k) for k in ("work", "m2", "appdata", "tmp", "log")}
    if os.path.exists(dirs["work"]) and os.listdir(dirs["work"]):
        sys.exit(f"blind-run: {dirs['work']} is not empty; pick another NAME")
    sha = None
    if repo:
        git("-C", repo, "rev-parse", "--git-dir")  # stops with git's own message when --repo is no repository
        sha = git("-C", repo, "rev-parse", "--verify", "--quiet", "--end-of-options", f"{ref or 'HEAD'}^{{commit}}",
                  need=False)
        if not sha:
            sys.exit(f"blind-run: {ref or 'HEAD'} names no commit in {repo}")
    for p in dirs.values():
        os.makedirs(p, exist_ok=True)
    if repo:
        try:
            clone(repo, ref, sha, dirs["work"])
        except BaseException:
            shutil.rmtree(dirs["work"], ignore_errors=True)  # so a rerun under the same NAME is not refused
            raise
    with open(os.path.join(dirs["log"], "BRIEF.md"), "w") as f:
        f.write(brief)
    env = dict(os.environ, TMPDIR=dirs["tmp"] + "/", CLAUDE_CODE_DISABLE_AUTO_MEMORY="1", MAVEN_ARGS=(
        f"-Dmaven.repo.local={dirs['m2']} -Dmaven.repo.local.tail={os.path.expanduser('~')}/.m2/repository "
        f"-DOPENMRS_APPLICATION_DATA_DIRECTORY={dirs['appdata']}/"))
    cmd = ["claude", "-p", brief, "--output-format", "stream-json", "--verbose", "--strict-mcp-config",
           "--allowedTools", *allow, "--disallowedTools", *DENY]
    out, err = os.path.join(dirs["log"], "out.jsonl"), os.path.join(dirs["log"], "err.txt")
    with open(out, "w") as o, open(err, "w") as e:
        # At the deadline, SIGTERM goes to the agent's process group; once the agent exits, or after 5 s, SIGKILL goes
        # to whatever is left of that group. Claude Code runs each Bash command in a process group of its own and stops
        # those shells on SIGTERM; a SIGKILL alone left one running (measured 2026-11-20).
        proc = subprocess.Popen(cmd, cwd=dirs["work"], env=env, stdin=subprocess.DEVNULL, stdout=o, stderr=e,
                                start_new_session=True)
        try:
            rc = proc.wait(timeout=deadline)
        except subprocess.TimeoutExpired:
            rc = 3
            with contextlib.suppress(ProcessLookupError):
                os.killpg(proc.pid, signal.SIGTERM)
            with contextlib.suppress(subprocess.TimeoutExpired):
                proc.wait(timeout=5)
            with contextlib.suppress(ProcessLookupError):
                os.killpg(proc.pid, signal.SIGKILL)
            proc.wait()
    with open(out, errors="replace") as f:
        started = any('"subtype":"init"' in line.replace(" ", "") for line in f)
    text, result = report(out)
    with open(os.path.join(dirs["log"], "report.md"), "w") as f:
        f.write(text + "\n")
    if not started:
        print(f"blind-run: the agent never started; see {err}", file=sys.stderr)
        return 2, d
    if rc == 3:
        print(f"blind-run: deadline of {deadline}s reached; partial report in {dirs['log']}/report.md", file=sys.stderr)
        return 3, d
    if result:
        print(f"blind-run: {result.get('num_turns')} turns, ${round(result.get('total_cost_usd') or 0, 2)}, "
              f"{round((result.get('duration_ms') or 0) / 60000, 1)} min; report in {dirs['log']}/report.md", file=sys.stderr)
    print(text)
    return rc, d


FAKE = r'''#!/usr/bin/env python3
import json, os, sys, time
open(os.environ["FAKE_LOG"], "w").write(json.dumps({"cwd": os.getcwd(), "args": sys.argv[1:],
    "maven": os.environ.get("MAVEN_ARGS", ""), "tmp": os.environ.get("TMPDIR", ""),
    "memory": os.environ.get("CLAUDE_CODE_DISABLE_AUTO_MEMORY", "")}))
mode = os.environ.get("FAKE_MODE", "ok")
if mode == "silent":
    sys.exit(1)
print(json.dumps({"type": "system", "subtype": "init"}))
if mode == "slow":
    import subprocess
    child = subprocess.Popen(["sleep", "300"])
    open(os.environ["FAKE_LOG"] + ".child", "w").write(str(child.pid))
    sys.stdout.flush(); time.sleep(30)
print(json.dumps({"type": "assistant", "message": {"content": [{"type": "text", "text": "Full report: " + "x" * 300}]}}))
print(json.dumps({"type": "assistant", "message": {"content": [{"type": "text", "text": "Amendment."}]}}))
print(json.dumps({"type": "result", "num_turns": 3, "total_cost_usd": 0.5, "duration_ms": 60000}))
'''


def repo_checks(t):
    """--repo on a shallow checkout whose local main is ahead of origin/main, holding a branch, a stash and a second
    remote that the agent must not see. The fixture's git ignores the owner's config; the clone's git does not."""
    fx = dict(os.environ, GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1", GIT_AUTHOR_NAME="t",
              GIT_AUTHOR_EMAIL="t@example.invalid", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@example.invalid")

    def g(*a):
        return subprocess.run(["git", *a], env=fx, check=True, capture_output=True, text=True).stdout.strip()

    def commit(repo, text, msg):
        with open(os.path.join(repo, "f"), "w") as f:
            f.write(text)
        g("-C", repo, "add", "f")
        g("-C", repo, "commit", "-qm", msg)

    full, src, runs = os.path.join(t, "full"), os.path.join(t, "src"), os.path.join(t, "runs")
    g("init", "-q", "-b", "main", full)
    for i in range(3):
        commit(full, str(i), f"c{i}")
    g("clone", "-q", "--depth", "2", "file://" + full, src)
    upstream = g("-C", src, "rev-parse", "origin/main")
    g("-C", src, "tag", "v1", upstream)
    lower = g("-C", src, "rev-parse", upstream + "~1")
    g("-C", src, "tag", "Case-Tag", upstream)
    g("-C", src, "pack-refs", "--all")
    pr = os.path.join(src, ".git", "packed-refs")
    kept = [line for line in open(pr).read().splitlines() if not line.startswith("#")]  # headerless: git sorts it
    with open(pr, "w") as f:
        f.write("".join(line + "\n" for line in kept + [f"{lower} refs/tags/case-tag"]))
    commit(src, "ahead", "local main ahead")
    g("-C", src, "branch", "pr-1")
    g("-C", src, "branch", "-q", "--set-upstream-to=origin/main", "pr-1")
    head = g("-C", src, "rev-parse", "pr-1")
    g("-C", src, "checkout", "-qb", "secret-branch")
    commit(src, "s", "secret commit")
    g("-C", src, "checkout", "-q", "main")
    g("-C", src, "update-ref", "refs/remotes/fork/secret-fork", "secret-branch")
    g("-C", src, "remote", "add", "upstream", "file://" + full)
    below = g("-C", src, "rev-parse", upstream + "~1")
    g("-C", src, "update-ref", "refs/remotes/upstream/main", below)
    g("-C", src, "remote", "add", "fork", "file://" + full)
    g("-C", src, "update-ref", "refs/remotes/fork/pr-2", head)
    g("-C", src, "branch", "pr-2", head)
    g("-C", src, "branch", "-q", "--set-upstream-to=fork/pr-2", "pr-2")
    with open(os.path.join(src, ".git", "config"), "a") as f:
        f.write('[remote "origin"]\n\tprune\n')
    g("-C", src, "config", "remote.origin.note", "two\nlines")
    with open(os.path.join(src, "f"), "w") as f:
        f.write("dirty")
    g("-C", src, "stash", "push", "-qm", "secret stash")
    before = g("-C", src, "for-each-ref"), g("-C", src, "worktree", "list", "--porcelain")
    os.environ["FAKE_MODE"] = "ok"
    rc, d = run("repo", "b", 20, ALLOW, repo=src, ref="pr-1", base=runs)
    w = os.path.join(d, "work")
    call = json.load(open(os.environ["FAKE_LOG"]))

    def wg(*a):
        return subprocess.run(["git", "-C", w, *a], capture_output=True, text=True)

    try:
        run("badref", "b", 20, ALLOW, repo=src, ref="no-such-ref", base=runs)
        refused = False
    except SystemExit:
        refused = True
    common = wg("rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()

    # A partial clone: its copy must fetch the blob it lacks into its own store, not the checkout's.
    g("-C", full, "config", "uploadpack.allowFilter", "true")
    g("-C", full, "config", "uploadpack.allowAnySHA1InWant", "true")
    partial = os.path.join(t, "partial")
    g("clone", "-q", "--filter=blob:none", "file://" + full, partial)

    def missing():
        listing = g("-C", partial, "rev-list", "--objects", "--all", "--missing=print")
        return sum(1 for line in listing.splitlines() if line.startswith("?"))

    lacked = missing()
    try:
        prc, pd = run("partial", "b", 20, ALLOW, repo=partial, ref="main~2", base=runs)
        old_f = subprocess.run(["git", "-C", os.path.join(pd, "work"), "show", "HEAD:f"], capture_output=True,
                               text=True).stdout
    except SystemExit:
        prc, old_f = 1, None

    # A checkout that cannot be made (a blob is gone) must stop the run and leave no work folder behind.
    brk = os.path.join(t, "brk")
    g("init", "-q", "-b", "main", brk)
    commit(brk, "x", "x")
    blob = g("-C", brk, "rev-parse", "HEAD:f")
    os.remove(os.path.join(brk, ".git", "objects", blob[:2], blob[2:]))
    try:
        run("broken", "b", 20, ALLOW, repo=brk, base=runs)
        stopped = False
    except SystemExit:
        stopped = True

    rc2, d2 = run("forkref", "b", 20, ALLOW, repo=src, ref="pr-2", base=runs)

    def wg2(*a):
        return subprocess.run(["git", "-C", os.path.join(d2, "work"), *a], capture_output=True, text=True).stdout

    rc3, d3 = run("forktip", "b", 20, ALLOW, repo=src, ref="fork/pr-2", base=runs)
    rc4, d4 = run("noref", "b", 20, ALLOW, repo=src, base=runs)

    def wg4(*a):
        return subprocess.run(["git", "-C", os.path.join(d4, "work"), *a], capture_output=True, text=True).stdout

    def wg3(*a):
        return subprocess.run(["git", "-C", os.path.join(d3, "work"), *a], capture_output=True, text=True).stdout

    brref = os.path.join(t, "brref")
    g("init", "-q", "-b", "main", brref)
    commit(brref, "y", "y")
    with open(os.path.join(brref, ".git", "packed-refs"), "w") as f:
        f.write("1" * 40 + " refs/tags/gone\n")
    try:
        brc, _ = run("brokenref", "b", 20, ALLOW, repo=brref, base=runs)
    except SystemExit:
        brc = 1
    nothing = os.path.join(t, "nothing")
    os.makedirs(nothing)
    try:
        run("norepo", "b", 20, ALLOW, repo=nothing, base=runs)
        said = ""
    except SystemExit as e:
        said = str(e.code)
    return [
        ("--repo: exit 0", rc == 0),
        ("--repo: work is a repository of its own", common and os.path.realpath(common) == os.path.realpath(w + "/.git")),
        ("--repo: the agent starts in it", os.path.realpath(call["cwd"]) == os.path.realpath(w)),
        ("--repo: HEAD is --ref, detached", wg("rev-parse", "HEAD").stdout.strip() == head
         and wg("symbolic-ref", "-q", "HEAD").returncode != 0),
        ("--repo: --ref's branch is there", wg("rev-parse", "--verify", "-q", "refs/heads/pr-1").stdout.strip() == head),
        ("--repo: origin/main is the checkout's origin/main, not its local main",
         wg("rev-parse", "origin/main").stdout.strip() == upstream),
        ("--repo: the tags are there", wg("rev-parse", "--verify", "-q", "v1^{commit}").stdout.strip() == upstream),
        ("--repo: no other branch, remote or stash of the checkout",
         "secret" not in wg("for-each-ref").stdout + wg("log", "--all", "--format=%s").stdout),
        ("--repo: history reads down to the shallow boundary", wg("log", "--format=%s").returncode == 0
         and wg("log", "--format=%s").stdout.split() == ["local", "main", "ahead", "c2", "c1"]),
        ("--repo: the working tree is clean", wg("status", "--porcelain").returncode == 0
         and wg("status", "--porcelain").stdout == ""),
        ("--repo: origin's url and refspec are the checkout's",
         wg("config", "remote.origin.url").stdout.strip() == "file://" + full
         and wg("config", "--get-all", "remote.origin.fetch").stdout.strip()
         == g("-C", src, "config", "--get-all", "remote.origin.fetch") != ""),
        ("--repo: origin/HEAD is still a symbolic ref",
         wg("symbolic-ref", "refs/remotes/origin/HEAD").stdout.strip() == "refs/remotes/origin/main"),
        ("--repo: the checkout is unchanged", (g("-C", src, "for-each-ref"), g("-C", src, "worktree", "list",
                                                                                "--porcelain")) == before),
        ("--repo: a --ref naming no commit stops before anything is made",
         refused and not os.path.exists(os.path.join(runs, datetime.date.today().isoformat() + "-badref"))),
        ("--repo: upstream/* and its url are there too", wg("rev-parse", "upstream/main").stdout.strip() == below
         and wg("config", "remote.upstream.url").stdout.strip() == "file://" + full),
        ("--repo: --ref's branch keeps its upstream", wg("rev-parse", "pr-1@{u}").stdout.strip() == upstream),
        ("--repo: a partial clone's copy fetches what it lacks into its own store",
         lacked > 0 and prc == 0 and old_f == "0" and missing() == lacked),
        ("--repo: a checkout that cannot be made stops the run and leaves no work folder",
         stopped and not os.path.exists(os.path.join(runs, datetime.date.today().isoformat() + "-broken", "work"))),
        ("--repo: a remote setting written with no value stays true, and one holding a newline keeps it",
         wg("config", "--type=bool", "--get", "remote.origin.prune").stdout.strip() == "true"
         and wg("config", "--get", "remote.origin.note").stdout == "two\nlines\n"),
        ("--repo: --ref's branch keeps an upstream on another remote, whose other refs stay out",
         rc2 == 0 and wg2("rev-parse", "pr-2@{u}").strip() == head and "secret" not in wg2("for-each-ref")),
        ("--repo: a --repo that is no repository says so", "not a git repository" in said),
        ("--repo: two tags differing only in case both come through, each to its own commit",
         wg("rev-parse", "Case-Tag").stdout.strip() == upstream and wg("rev-parse", "case-tag").stdout.strip() == lower),
        ("--repo: a --ref on another remote keeps its name, and that remote's other refs stay out",
         rc3 == 0 and wg3("rev-parse", "fork/pr-2").strip() == head and "secret" not in wg3("for-each-ref")),
        ("--repo: a ref to a missing object does not stop the run", brc == 0),
        ("--repo: with no --ref, the checked-out branch and its upstream come too, as with --ref HEAD",
         rc4 == 0 and wg4("rev-parse", "refs/heads/main").strip() == head
         and wg4("rev-parse", "main@{u}").strip() == upstream),
    ]


def self_test():
    t = tempfile.mkdtemp()
    os.makedirs(os.path.join(t, "bin"))
    fake = os.path.join(t, "bin", "claude")
    with open(fake, "w") as f:
        f.write(FAKE)
    os.chmod(fake, 0o755)
    os.environ["PATH"] = os.path.join(t, "bin") + os.pathsep + os.environ["PATH"]
    os.environ["FAKE_LOG"] = os.path.join(t, "call.json")
    checks = []
    os.environ["FAKE_MODE"] = "ok"
    rc, d = run("ok", "the brief", 20, ALLOW, base=os.path.join(t, "runs"))
    call = json.load(open(os.environ["FAKE_LOG"]))
    checks += [
        ("exit 0", rc == 0),
        ("cwd is the empty work folder", call["cwd"] == os.path.realpath(os.path.join(d, "work")) or call["cwd"] == os.path.join(d, "work")),
        ("maven repo is the run's own", f"-Dmaven.repo.local={d}/m2" in call["maven"]),
        ("openmrs data directory is the run's own", f"-DOPENMRS_APPLICATION_DATA_DIRECTORY={d}/appdata/" in call["maven"]),
        ("tmp is the run's own", call["tmp"] == os.path.join(d, "tmp") + "/"),
        ("Agent is disallowed", "Agent" in call["args"][call["args"].index("--disallowedTools"):]),
        ("Bash is allowed", "Bash" in call["args"][call["args"].index("--allowedTools"):call["args"].index("--disallowedTools")]),
        ("report keeps the full text and appends the short amendment",
         open(os.path.join(d, "log", "report.md")).read().startswith("Full report") and "Amendment." in open(os.path.join(d, "log", "report.md")).read()),
    ]
    os.environ["FAKE_MODE"] = "silent"
    rc, _ = run("silent", "b", 20, ALLOW, base=os.path.join(t, "runs"))
    checks.append(("never started exits 2", rc == 2))
    os.environ["FAKE_MODE"] = "slow"
    rc, _ = run("slow", "b", 2, ALLOW, base=os.path.join(t, "runs"))
    checks.append(("deadline exits 3", rc == 3))
    child = int(open(os.environ["FAKE_LOG"] + ".child").read())
    time.sleep(0.5)
    try:
        os.kill(child, 0)
        alive = True
        os.kill(child, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):  # EPERM: the pid now belongs to another user's process
        alive = False
    checks.append(("the deadline stops what the agent started", not alive))
    checks.append(("messaging other sessions is disallowed", "SendMessage" in call["args"] and "ListAgents" in call["args"]))
    checks.append(("the memory index is switched off", call["memory"] == "1"))
    checks += repo_checks(t)
    shutil.rmtree(t)
    failed = [n for n, ok in checks if not ok]
    for n in failed:
        print("FAIL", n)
    print(f"{len(checks) - len(failed)} of {len(checks)} checks pass")
    return 1 if failed else 0


def main():
    if sys.argv[1:] == ["--self-test"]:
        sys.exit(self_test())
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("name")
    ap.add_argument("brief_file")
    ap.add_argument("--deadline", type=int, default=2700)
    ap.add_argument("--allow", nargs="+", default=ALLOW)
    ap.add_argument("--repo")
    ap.add_argument("--ref")
    a = ap.parse_args()
    if not a.name.replace("-", "").replace("_", "").isalnum():
        sys.exit("blind-run: NAME may hold letters, digits, - and _ only")
    with open(a.brief_file) as f:
        brief = f.read()
    rc, _ = run(a.name, brief, a.deadline, a.allow, a.repo, a.ref)
    sys.exit(rc)


if __name__ == "__main__":
    main()
