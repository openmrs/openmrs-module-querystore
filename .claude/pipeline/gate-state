#!/usr/bin/env python3
"""gate-state — the one writer for the two Stop-gate state files.

WHY THIS EXISTS AND WHY IT IS NOT A CONVENIENCE. `~/.claude/pr-harden-state.json` and
`~/.claude/harden-state.json` are single files holding one entry per working tree. Every skill that
wrote them did its own read-modify-write, retyped from the SKILL.md text. With one run on the machine
that is merely fragile; with several it is lossy, and lossy in the direction that kills a run: two
runs writing at once and the later read wins, so one run's `awaiting` disappears, its Stop gate then
sees a run that has quit with findings outstanding, and an unattended session dies mid-phase with its
work unpublished. Nothing errors when that happens — the file stays valid JSON, just missing an entry
somebody needed. So the read and the write happen here, under an exclusive `flock` held across BOTH
files, and no skill retypes the mechanism.

The lock is held across both files on purpose, not per file: `await` has to land in both or the armed
`pr-harden` gate refuses the very yield a `/harden` cycle needs in order to wait for its own agents
(`resolve-ticket` Step 7). Two locks would make that pair interruptible, which is the same defect one
level down.

The KEY is the PHYSICAL path of the working directory — symlinks resolved — and both hooks resolve it
the same way. That is not pedantry: the hooks used to key on the shell's `$PWD`, which is LOGICAL,
while every writer used the resolved cwd, so on any path with a symlink in it (`/tmp` on macOS, a
symlinked home) the writer and the reader used different keys and the gate found no entry — which is
its fail-OPEN case, so a run with findings outstanding could stop and nothing would say why. One
canonical key, resolved on both sides.

Under the pool driver each ticket runs in its own git worktree, so the key is per-run and the file is
genuinely multi-tenant; in an interactive session it is whatever checkout you are in, as before.

Writes are atomic (temp file, then rename), so the hooks — which read without locking, because a Stop
hook must never block on someone else's lock — always see one whole version or the other.

  gate-state --owner $PPID pr-set --pr 93 --round 2 --phase reviewed --blocking 1 [--override]
  gate-state --owner $PPID --run harden-1758600000 harden-set --cycle 3 --phase1 open --count-edits
  gate-state --owner $PPID --run harden-1758600000 harden-set --cycle 3 --phase1 converged --phase2 done --count-edits
  gate-state --run harden-1758600000 await "review r3" [--only pr|harden|both]
  gate-state --run harden-1758600000 clear-await [--only pr|harden|both]
  gate-state declined --round 1 --id r1-2 --finding "…" --reason "…"   # writes the pr entry; no --only
  gate-state reviewed-sha <sha>                                        # writes the pr entry; no --only
  gate-state verified-sha <sha>                                        # writes the pr entry; no --only
  gate-state show [--json]
  gate-state clear [--only pr|harden|both] [--json]        # --json prints what it REMOVED
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import subprocess
import sys
import time
from pathlib import Path

CLAUDE = Path(os.environ.get("CLAUDE_HOME") or (Path.home() / ".claude"))
FILES = {"pr": CLAUDE / "pr-harden-state.json", "harden": CLAUDE / "harden-state.json"}
LOCK = CLAUDE / "gate-state.lock"

PHASES = ("building", "init", "fixing", "reviewed")
# `/harden`'s run condition, which is Phase 1's own severity-aware verdict rather than an edit
# count. `open` means the last Phase 1 pass found a substantive issue, so it cannot be the last
# pass. `phase2` says whether the ONE Phase 2 pass this traversal owes has run.
#
# There is deliberately no `escalated`. The first draft had one, and a fresh reviewer measured what
# it cost: the value was sticky, `--phase1 converged` did not clear it, and the hook tested it
# before `phase1` -- so a run whose Phase 2 escalated and whose next Phase 1 pass then CONVERGED was
# re-handed the instruction it had just obeyed, on every turn, for the six-hour expiry. An
# escalation is already expressible without it: it resumes Phase 1, which is `--phase1 open`, and
# the gate blocks on that. Two states, not three, because the third was where the defect lived.
HARDEN_PHASE1 = ("open", "converged")
HARDEN_PHASE2 = ("pending", "done")


class Held:
    """The exclusive lock, plus both files read inside it and written inside it."""

    def __init__(self, key: str, write: bool = True):
        self.key = key
        self.write = write
        self.fh = None
        self.data: dict[str, dict] = {}

    def __enter__(self) -> "Held":
        CLAUDE.mkdir(parents=True, exist_ok=True)
        self.fh = open(LOCK, "a+")
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX)
        except OSError:
            self.fh.close()          # never hold a descriptor for a lock we did not get
            raise
        for which, path in FILES.items():
            try:
                loaded = json.loads(path.read_text())
                self.data[which] = loaded if isinstance(loaded, dict) else {}
            except (OSError, ValueError):
                # A missing file is the normal first write. A CORRUPT one is not something to
                # silently rebuild from empty while holding everyone else's entries hostage, but it
                # is also not something to die on inside a run — so it is reported and replaced,
                # which is the same "report, never refuse" remedy the loader rules take.
                if path.exists():
                    print(f"gate-state: {path.name} was unreadable and has been replaced",
                          file=sys.stderr)
                self.data[which] = {}
        return self

    def entry(self, which: str) -> dict:
        return self.data[which].setdefault(self.key, {})

    def __exit__(self, exc_type, *_) -> None:
        # A read-only command still takes the lock — it must not read a half-written file — but it
        # must not rewrite one either, or `show` would reformat two files it was only asked to print.
        #
        # An exception on its way out writes NOTHING. A command that raised part-way through its
        # changes has an entry in whatever half-applied state it reached, and persisting that is
        # worse than persisting nothing: the caller sees a failure and would reasonably assume the
        # file was untouched.
        write = self.write and exc_type is None
        for which, path in (FILES.items() if write else ()):
            tmp = path.with_suffix(path.suffix + f".tmp{os.getpid()}")
            tmp.write_text(json.dumps(self.data[which], indent=2, sort_keys=True) + "\n")
            tmp.replace(path)
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def _require_run(ap: "argparse.ArgumentParser", run: str | None, what: str) -> None:
    """Refuse a write that could reach a verdict without saying which run is making it.

    This is the mechanical half of `adopt`. Without it `adopt` is a no-op on an unstamped write and
    the previous run's entry -- its verdict, its head, its outstanding agents -- is simply inherited,
    which is the sixth, seventh and eighth defects of one family. Refusing costs a caller one flag
    and is loud; the alternative was a sentence in a docstring, and that sentence was already false
    in this file when it was written.
    """
    if run is None:
        ap.error(f"{what} needs --run <id>: it writes the harden entry, and without an id this "
                 f"cannot tell your run's entry from one a previous run left in this directory. "
                 f"--run goes BEFORE the subcommand, beside --owner.")


def _run_id(value: str) -> str:
    """A run id that is actually one. Empty is the dangerous value, not merely a useless one: every
    run shares it, so no write ever replaces another, and the hook's `.run // empty` reads it as no
    run at all -- which puts a verdict-less write back in the legacy branch, where `edits: 0`
    allows. It is also the value a run reaches for after quoting an unset shell variable."""
    if not value.strip():
        raise argparse.ArgumentTypeError(
            "--run needs a non-empty id; an empty one is shared by every run and reads to the gate "
            "as no run at all")
    return value


def adopt(entry: dict, run: str) -> None:
    """Make `entry` belong to `run`, replacing it wholesale if it belonged to another.

    The alternative was a list of field names to drop, and it grew a leak per review pass -- a
    `phase2`, then a whole verdict, then an `awaiting` -- because `carry unless listed` makes every
    field added to this entry a new candidate. Replacing inverts the default. An unstamped write
    adopts nothing, because it cannot tell whose entry this is.
    """
    # No `run is None` guard: every caller is preceded by `_require_run`, so there is no such
    # caller to guard against, and a branch no caller reaches is one the next change removes for
    # free while believing it was load-bearing. The type says it.
    #
    # NOT `not in (None, run)`. Treating an absent id as adoptable-in-place is how the sixth defect
    # came back a seventh time: a predecessor that stamped no `run` -- every 0.34.0-0.36.0 entry,
    # and any write that omitted the flag -- was merged into rather than replaced, and its
    # `awaiting` allowed a stop on the new run's `phase1: open`. An entry this run did not stamp is
    # not this run's, whatever else is true of it.
    #
    # The eighth member arrived because this was made safe by a PREMISE -- "every documented write
    # carries `--run`" -- and a premise about documentation is not a gate. It was false in this
    # file's own usage block, 118 lines above where it was written, and a run typing what the helper
    # documents rode the previous run's entry. So the callers that can reach a verdict now REQUIRE
    # `--run` (see `_require_run`), and this function's `run is None` early return is reachable only
    # from a caller that cannot write one. The premise is now enforced where it is relied on.
    if entry.get("run") != run:
        entry.clear()
    entry["run"] = run


def stamp(entry: dict, owner: int | None = None) -> None:
    entry["ts"] = int(time.time())
    if owner:
        entry["owner"] = owner


def _git(cwd: str, *args: str) -> str:
    """A git command's stdout, stripped; empty on any failure, since a measurement that could not run
    is not a measurement. Callers that need to tell "zero" from "did not run" check for empty."""
    try:
        return subprocess.run(("git",) + args, cwd=cwd, capture_output=True, text=True).stdout.strip()
    except OSError:
        return ""


def count_edits(cwd: str, since: str | None = None) -> tuple[int, str]:
    """What a `/harden` cycle changed: uncommitted lines plus the commits the cycle added.

    THIS FIGURE IS REPORTED, NOT ENFORCED. Since harden 0.34.0 the gate reads `phase1`/`phase2` and
    no edit count ends or extends a run, so every sentence below about what "the gate" does with
    this number describes the gate as it was through 0.33.0. The reasoning is kept because the two
    misreadings it records still corrupt the figure a run REPORTS, which is an obligation the skill
    still carries.

    Both halves, because a cycle that commits its work has still changed something and a gate reading
    only `git status` would let it stop. The commit half is `<since>..HEAD`, where `since` is the head
    the previous cycle of THIS run recorded; `@{u}..HEAD` is the fallback for a cycle that has no such
    head yet, and it is a per-BRANCH total rather than this cycle's work.

    Measuring against the recorded head is here because `@{u}..HEAD` failed in both directions. It had
    no answer at all where there is no upstream: on #255 and #229 this counted `edits=0` for cycles
    carrying 9 and 3 unpushed commits, because `git rev-list @{u}..HEAD` on such a branch fails and
    prints nothing, and the gate allows the stop at 0. And where an upstream DOES exist it never
    returns to zero until the push, which is the opposite failure -- on #357 cycle 8 the gate read
    `edits=16` on a converged cycle that committed nothing, and reached 0 only after the branch was
    pushed. Which of the two a run got was decided by how its branch happened to be cut: #357 and #354
    used `git checkout -b <branch> origin/main`, which sets `@{u}` to `origin/main`, while #355, #356
    and #360 passed no start point and had no upstream. No skill prescribes either form, and both were
    pre-PR, so "pre-PR has no upstream" was never a property of the configuration.

    Per-cycle rather than per-run on purpose. The run's own total (`HEAD --not --remotes`) does not
    return to zero while nothing has been pushed, so it would block the stop at the close of a pre-PR
    cycle that changed nothing, and the hook's own header prefers an early stop to a wedged turn.

    Returns the count and a note for the caller to print. Where the commit half cannot be measured --
    no upstream and no head yet from an earlier cycle, or a recorded head that no longer resolves
    after a rebase or a recreated checkout -- the note says so, rather than the count reading as a
    measured zero.
    """
    dirty = len([l for l in _git(cwd, "status", "--porcelain").splitlines() if l.strip()])
    upstream = bool(_git(cwd, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"))
    resolves = bool(since) and bool(
        _git(cwd, "rev-parse", "--verify", "--quiet", f"{since}^{{commit}}"))
    if resolves:
        ahead = _git(cwd, "rev-list", "--count", f"{since}..HEAD")
        if ahead.isdigit():
            return dirty + int(ahead), ""
        if not upstream:
            return dirty, f"no upstream and {since[:12]}..HEAD did not count: commit half not measured"
    if upstream:
        ahead = _git(cwd, "rev-list", "--count", "@{u}..HEAD")
        return dirty + (int(ahead) if ahead.isdigit() else 0), (
            "no usable head from an earlier cycle: the commit half is everything unpushed on this "
            "branch rather than this cycle's work, so it can read non-zero on a converged cycle")
    if not since:
        return dirty, "no upstream, no head from an earlier cycle: commit half not measured"
    return dirty, f"no upstream and head {since[:12]} no longer resolves: commit half not measured"


class _Parser(argparse.ArgumentParser):
    """An `ArgumentParser` whose error message says where `--only` is accepted.

    Four runs in a row (#293, #256, #263, #330) invoked a write subcommand with `--only pr`, read
    `error: unrecognized arguments: --only pr`, and re-ran without it. Two prose remedies had already
    been shipped and neither reached them: the correct `reviewed-sha` invocation sits fifteen lines
    above the `--only` examples in `pr-harden`'s State section, and the usage block in this file's
    module docstring never reaches `--help`, because the parser is built with
    `description=__doc__.splitlines()[0]` and argparse prints an epilog on `--help` alone -- never on
    the unrecognized-argument path this actually fails on. So the guidance is attached to the error
    itself, which is the one text the caller is certain to read. Accepting and ignoring the flag was
    the other candidate and is fail-open: `reviewed-sha --only harden` would silently write the pr
    entry.
    """

    def error(self, message: str):
        if "--only" in message:
            message += ("\n--only is accepted by await, clear-await and clear. The subcommands that "
                        "write an entry -- pr-set, harden-set, declined, reviewed-sha, "
                        "verified-sha -- each write "
                        "the one entry they are named for, and show reads both. Re-run without it.")
        super().error(message)


def main() -> int:
    ap = _Parser(description=__doc__.splitlines()[0])
    ap.add_argument("--cwd", default=None, help="the tenant key; defaults to the working directory")
    ap.add_argument("--run", default=None, type=_run_id,
                    help="this RUN's id, minted once at the top of the run and passed on every "
                         "write it makes. A write whose --run differs from the harden entry's "
                         "REPLACES that entry, so a new run in a reused checkout starts from what "
                         "it writes rather than from what it found -- not from everything absent "
                         "from a list, which is what let an `awaiting` from a dead run allow a "
                         "stop on `phase1: open`. Required wherever a verdict is reachable, "
                         "because the alternative was a docstring claiming every caller passes it "
                         "and that claim was false in this file's own usage block. Distinct "
                         "from --owner, which answers whether a live foreign session holds this "
                         "checkout and survives a resume; conflating the two is what left the "
                         "same-pid corner.")
    ap.add_argument("--owner", type=int, default=None,
                    help="the pid of the claude session this entry belongs to. Pass $PPID from a "
                         "tool shell — that IS this session's process, and both gates use it to tell "
                         "your entry from one a co-located session left in the same directory. An "
                         "UNSTAMPED entry keeps the behaviour that predates the check, so omitting "
                         "it relaxes nothing; it just gives up the discrimination.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("pr-set", help="write the pr-harden gate entry")
    p.add_argument("--pr", type=int)
    p.add_argument("--ticket")
    p.add_argument("--round", type=int, required=True)
    p.add_argument("--phase", required=True, choices=PHASES)
    p.add_argument("--blocking", type=int, required=True)
    p.add_argument("--override", action="store_true")
    p.add_argument("--reason", help="required by the skill when --override is taken")

    h = sub.add_parser("harden-set", help="write the harden gate entry")
    h.add_argument("--cycle", type=int, required=True)
    h.add_argument("--edits", type=int, help="the edit count; or use --count-edits")
    h.add_argument("--count-edits", action="store_true",
                   help="count them here instead: uncommitted changes plus commits not yet pushed, "
                        "or on a branch with no upstream the commits made since the previous cycle "
                        "closed. One definition of 'what this cycle changed', so the number the run "
                        "reports and the number recorded here cannot be two different numbers. It "
                        "is reported only; --phase1 is what the gate reads.")
    h.add_argument("--phase1", choices=HARDEN_PHASE1,
                   help="Phase 1's verdict at the close of this pass. This is what ends the run: "
                        "`converged` plus a `--phase2 done` is complete. Omitting it leaves "
                        "whatever the entry says -- nothing on a fresh one, which the gate reads "
                        "as a run in flight that owes a verdict and BLOCKS on, but a verdict "
                        "already there if there is "
                        "one, so say it every time.")
    h.add_argument("--phase2", choices=HARDEN_PHASE2,
                   help="whether the ONE Phase 2 pass this traversal owes has run. Any --phase1 "
                        "write that does not say resets it to `pending`, because a Phase 1 pass "
                        "just ran and the Phase 2 that follows it has not.")
    h.add_argument("--override", action="store_true")
    h.add_argument("--reason")

    a = sub.add_parser("await", help="record a background agent this run is waiting on")
    a.add_argument("agent")
    a.add_argument("--only", default="both", choices=("pr", "harden", "both"))

    c = sub.add_parser("clear-await", help="clear the await the moment the result arrives")
    c.add_argument("--only", default="both", choices=("pr", "harden", "both"))

    d = sub.add_parser("declined", help="append a declined finding to this run's ledger")
    d.add_argument("--round", type=int, required=True)
    d.add_argument("--id", required=True)
    d.add_argument("--finding", required=True)
    d.add_argument("--reason", required=True)

    r = sub.add_parser("reviewed-sha", help="record the sha a round reviewed")
    r.add_argument("sha")

    # The verifier's counterpart, and it exists for the same reason: the gate compares the head being
    # handed over against the last entry of each list, because a blocking count and a runtime verdict
    # are both statements about a SHA and neither survives the next commit. FINISH pushes after the
    # last verifier run in every case, so without this the "verified the merging head" rule was prose
    # with nothing able to check it.
    v = sub.add_parser("verified-sha", help="record the sha a verifier run covered")
    v.add_argument("sha")

    sh = sub.add_parser("show", help="print both entries for this working tree")
    sh.add_argument("--json", action="store_true", help="one JSON object keyed pr/harden, for callers")

    x = sub.add_parser("clear", help="remove this working tree's entries")
    x.add_argument("--only", default="both", choices=("pr", "harden", "both"))
    x.add_argument("--json", action="store_true",
                   help="print what was REMOVED, keyed pr/harden. A caller that wants to report a "
                        "leftover must get it from here: reading it first and clearing it second is "
                        "two operations, and the gap between them is the race this lock removes.")

    args = ap.parse_args()
    key = os.path.realpath(args.cwd) if args.cwd else os.path.realpath(os.getcwd())
    which = {"pr": ["pr"], "harden": ["harden"], "both": ["pr", "harden"]}

    with Held(key, write=args.cmd != "show") as held:
        if args.cmd == "pr-set":
            e = held.entry("pr")
            e.update({"round": args.round, "phase": args.phase, "blocking": args.blocking,
                      "override": bool(args.override)})
            if args.pr is not None:
                # A reused checkout inherits the previous PR's ledger, and `setdefault` below cannot
                # clear it. `pr-harden` Step 0 adopts an entry only when its `pr` MATCHES the PR being
                # hardened or is null -- the `resolve-ticket` handoff -- and Step 1 compares the
                # incoming head against `reviewed_shas`' last entry, so a ledger spanning two PRs is
                # read as this PR's. Measured on #337/PR375: three shas reviewed on PR 345 survived
                # into the next run of that ticket in the same worktree. `harden-set` guards the same
                # reuse for `head`; this is that guard here. The handoff (`pr` null) keeps its ledger,
                # and `awaiting` is nobody's ledger, so neither is touched.
                prior = e.get("pr")
                if prior is not None and prior != args.pr:
                    shas, dec = e.get("reviewed_shas") or [], e.get("declined") or []
                    ver = e.get("verified_shas") or []
                    e["reviewed_shas"], e["declined"], e["verified_shas"] = [], [], []
                    # Unconditional on the drop, not on the fields being non-empty: after the reset
                    # the prior number is the only surviving evidence that this entry was another
                    # PR's, which is what Step 0's take-over report rests on.
                    print(f"pr {prior} -> {args.pr}: dropped the previous PR's ledger "
                          f"({len(shas)} reviewed sha(s), {len(ver)} verified sha(s), "
                          f"{len(dec)} declined finding(s))")
                e["pr"] = args.pr
            if args.ticket:
                e["ticket"] = args.ticket
            if args.reason:
                e["override_reason"] = args.reason
            e.setdefault("pr", None)
            e.setdefault("awaiting", [])
            e.setdefault("declined", [])
            e.setdefault("reviewed_shas", [])
            e.setdefault("verified_shas", [])
            stamp(e, args.owner)
            print(f"round {args.round}: phase={args.phase} blocking={args.blocking}"
                  + (" OVERRIDE" if args.override else ""))

        elif args.cmd == "harden-set":
            _require_run(ap, args.run, "harden-set")
            e = held.entry("harden")
            # A DIFFERENT run REPLACES this entry rather than inheriting from it. Nothing clears
            # it between interactive runs, and successive reviewers found a leak per pass here
            # while the rule was `carry unless listed` -- a `phase2: done`, an `escalated`, a whole
            # terminal verdict, an `awaiting` -- each through the field or the caller the last fix
            # did not name. No count is kept: three passes running found the count itself wrong,
            # and `git log` has them. What holds now is the inversion plus `_require_run` -- no
            # write reaches this entry without an id, so `drop unless this run wrote it` is
            # enforced rather than documented.
            #
            # Keyed on `run`, not on `owner`. They answer different questions and conflating them
            # is what left the same-pid corner: `owner` answers "is a live foreign session using
            # this checkout", which the gate needs and which a resumed session changes; `run`
            # answers "is this the same run", which a resumed session does not. An UNSTAMPED write
            # (no `--run`) replaces nothing, because it cannot tell whose entry this is -- the same
            # reason the gate relaxes nothing for an entry with no `owner`.
            #
            adopt(e, args.run)
            note = ""
            if args.count_edits:
                # No identity test here, and that is not an omission: `--run` is required for
                # this subcommand and `adopt` above has emptied the entry unless this run wrote it,
                # so a head still present is this run's by construction. Two versions of such a
                # test have stood here and both were dead -- one compared a value `adopt` had just
                # written, the other kept an `owner` fallback for a caller that can no longer exist
                # -- and each survived being replaced by `True` in both suites. Four successive
                # comment blocks accumulated here describing mechanisms the next commit deleted;
                # this replaces them, because a rationale that outlives its guard is what the next
                # reader trusts.
                #
                # What remains is the cycle bound, and it is about this run's own traversals. It
                # was `>` and had to become `>=`: `--cycle` numbers the traversal and only an
                # escalation moves it, so on an ordinary run it never advanced and the commit half
                # was never measured at all -- two real commits between two writes, reported as
                # `edits=0 [commit half not measured]`. Each write now measures what changed since
                # this run's previous write, and re-recording one pass correctly reports zero.
                prev = (e.get("head") if (isinstance(e.get("cycle"), int)
                                          and args.cycle >= e["cycle"]) else None)
                edits, note = count_edits(key, prev)
            elif args.edits is None:
                ap.error("harden-set needs --edits N or --count-edits")
            else:
                edits = args.edits
            e.update({"cycle": args.cycle, "edits": edits, "override": bool(args.override)})
            if args.phase1:
                # `phase2` describes THIS traversal's Phase 2 pass, so a Phase 1 write that does
                # not name it resets it: Phase 1 has just run and the Phase 2 after it has not.
                # Resetting on `converged` as well as on `open` is not tidiness. `phase1` and
                # `head` survive a write that does not name them, `override` is rewritten by every
                # write, and `phase2` would carry too -- so a traversal that had converged and
                # finished its Phase 2 would hand `done` to the next traversal, whose Phase 2 has
                # not run. It is scoped to a traversal, and the write that opens a traversal is a
                # `--phase1` one. A fresh reviewer built that case; the terminal write the skill
                # documents names `--phase2 done` explicitly, so nothing legitimate needs the carry.
                e["phase1"] = args.phase1
                e["phase2"] = args.phase2 or "pending"
            elif args.phase2:
                # UNCONDITIONAL. A `--phase2` write with no `--phase1` leans on a verdict this run
                # may never have written: in a reused checkout it is the PREVIOUS run's
                # `converged`, and `--phase2 done` alone then ends a run that has run nothing. The
                # first version of this guard tested `"phase1" not in e`, which fires only where
                # `phase2` is never read anyway (the hook takes the LEGACY branch) and misses the
                # case its own comment named -- it refused where it could not matter and allowed
                # where it did. The skill documents no bare `--phase2` write, so requiring the pair
                # costs nothing.
                ap.error("--phase2 needs --phase1: phase2 describes the Phase 2 pass that follows "
                         "a Phase 1 verdict, and a verdict this run did not write is not one it "
                         "may report against")
            head = _git(key, "rev-parse", "HEAD")
            if head:
                e["head"] = head          # what the NEXT cycle measures its commits against
            # `override` is rewritten by every `harden-set`, so a write that does not repeat
            # `--override` retracts one that was taken. The reason has to go with it or the entry
            # carries a justification for a deviation it no longer records.
            if args.reason:
                e["override_reason"] = args.reason
            elif not args.override:
                e.pop("override_reason", None)
            e.setdefault("awaiting", [])
            stamp(e, args.owner)
            # Both of these read the ENTRY, never the arguments. Keyed on `args.phase1` the
            # warning fired on a write that merely omitted the flag, announcing a legacy entry over
            # a `phase1` the entry already carried and the gate was already holding the run to --
            # and the skill leans on this line ("`gate-state` says so on the line it prints"), so a
            # run that believed it would drive `edits` to 0 and be blocked anyway.
            # LEGACY is no run AND no verdict, which is what the hook branches on. Keyed on the
            # verdict alone this told a run with a stamped id that it was held to the zero-edit
            # rule while the gate was blocking it for having stated no verdict -- and the skill
            # tells the run to trust this line.
            # Three states, not two, and the middle one is what crashed this line when the LEGACY
            # test was widened without widening the format beside it: a run-stamped entry that has
            # stated no verdict has no `phase1` to print. The writer is the only writer of this
            # file, so an exception here loses the write entirely -- the lock deliberately persists
            # nothing on the way out -- which is a worse failure than the wrong word it was fixing.
            if "phase1" in e:
                where = f"phase1={e['phase1']} phase2={e.get('phase2', 'pending')} "
            elif "run" in e:
                where = "no verdict recorded yet "
            else:
                where = ""
            print(f"cycle {args.cycle}: " + where
                  + f"edits={edits}" + (" OVERRIDE" if args.override else "")
                  + (f" [{note}]" if note else "")
                  + ("" if ("phase1" in e or "run" in e) else
                     " [no run id and no phase1 on this entry: it is a LEGACY entry, so the gate"
                     " holds this run to the zero-edit rule rather than to Phase 1's verdict]"))

        elif args.cmd == "await":
            if "harden" in which[args.only]:
                _require_run(ap, args.run, "await (it reaches the harden entry)")
            for w in which[args.only]:
                e = held.entry(w)
                if w == "harden":
                    adopt(e, args.run)
                e.setdefault("awaiting", []).append({"agent": args.agent, "since": int(time.time())})
                stamp(e, args.owner)
            print(f"awaiting: {args.agent} ({args.only})")

        elif args.cmd == "clear-await":
            # Same requirement and same adoption as `await`, for the same reason. This was the one
            # caller left that wrote the harden entry without an id: on a virgin file it created an
            # entry the hook reads as LEGACY, it ignored the `--run` its own documented forms pass,
            # and its `stamp` refreshed `ts` on a dead run's entry -- restarting the six-hour expiry
            # that `resolve-ticket` Step 7 names as the only way out of a wedge. Its harm was
            # block-direction, which is why eight passes went by without it; the claim it falsified
            # was this slice's own "there is no longer a caller that can silently write without an
            # id", which is the third closure claim in a row to be the false universal.
            if "harden" in which[args.only]:
                _require_run(ap, args.run, "clear-await (it reaches the harden entry)")
            for w in which[args.only]:
                e = held.entry(w)
                if w == "harden":
                    adopt(e, args.run)
                e["awaiting"] = []
                stamp(e, args.owner)
            print(f"awaiting cleared ({args.only})")

        elif args.cmd == "declined":
            e = held.entry("pr")
            e.setdefault("declined", []).append(
                {"round": args.round, "id": args.id, "finding": args.finding, "reason": args.reason})
            stamp(e, args.owner)
            print(f"declined {args.id} recorded")

        elif args.cmd == "reviewed-sha":
            e = held.entry("pr")
            shas = e.setdefault("reviewed_shas", [])
            if args.sha not in shas:
                shas.append(args.sha)
            stamp(e, args.owner)
            print(f"reviewed {args.sha[:12]} ({len(shas)} round(s))")

        elif args.cmd == "verified-sha":
            e = held.entry("pr")
            shas = e.setdefault("verified_shas", [])
            if args.sha not in shas:
                shas.append(args.sha)
            stamp(e, args.owner)
            print(f"verified {args.sha[:12]} ({len(shas)} run(s))")

        elif args.cmd == "show":
            if args.json:
                print(json.dumps({w: held.data[w].get(key, {}) for w in ("pr", "harden")},
                                 sort_keys=True))
            else:
                for w in ("pr", "harden"):
                    print(f"{w}: " + json.dumps(held.data[w].get(key, {}), indent=2, sort_keys=True))

        elif args.cmd == "clear":
            removed = {}
            for w in which[args.only]:
                gone = held.data[w].pop(key, None)
                if gone is not None:
                    removed[w] = gone
            if args.json:
                print(json.dumps(removed, sort_keys=True))
            else:
                print(f"cleared {args.only} for {key}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
