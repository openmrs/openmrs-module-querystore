def limit_rejection(info: object) -> dict | None:
    """The claude.ai usage limit stopping a session, read off one `rate_limit_event`, or None.

    `claude -p` already streams these: `{"type": "rate_limit_event", "rate_limit_info": {...}}`,
    carrying `status` (allowed / allowed_warning / rejected), the `resetsAt` epoch of the window that
    is limiting, `rateLimitType` and whether paid overage is covering the overflow. The driver read
    none of it, so a limit arrived as `is_error` and nothing else — indistinguishable from a crash.

    The predicate is the CLI's OWN, mirrored rather than invented, and the two exclusions are the
    whole of why it is not just `status == "rejected"`. A rejection with no `resetsAt` names no
    instant to come back at. A rejection while overage is in use is covered by credit that resets on
    nothing this driver can wait for, so sleeping to `resetsAt` would wait out the wrong thing.

    It answers about ONE observation. `status` moves — a session rejected while a grace window or
    overage is provisioned sees `rejected` and then `allowed`, and finishes — so the caller keeps the
    latest rather than latching the first.
    """
    if not isinstance(info, dict) or info.get("status") != "rejected":
        return None
    if info.get("isUsingOverage") is True or info.get("overageInUse") is True:
        return None
    resets = info.get("resetsAt")
    # `True` is an `int` in Python and would arrive here as the epoch 1, which is in the past and so
    # would read as a limit that has already reset — a wrong answer rather than no answer.
    if isinstance(resets, bool) or not isinstance(resets, (int, float)) or resets <= 0:
        return None
    return {"resets_at": int(resets), "type": info.get("rateLimitType")}


def common_claude_args(cfg: dict) -> list[str]:
    """The options that apply to a session however it is started.

    `pool.json` documents its `claude` block as reaching EVERY session, and for a while it did not:
    the headless driver read `model`, `effort`, `max_budget_usd` and `extra_args` while `--work`
    ignored all four, so an operator's configured model silently did not apply to the sessions they
    watched. One definition, read by both launchers.
    """
    c = cfg["claude"]
    argv: list[str] = []
    if c.get("model"):
        argv += ["--model", c["model"]]
    if c.get("effort"):
        argv += ["--effort", c["effort"]]
    if c.get("max_budget_usd"):
        argv += ["--max-budget-usd", str(c["max_budget_usd"])]
    argv += list(c.get("extra_args") or [])
    return argv


class Session:
    """One headless `claude -p` run, streamed to a .jsonl and watched for death."""

    def __init__(self, prompt: str, cwd: Path, cfg: dict, log_stem: Path, timeout: int,
                 quiet: int, say, env: dict | None = None, resume: str | None = None,
                 pausable: bool = True):
        self.prompt, self.cwd, self.cfg = prompt, cwd, cfg
        # The slot's environment, or this process's. Everything a run must not share with a sibling
        # travels here rather than in the prompt: the skills read it, and a pipeline instruction
        # bolted onto the prompt would be governance no retro can see.
        self.env = env or dict(os.environ)
        self.jsonl = log_stem.with_suffix(".jsonl")
        self.err = log_stem.with_suffix(".err")
        self.timeout, self.quiet, self.say = timeout, quiet, say
        # A resumed session keeps the id it was paused under, deliberately: the id IS the transcript,
        # and a fresh one (`--fork-session`) would resume the conversation into a second file the
        # ledger's `session_id` no longer names.
        self.resume = resume
        # A pause suspends a session only where something can RESUME it, which means a ticket: the
        # ledger row is what carries the session id and the worktree back. The retro has no row, so
        # suspending it would end it — losing the work AND leaving the source repo mid-checkout for
        # the next retro to refuse as dirty — while reporting it through `run_retro`'s problem list
        # as "no commit landed", which is true and is not the reason. It is bounded and runs between
        # waves, so an immediate pause simply waits for it and stops at the next wave.
        self.pausable = pausable
        self.session_id = resume or str(uuid.uuid4())
        self.killed_for = None
        # Told apart from `killed_for` everywhere, because they mean opposite things about the work:
        # a kill is the end of an attempt and a pause is the middle of one.
        self.paused_for = None
        self.turns = 0
        self.last_tool = ""
        self.result = {}
        # The usage limit this session last reported, or None — see `limit_rejection`. Not a
        # count and not a history: only the standing state can decide anything.
        self.rate_limit = None

    def limit_in_force(self) -> bool:
        """Whether a claude.ai usage limit is what is stopping this session right now.

        The reset instant is half the question and the guard is the other half. A rejection whose
        window has since reset cannot be what is stopping anything — so a failure hours later, with
        a stale rejection still on the object, must not read as one, or the driver would sleep until
        a moment already behind it, wake immediately, and re-enter a session that fails again for
        the reason nobody looked at.
        """
        return bool(self.rate_limit) and self.rate_limit["resets_at"] > now()

    def suspend_for_limit(self) -> bool:
        """Whether THIS session may be suspended for the limit rather than ended by it.

        A session with nothing to resume it must not be. `run_retro` builds one with
        `pausable=False` because it has no ledger row to carry a session id and a worktree back, so
        suspending it would END it — losing the work, leaving the source repo mid-checkout for the
        next retro to refuse as dirty, and reporting it through the problem list as "no commit
        landed", which is true and is not the reason. A retro is bounded and runs between waves, so
        the right answer there is the old one: end, and say what ended it.
        """
        return self.pausable and self.limit_in_force()

    def argv(self) -> list[str]:
        c = self.cfg["claude"]
        # `--dangerously-skip-permissions` is unconditional HERE and not a setting: a headless run
        # has nobody to ask, so a permission prompt is not a pause, it is a hang until the quiet
        # watchdog kills the run hours later. For an interactive session it IS a setting, because
        # there the prompt reaches somebody who can answer it — see `work_in_session`.
        argv = [c.get("binary") or "claude",
                "-p", self.prompt, "--output-format", "stream-json", "--verbose",
                "--dangerously-skip-permissions"]
        # `--resume` and `--session-id` are alternatives, not a pair: one continues a conversation
        # that exists and the other names a new one.
        argv += ["--resume", self.resume] if self.resume else ["--session-id", self.session_id]
        return argv + common_claude_args(self.cfg)

    def run(self) -> dict:
        started = now()
        with open(self.jsonl, "w") as out, open(self.err, "w") as errf:
            proc = subprocess.Popen(
                self.argv(), cwd=str(self.cwd), stdout=subprocess.PIPE, stderr=errf,
                text=True, bufsize=1, start_new_session=True, env=self.env,
            )
            last_line = [now()]
            live_add(proc)

            def stop(why: str, paused: bool = False) -> None:
                """End the session's process group. The reason is the whole difference.

                One mechanism, because there is only one way to stop a `claude -p` and inventing a
                second for a pause would be two code paths that must agree about process groups. What
                a pause changes is what the DRIVER does next: it keeps the worktree, keeps the
                session id, spends no attempt, and comes back with `--resume`.
                """
                if paused:
                    self.paused_for = why
                else:
                    self.killed_for = why
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
                    time.sleep(20)
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
                except OSError:
                    pass

            def watchdog() -> None:
                while proc.poll() is None:
                    time.sleep(5)
                    # Asked before the two death checks so a session already past its quiet window
                    # when the operator pauses is still recorded as PAUSED rather than as dead. The
                    # tick is what bounds how long `--pause --now` takes to bite; it is short because
                    # everything in this loop is a stat and a subtraction.
                    ask = pause_requested() if self.pausable else None
                    if ask and ask.get("now"):
                        return stop("the operator asked for an immediate pause", paused=True)
                    if now() - started > self.timeout:
                        return stop(f"exceeded the ticket timeout of {hms(self.timeout)}")
                    if now() - last_line[0] > self.quiet:
                        # A session that cannot make a request produces nothing, so the quiet
                        # watchdog is the SECOND way a usage limit reaches the driver — and as a
                        # kill it costs everything a kill costs: the attempt, the worktree, and
                        # `timeout` in the ledger over a run that had not failed. Both routes end
                        # in the same place; this is the one no exit code marks.
                        if self.suspend_for_limit():
                            return stop(LIMIT_WHY, paused=True)
                        return stop(f"produced nothing for {hms(self.quiet)}")

            threading.Thread(target=watchdog, daemon=True).start()
            last_report = now()
            for line in proc.stdout:
                out.write(line)
                out.flush()
                last_line[0] = now()
                self._absorb(line)
                if now() - last_report >= 300:
                    last_report = now()
                    self.say(f"    … {hms(now() - started)} · {self.turns} turns"
                             + (f" · last: {self.last_tool}" if self.last_tool else ""))
            code = proc.wait()
            live_drop(proc)

        # The other route, and the ordinary one. The CLI's own wait-for-the-reset is gated on an
        # INTERACTIVE session (`isInteractive() && !isBackground()`), so it can never arm under
        # `-p`: a headless run ends the moment the window closes, with nothing but a non-zero exit
        # to say so. Read after the wait, so the last record the session streamed is the one that
        # decides, and only over a run that actually FAILED — a rejection a session got past must
        # not re-label the clean end that followed it.
        if not self.killed_for and not self.paused_for and self.suspend_for_limit() and (
                code != 0 or self.result.get("is_error")):
            self.paused_for = LIMIT_WHY

        return {"exit": code, "seconds": now() - started, "session_id": self.session_id,
                "killed_for": self.killed_for, "paused_for": self.paused_for,
                "turns": self.turns, "jsonl": str(self.jsonl),
                # The limit standing over the session as it ENDED — a rejection it got past, or
                # one whose window has since reset, is not one. Whether that is worth recording as a
                # time to come back at is `work_ticket`'s to decide: an operator pause taken while a
                # limit happened to be in force is still an operator pause, and ends when they say.
                "rate_limit": self.rate_limit if self.limit_in_force() else None,
                "cost_usd": self.result.get("total_cost_usd"),
                "is_error": bool(self.result.get("is_error")) or code != 0,
                # What ENDED the session, straight off the final result record. An outcome status is
                # read off what was LEFT BEHIND — a PR exists and is draft — which cannot tell a loop
                # that ran out of rounds from one whose session was killed before its closing steps.
                # A refusal (`stop_reason: "refusal"`, an API safeguard firing mid-run) is the case
                # that prompted this; see the draft verdict below for what it is used for.
                "stop_reason": (self.result.get("stop_reason") or None),
                "summary": (self.result.get("result") or "")[-1200:]}

    def _absorb(self, line: str) -> None:
        try:
            event = json.loads(line)
        except ValueError:
            return
        kind = event.get("type")
        if kind == "assistant":
            self.turns += 1
            for block in event.get("message", {}).get("content", []) or []:
                if block.get("type") == "tool_use":
                    name = block.get("name", "")
                    arg = block.get("input", {}) or {}
                    detail = arg.get("command") or arg.get("prompt") or arg.get("skill") or ""
                    self.last_tool = f"{name}({str(detail)[:60]})" if detail else name
        elif kind == "rate_limit_event":
            # Replaced rather than accumulated, and cleared by an `allowed` that follows a
            # `rejected`: only the standing state means anything. See `limit_rejection`.
            self.rate_limit = limit_rejection(event.get("rate_limit_info"))
        elif kind == "result":
            self.result = event


