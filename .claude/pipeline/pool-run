# ─────────────────────────────────────────────────────────────── plumbing ──


def now() -> int:
    return int(time.time())


def utc_date() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%d")


def utc_stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def at_clock(epoch: int) -> str:
    """An epoch as a local wall clock. `hms` says how long; deciding whether to wait needs when.

    Total over any number, because the numbers reaching it come off the wire. A `resetsAt` the
    platform cannot represent raises out of `datetime.fromtimestamp` — and the first caller is the
    line `work_ticket` prints as it SUSPENDS a session, so a formatting error there would take the
    pause with it: the attempt spent, the ticket recorded as a crash, and the session orphaned in a
    worktree nothing names. Printing the raw number is the smaller failure by a wide margin.
    """
    try:
        when = datetime.fromtimestamp(epoch)
    except (OverflowError, OSError, ValueError):
        return f"epoch {epoch}"
    return when.strftime("%H:%M" if when.date() == datetime.now().date() else "%Y-%m-%d %H:%M")


def hms(seconds: float) -> str:
    seconds = int(seconds)
    h, m = seconds // 3600, (seconds % 3600) // 60
    return f"{h}h{m:02d}m" if h else f"{m}m{seconds % 60:02d}s"


class Say:
    """stdout for the operator, and a markdown transcript of the same for the log.

    Serialised, because with several tickets in flight this has concurrent callers: the whole
    append-and-rewrite is one critical section, or two workers read the same `self.lines`, each
    appends its own line, and the second rewrite drops the first — losing operator output in exactly
    the run where there is most of it to read.

    `for_ticket` is how a worker writes: every line it produces is tagged with the ticket that
    produced it. Untagged interleaved output from N runs is not a log, it is noise.
    """

    def __init__(self, path: Path):
        self.path = path
        self.lines: list[str] = []
        self.lock = threading.Lock()
        path.parent.mkdir(parents=True, exist_ok=True)

    def __call__(self, line: str = "") -> None:
        with self.lock:
            print(line, flush=True)
            self.lines.append(line)
            try:
                self.path.write_text("\n".join(self.lines) + "\n")
            except OSError:
                pass

    def quietly(self, line: str = "") -> None:
        """Into the log, and NOT onto the terminal.

        For a watcher writing while an interactive session owns the screen: a line printed there
        lands in the middle of somebody's TUI. The log is where it belongs and where `--status`
        readers look for it anyway.
        """
        with self.lock:
            self.lines.append(line)
            try:
                self.path.write_text("\n".join(self.lines) + "\n")
            except OSError:
                pass

    def for_ticket(self, tag: str):
        """A `Say` for one worker: same sink, every line labelled with whose it is."""
        def tagged(line: str = "") -> None:
            self(f"{tag} {line}" if line else tag)
        return tagged


def sh(args: list[str], cwd: Path | None = None, timeout: int = 300) -> subprocess.CompletedProcess:
    return subprocess.run(
        args, cwd=str(cwd) if cwd else None, capture_output=True, text=True, timeout=timeout
    )


def iso_to_epoch(stamp) -> int | None:
    try:
        return int(datetime.fromisoformat(str(stamp).replace("Z", "+00:00")).timestamp())
    except (TypeError, ValueError):
        return None


def load_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def save_json(path: Path, data) -> None:
    """Write atomically, through a temp path NO other writer can be using.

    The rename is atomic, so a reader always sees one whole version — but a FIXED `.tmp` suffix is
    shared by every concurrent writer, and `write_text` truncates before it writes. Two writers then
    interleave inside one temp file and the rename publishes whichever truncation won. Scoped to the
    pid and thread, the temp path is private and the rename is the only thing that races, which is
    what atomic means.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(f"{path.suffix}.tmp{os.getpid()}.{threading.get_ident()}")
    try:
        tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
        tmp.replace(path)
    finally:
        tmp.unlink(missing_ok=True)


def merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in (over or {}).items():
        out[k] = merge(base[k], v) if isinstance(v, dict) and isinstance(base.get(k), dict) else v
    return out


# ─────────────────────────────────────────────────────────────── notifying ──

# Said once per invocation. A channel that cannot be reached is worth ONE line and not one per event:
# the events it is failing to deliver are exactly the ones nobody is reading the terminal for, so a
# complaint per event would scroll past unread beside them.
NOTIFY_FAILED: dict = {"why": None}
# Held over the read-and-set of it. Every caller today is single-threaded — `landed` runs in the
# wave's collecting thread and never in a worker — so this is what keeps that from being a
# PRECONDITION of the helper rather than an observation about its current callers: `notify` is
# reachable from anywhere, and "once" is the whole claim.
NOTIFY_LOCK = threading.Lock()

# The outcomes that are the pipeline getting on with it, and everything else needs a human. ONE
# definition, because the summary's own line and what wakes somebody at 3am must not be able to
# disagree about which those are. `paused` is deliberately here: it needs `--resume`, not judgement.
SETTLED = ("ready", "paused")


def needs_a_human(status: str) -> bool:
    return status not in SETTLED


def notify_argv(cfg: dict) -> list[str] | None:
    """The command one event is handed to, or None when nothing here can deliver one.

    `notify.command` is the whole channel policy and the driver has no opinion about it: an argv the
    operator chooses, the one-line summary appended as its LAST argument, the whole event as JSON on
    its stdin. `["ntfy", "publish", "<topic>"]`, a Slack wrapper, or a script that decides for itself
    which events are worth a phone buzzing all work unchanged — and a secret can live in that
    script of theirs rather than in this pipeline's config.

    Unset, it falls back to a macOS banner. That fallback exists so the feature is not inert out of
    the box, NOT because a banner answers an eight-hour unattended run: it reaches a laptop the
    operator has walked away from, and nothing else. Configure the channel.
    """
    notify_cfg = cfg.get("notify") or {}
    if not notify_cfg.get("enabled", True):
        return None
    command = notify_cfg.get("command")
    if command is not None:
        # Emptied is not unset. An operator who blanked this chose silence, and answering that with
        # a banner is the driver overruling the only instruction the key can carry.
        if isinstance(command, str):
            command = shlex.split(command)
        return [str(part) for part in command] or None
    if sys.platform != "darwin":
        return None
    # `on run argv` rather than an interpolated `-e`. No summary carries a ticket TITLE — they are
    # repo slugs, statuses and counts — but `driver-died` carries `str(exc)`, which embeds failing
    # argv and absolute paths, and a retro's carries the reason it stopped. An AppleScript string
    # built by concatenation is a syntax error waiting for the first quote or apostrophe in any of
    # those, and this way there is nothing to escape.
    return ["osascript", "-e", "on run argv",
            "-e", 'display notification (item 1 of argv) with title "pool-run" sound name "Ping"',
            "-e", "end run"]


def notify_timeout(cfg: dict) -> int:
    """Absent means 15. A number the operator wrote is theirs — `or 15` silently overruled a 0."""
    given = (cfg.get("notify") or {}).get("timeout_seconds")
    return 15 if given is None else int(given)


def notify(cfg: dict, event: str, summary: str, say, needs_human: bool = False, **fields) -> None:
    """Push one event to the operator's channel. Never raises, never retries, never waits long.

    This is the least important thing the driver does and it behaves like it: a channel that is
    missing, misconfigured or slow costs one line of output and nothing else. The pool is the work; a
    notification is a convenience laid over it, and the day it can stop a wave is the day it has cost
    more than every escalation it ever delivered.
    """
    # Resolving the channel is INSIDE the guard, not before it. `notify.command: true` — somebody
    # answering the question the key asks — is not iterable, and `notify_argv` raised it straight
    # through a promise this docstring makes: out of a single-job wave it took the pool, and out of a
    # parallel one it was caught by the worker handler and a finished ticket was rewritten as a crash.
    argv, why = None, None
    try:
        argv = notify_argv(cfg)
        if not argv:
            return
        payload = {"event": event, "summary": summary, "needs_human": needs_human,
                   "at": datetime.now(timezone.utc).isoformat(), **fields}
        done = subprocess.run(argv + [summary], input=json.dumps(payload), text=True,
                              capture_output=True,
                              timeout=notify_timeout(cfg))
        if done.returncode != 0:
            why = f"exit {done.returncode}: {(done.stderr or done.stdout).strip()[:160]}"
    except Exception as exc:                      # including the timeout, which is not exceptional
        why = f"{type(exc).__name__}: {exc}"[:200]
    if not why:
        return
    with NOTIFY_LOCK:
        first, NOTIFY_FAILED["why"] = not NOTIFY_FAILED["why"], NOTIFY_FAILED["why"] or why
    if first:
        say(f"! the notifier ({argv[0] if argv else 'notify.command'}) failed — {why}. Nothing else "
            "is affected, but this run's escalations are not reaching you.")


def notify_outcome(cfg: dict, ledger: dict, key: str, status: str, say) -> None:
    """One ticket landed.

    Pushed as it lands rather than with its wave: five workers against an eight-hour bound means the
    wave ends when its SLOWEST ticket does, and a run that aborted in the first ten minutes would sit
    unreported for the rest of the day — which is the whole failure this is here to end.
    """
    entry = (ledger or {}).get(key) or {}
    pr = entry.get("pr")
    # `flags` and `killed_for` travel with it because `needs_human` is a statement about the STATUS
    # and cannot be one about the run: the driver's own "PR is ready but the gate entry says
    # blocking=N — one of the two is wrong" rides on a `ready`, and a channel filtering on
    # `needs_human` alone would drop the one outcome the driver has called self-contradictory.
    notify(cfg, "outcome", f"{key}: {status}" + (f" (PR #{pr})" if pr else ""), say,
           needs_human=needs_a_human(status), key=key, status=status, pr=pr,
           pr_url=entry.get("pr_url"), duration_s=entry.get("duration_s"),
           cost_usd=entry.get("cost_usd"), flags=entry.get("flags") or [],
           killed_for=entry.get("killed_for"))


# ─────────────────────────────────────────────────────────────────── pause ──


def ask_pause(immediate: bool) -> None:
    """Record that the operator wants the run to stop. Called from ANOTHER terminal, never the driver.

    A file rather than a signal, for two reasons. A signal can only be sent by something that knows
    the driver's pid and is allowed to signal it, while a pause has to be askable from any terminal —
    and, more importantly, SIGINT and SIGTERM already mean something here (stop after the wave, then
    kill), and overloading either would make the existing behaviour un-typable.
    """
    save_json(PAUSE, {"asked": now(), "now": bool(immediate), "by": os.getpid()})


def pause_requested() -> dict | None:
    """The outstanding pause request, or None. Read by the wave loop and by every live watchdog."""
    if not PAUSE.exists():
        return None
    ask = load_json(PAUSE, {})
    return ask if isinstance(ask, dict) and ask.get("asked") else None


def clear_pause_request() -> None:
    """Consume the request. The driver does this the moment it ACTS on it, never before.

    A request that outlived the pause it caused would stop the resumed run in its first wave, which
    reads as "resume does not work" rather than as a stale file. A driver also clears one at startup:
    the lock it has just taken proves no other driver is alive, so anything still on disk was asked
    of a driver that is gone.
    """
    try:
        PAUSE.unlink()
    except OSError:
        pass


def portable_job(job: dict) -> dict:
    """A job as JSON can carry it: a job holds a `Path`, and both the pause plan and the automatic
    resume hand one to `resume_jobs`, which puts it back."""
    return {k: (str(v) if isinstance(v, Path) else v) for k, v in job.items()}


def write_pause_plan(cfg_path: str, workers: int, no_retro: bool, remaining: list[dict],
                     suspended: list[dict], say: Say, forced: bool = False) -> Path:
    """What a paused run leaves for `--resume`: the queue it had left, in the order it had it.

    The ORDER is the reason this file exists at all. Everything else could be re-derived — the label
    query would find the unworked tickets again — but an operator who typed `--ticket 310,297,266`
    chose that sequence, and `build_queue` would hand back the label path's ascending default. Which
    tickets ran first decides what evidence the retro reads, so re-sorting a resumed queue is a
    decision about the work, and the driver does not get to make those.

    A job carries a `Path`, which JSON does not, so paths go out as strings and `resume_jobs` puts
    them back. The ledger is deliberately NOT copied in here: what a suspended ticket needs to be
    re-entered — its session id and its worktree — is written there by `work_ticket`, and a second
    copy is one that can disagree with it.

    `forced` records whether the paused queue came from `--ticket`, which is not bookkeeping: the
    resume re-screens the un-started tail through `consider`, and that predicate answers differently
    for a queue the operator named. Recording it is what makes the resumed run behave as the paused
    one would have, rather than as whichever kind the resume happens to look like.
    """
    save_json(PAUSED, {"at": now(), "config": cfg_path, "workers": workers,
                       "no_retro": bool(no_retro), "forced": bool(forced),
                       "suspended": [portable_job(j) for j in suspended],
                       "queue": [portable_job(j) for j in remaining]})
    say(f"    wrote the resume plan to {PAUSED}")
    return PAUSED


def read_pause_plan() -> dict:
    plan = load_json(PAUSED, {})
    return plan if isinstance(plan, dict) else {}


def clear_pause_plan() -> None:
    try:
        PAUSED.unlink()
    except OSError:
        pass


def paused_from_ledger(cfg: dict, ledger: dict, already: set[str], say: Say) -> list[dict]:
    """Tickets the LEDGER calls paused that the plan does not name.

    The two records are written at different moments and only one of them is written the instant the
    session stops. `work_ticket` marks the ticket paused as its session ends; the plan is written
    afterwards, by the wave loop, once the whole wave is back. A driver that dies in that gap — or at
    any point after it — leaves a paused ticket with no plan naming it, and that ticket is then
    stuck: a plain run skips it because it is paused, and a resume that trusted the plan alone cannot
    see it. So the plan is treated as what it is, an extra (the un-started queue, and its order), and
    the ledger as the durable half.
    """
    jobs = []
    for key, entry in sorted(ledger.items()):
        if entry.get("status") not in SUSPENDED or key in already:
            continue
        slug, _, ticket = key.partition("#")
        path = cfg.get("repos", {}).get(slug)
        if not path:
            # Paused under a repo this config does not carry. Left alone rather than guessed at:
            # another pool.json owns it, and working it here would cut its worktree from a checkout
            # nobody asked about.
            say(f"  - {key}: paused, but {slug} is not in this config — left for the pool that owns it.")
            continue
        say(f"  - {key}: paused in the ledger but not named by the plan — resuming it anyway.")
        jobs.append({"slug": slug, "path": str(Path(path).expanduser()), "ticket": ticket,
                     "url": entry.get("url") or (f"https://github.com/{slug}/issues/{ticket}"
                                                 if ticket.isdigit() else ticket),
                     "title": "", "key": key})
    return jobs


def resume_jobs(plan: dict, ledger: dict, cfg: dict, say: Say) -> list[dict]:
    """The queue a `--resume` works: suspended tickets first, then what never started.

    Suspended first because a suspended session is the perishable thing here — it is holding a
    worktree and a slot, and every wave worked ahead of it is another chance for something to release
    one underneath it.

    A suspended ticket is re-entered ONLY while the ledger still calls it paused. That is not
    belt-and-braces: `--resume` can be run twice, or run after the operator worked the ticket by hand
    with `--work`, and re-entering a session that has since finished would start over in a worktree
    holding somebody else's completed work. Where the ledger has moved on it is dropped from the
    queue and said, rather than restarted, because "it is no longer paused" is not the same as "it
    needs working" and only the ledger knows which.
    """
    jobs: list[dict] = []
    named = plan.get("suspended") or []
    for job in named + paused_from_ledger(cfg, ledger, {j.get("key") for j in named}, say):
        entry = ledger.get(job.get("key"), {})
        if entry.get("status") not in SUSPENDED:
            say(f"  - {job.get('key')}: no longer paused (the ledger says "
                f"{entry.get('status')!r}) — not re-entered.")
            continue
        rebuilt = {**job, "path": Path(job["path"]).expanduser()}
        if entry.get("session_id") and entry.get("worktree"):
            rebuilt["resume"] = {"session_id": entry["session_id"], "worktree": entry["worktree"]}
        else:
            # Paused, but with nothing to re-enter. It is still queued — the ticket is unworked and
            # that has not changed — but from the start, and said, because a resume that quietly
            # began a ticket again would be indistinguishable from one that continued it.
            say(f"  - {job.get('key')}: paused, but no session and worktree were recorded for it "
                "— it will be worked from the start.")
        jobs.append(rebuilt)
    for job in plan.get("queue") or []:
        jobs.append({**job, "path": Path(job["path"]).expanduser()})
    return jobs


def wait_for_limit_reset(suspended: list[dict], ledger: dict, cfg: dict, say: Say,
                         interrupted) -> list[dict] | None:
    """Sleep until the usage limit that suspended these tickets resets, then hand back the jobs that
    re-enter them. `None` means do not wait — hand the pause back to the operator, as before.

    This is the half whose absence made a closed window cost a person's evening. Everything else was
    already here: `work_ticket` suspends the session, `resume_jobs` rebuilds it, `--resume` re-enters
    it. But the driver's answer to a limit was to write a plan and exit, so the pool sat idle from
    the moment the window closed until somebody came back to the terminal — and a reset is a KNOWN
    instant, reported by the CLI itself. There is nothing in it for a human to decide.

    `interrupted` is polled throughout rather than waited on: it is the only way Ctrl-C and
    `--pause` reach a sleep that can be hours long.

    Three things stop it waiting, and each is a way the wait would be WRONG rather than merely long:

      * a suspended ticket with no `resume_at` — an operator's pause, or one whose reset was never
        reported. Nothing here knows when that ends, and a wave holding one of each is exactly where
        guessing would resume a session somebody suspended on purpose.
      * a reset past `ticket.limit_wait_max_seconds`. A five-hour window is at most five hours out
        and waiting costs an idle box; a seven-day one can be days out, and a driver holding
        worktrees, slots and the machine lock across that is not unattended operation, it is a hang.
      * a ticket suspended this way before that produced NO turns since. The reset it already waited
        for bought nothing, so the next one will not either: that is a session spinning against a
        limit it cannot get out from under, and it needs a person, not a longer sleep.
    """
    def refuse(summary: str, **fields) -> None:
        """Say it AND push it. `paused` is a status that deliberately pages nobody, which is right
        for a pause the driver will end itself and wrong for one only a person can end. The same
        limit used to end these runs as `error`, which DID page — so a refused wait must not buy its
        quiet at the cost of the one signal that mattered."""
        say(f"  not waiting: {summary}")
        notify(cfg, "limit-held", f"pool held by a usage limit: {summary}", say,
               needs_human=True, tickets=[j.get("key") for j in suspended], **fields)

    rows = [(job, ledger.get(job.get("key")) or {}) for job in suspended]
    resets = [row.get("resume_at") for _, row in rows]
    if not rows or any(not isinstance(r, int) for r in resets):
        # Said, not pushed. The only way to get here is a pause with no reset on it, which means an
        # operator's own — and they are at a terminal, having just typed for it. Said rather than
        # silent all the same: a hand-back with no reason reads as the wait being broken.
        say("  not waiting: " + ("nothing is suspended" if not rows else
            "a suspended ticket was not paused by a usage limit, so nothing here knows when it ends"))
        return None
    for job, row in rows:
        if row.get("limit_pauses", 0) > 1 and not row.get("turns"):
            refuse(f"{job.get('key')} has been suspended by the usage limit "
                   f"{row['limit_pauses']} times and did nothing with the last reset — it wants a "
                   "person, not another sleep.", key=job.get("key"))
            return None

    resets_at = max(resets)
    jitter = max(0, int(cfg["ticket"].get("limit_wait_jitter_seconds") or 0))
    # Never exactly ON the reset: this machine's clock may be ahead of the server's, and several
    # tickets — or several machines — waking on the same second would be rejected together.
    target = resets_at + (random.randint(jitter // 2, jitter) if jitter else 0)
    cap = int(cfg["ticket"].get("limit_wait_max_seconds") or 0)
    ahead = target - now()
    if cap <= 0 or ahead > cap:
        refuse(f"the limit resets at {at_clock(resets_at)}, {hms(max(0, ahead))} from "
               + ("now, and waiting for a reset is off (ticket.limit_wait_max_seconds is 0)."
                  if cap <= 0 else
                  f"now, past ticket.limit_wait_max_seconds ({hms(cap)}). A window that far out is "
                  "a weekly limit, and a weekly limit wants a person."),
               resets_at=resets_at)
        return None

    say(f"  waiting {hms(max(0, ahead))} for the usage limit to reset at {at_clock(resets_at)} — "
        f"{len(rows)} ticket(s) stay suspended with their transcripts intact.")
    told = now()
    while now() < target:
        # A poll and not a sleep. This is the longest thing the driver ever does with nothing
        # running, and BOTH ways an operator stops a pool work by being noticed: the signal handler
        # sets a flag the loop reads, `--pause` writes a file the watchdogs poll. Neither of them
        # survives a `time.sleep` to the reset.
        if interrupted():
            # Not pushed, for the same reason the no-reset case is not: an interruption is Ctrl-C or
            # `--pause`, both of which somebody has just typed.
            say("  the wait was interrupted — the tickets stay suspended for `pool-run --resume`.")
            return None
        time.sleep(5)
        if now() - told >= 600:
            told = now()
            say(f"    … {hms(max(0, target - now()))} until the limit resets")

    # Through the real rebuilder, so a ticket the ledger has since moved on from is screened out
    # exactly as `--resume` screens it. Over a ledger narrowed to THIS wave, because `resume_jobs`
    # also sweeps in every other row the ledger calls paused — right for an operator who typed
    # `--resume` and wrong here, where it would re-enter a session somebody suspended on purpose.
    mine = {j.get("key") for j in suspended}
    jobs = resume_jobs({"queue": [], "suspended": [portable_job(j) for j in suspended]},
                       {k: v for k, v in ledger.items() if k in mine}, cfg, say)
    say(f"  the usage limit has reset — re-entering {len(jobs)} suspended session(s).")
    return jobs or None


# ───────────────────────────────────────────────────────────────── locking ──


def take_lock(say: Say) -> bool:
    if LOCK.exists():
        holder = load_json(LOCK, {})
        pid = holder.get("pid")
        alive = False
        if isinstance(pid, int) and pid > 0:   # kill(0)/kill(-n) signal a GROUP and always succeed
            try:
                os.kill(pid, 0)
                alive = True
            except OSError:
                alive = False
        if alive:
            say(f"another pool-run holds the lock (pid {pid}, since {holder.get('started')}).")
            say("The lock is one per MACHINE, not one per checkout, and deliberately: two drivers "
                "would each retro over the other's records and race the one ledger. Several tickets "
                "at once is what --workers is for, inside one driver that can hold the wave barrier. "
                "Stopping.")
            return False
        say(f"clearing a stale lock from pid {pid} (no such process).")
    save_json(LOCK, {"pid": os.getpid(), "started": datetime.now(timezone.utc).isoformat()})
    return True


def drop_lock() -> None:
    """Release the lock only if it is OURS.

    An unconditional unlink here was a live hazard the moment a read-only mode stopped taking the lock:
    skipping `take_lock` does not skip the `finally`, so a `--dry-run` alongside a working pool DELETED
    that pool's lock and left the checkout open to a second driver — the exact collision the lock
    exists to prevent. Measured by doing it, to a real run, 18 minutes into its first ticket.
    """
    holder = load_json(LOCK, {})
    if holder.get("pid") != os.getpid():
        return
    try:
        LOCK.unlink()
    except OSError:
        pass


# ─────────────────────────────────────────────────────────────────── slots ──


PORT_KEYS = ("tomcatport", "dbport")


def standalone_ports(home: Path) -> dict[str, int | None]:
    """The two ports a standalone binds, read from its own runtime properties.

    Both matter and reading only the tomcat port is not enough: a standalone runs an embedded MariaDB
    as well, and two instances agreeing on 3316 fail to start for a reason that looks nothing like a
    port clash from the outside. Measured on this machine — five of the eight standalones on disk
    share 8081/3316, so "there are several standalones" is not the same as "several can run at once".
    """
    props = home / "openmrs-runtime.properties"
    ports: dict[str, int | None] = {"tomcatport": None, "dbport": None}
    try:
        text = props.read_text()
    except OSError:
        return ports
    for line in text.splitlines():
        if line.startswith("tomcatport="):
            with contextlib.suppress(ValueError):
                ports["tomcatport"] = int(line.split("=", 1)[1].strip())
        # Any host, not just 127.0.0.1: a standalone written with `localhost` published no database
        # port at all under the narrower pattern, so two of them agreeing on 3316 passed the
        # port-clash check and failed at startup instead.
        m = re.search(r"//[^/:@]+:(\d+)/", line)
        if m and line.startswith("connection.url="):
            ports["dbport"] = int(m.group(1))
    return ports


def shared_maven_repo(cfg: dict) -> Path:
    """The repository the per-slot heads read THROUGH, which is not always `~/.m2/repository`.

    A `<localRepository>` in `~/.m2/settings.xml` moves it, and a tail pointing at a directory maven
    is not using is a tail with nothing in it — every offline build then fails on its first
    dependency. Config wins, then settings.xml, then the default.
    """
    override = (cfg.get("parallel") or {}).get("shared_m2")
    if override:
        return Path(override).expanduser()
    settings = HOME / ".m2/settings.xml"
    try:
        m = re.search(r"<localRepository>\s*([^<]+?)\s*</localRepository>", settings.read_text())
    except OSError:
        m = None
    if m:
        return Path(os.path.expandvars(m.group(1).replace("${user.home}", str(HOME)))).expanduser()
    return SHARED_M2


class Slot:
    """The exclusive resources one concurrent run gets, and how they reach its session.

    Three things are shared by default and each is a way for two runs to corrupt each other:

      * the OpenMRS standalone — one per slot, handed over as `$OPENMRS_STANDALONE_HOME`, which is
        already the first thing the verifier resolves. Without this two verifiers restart one server
        under each other and both grade the wrong deploy.
      * the local maven repository — SPLIT, not replaced: installs go to this slot's own head and
        every read falls through to the shared `~/.m2/repository` behind it, so builds stay offline
        and fast while `chartsearchai-api-1.0.0-SNAPSHOT.jar` stops being one file two runs
        overwrite. That jar is exactly the one `omod` unpacks over `omod/target/classes`, so sharing
        it means run A's classes silently under run B's tests.
      * the working tree — a git worktree per ticket, which is `work_ticket`'s job rather than this
        one's, since it is per ticket and the slot is per worker.

    `CLAUDE_PIPELINE_SLOT` is the session's own notice that it has co-tenants: the skills read it and
    stop doing the things that are correct alone and destructive beside a sibling — killing whatever
    holds a port, taking whichever standalone is idle, restarting the shared inference server.
    """

    def __init__(self, name: str, standalone: Path | None, m2: Path, tail: Path | None = None):
        self.name = name
        self.standalone = standalone
        self.m2 = m2
        self.tail = tail or SHARED_M2
        ports = standalone_ports(standalone) if standalone else {}
        self.tomcatport = ports.get("tomcatport")
        self.dbport = ports.get("dbport")

    def env(self) -> dict[str, str]:
        self.m2.mkdir(parents=True, exist_ok=True)
        env = dict(os.environ)
        env["MAVEN_ARGS"] = (f"-Dmaven.repo.local={self.m2} "
                             f"-Dmaven.repo.local.tail={self.tail}")
        env["CLAUDE_PIPELINE_SLOT"] = self.name
        if self.standalone:
            env["OPENMRS_STANDALONE_HOME"] = str(self.standalone)
        return env

    def describe(self) -> str:
        if not self.standalone:
            return f"{self.name}: no standalone assigned (single-worker run)"
        # parent/name, not name: the instances are commonly several copies of one release, so the
        # basename alone prints two identical-looking slots and the log stops saying which is which.
        where = f"{self.standalone.parent.name}/{self.standalone.name}"
        return (f"{self.name}: {where} "
                f"(tomcat {self.tomcatport}, db {self.dbport}) · m2 {self.m2.name}")


def build_slots(cfg: dict, workers: int, root: Path | None = None) -> list[Slot]:
    """One slot per worker. Standalones are taken in configured order, so a slot keeps its instance
    across waves — which keeps its database warm and makes a run's log say which server it used."""
    root = root or SLOT_M2
    tail = shared_maven_repo(cfg)
    homes = [Path(x).expanduser() for x in cfg["parallel"].get("standalones") or []]
    slots = []
    for i in range(workers):
        name = f"slot-{i + 1}"
        slots.append(Slot(name, homes[i] if i < len(homes) else None, root / name, tail))
    return slots


def version_tuple(text: str) -> tuple[int, ...] | None:
    """`2.9.0-SNAPSHOT` -> (2, 9, 0). Qualifiers are dropped, which is what the comparison needs.

    OpenMRS reads `require_version` as a FLOOR, so a module wanting 2.9.0-SNAPSHOT runs on 2.9.0 and
    on anything later. Comparing the numbers alone gets that right; comparing the strings does not.
    """
    m = re.match(r"(\d+)(?:\.(\d+))?(?:\.(\d+))?", text.strip())
    if not m:
        return None
    return tuple(int(g) if g else 0 for g in m.groups())


def standalone_platform(home: Path) -> str | None:
    """The openmrs-core version a standalone is running, read off the webapp it will actually load."""
    lib = home / "tomcat/webapps/openmrs/WEB-INF/lib"
    for jar in sorted(lib.glob("openmrs-api-*.jar")) if lib.is_dir() else []:
        return jar.name[len("openmrs-api-"):-len(".jar")]
    return None


def required_platform(repo: Path) -> str | None:
    """The platform a module targets, from its own pom. `config.xml` states the requirement as
    `${openmrsPlatformVersion}`, so the pom is where the number actually lives."""
    try:
        m = re.search(r"<openmrsPlatformVersion>([^<]+)</openmrsPlatformVersion>",
                      (repo / "pom.xml").read_text())
    except OSError:
        return None
    return m.group(1).strip() if m else None


def platform_problems(cfg: dict, workers: int) -> list[str]:
    """A standalone whose core is older than the module requires cannot run the module at all.

    Not a nicety: `require_version` is a FLOOR, so the module simply refuses to start there — and the
    verifier then reports a failure that is about the instance rather than the code, every round,
    until the cap. This is exactly the class of thing the pre-flight exists to catch before hours are
    spent, and it is checked here because nothing else in the pipeline reads either version.

    Found the hard way: a slot was configured by matching the REFERENCE APPLICATION version in the
    directory name (`…-3.7.1`), which is not the criterion — that instance carried core 2.8.8 while
    the module required 2.9.0-SNAPSHOT, and a `…-3.7.0` directory carried the right core.
    """
    homes = [Path(x).expanduser() for x in cfg["parallel"].get("standalones") or []][:workers]
    if not homes:
        return []
    problems = []
    for slug, path in cfg["repos"].items():
        want = required_platform(Path(path).expanduser())
        wanted = version_tuple(want) if want else None
        if not wanted:
            continue
        for home in homes:
            got = standalone_platform(home)
            if not got:
                problems.append(f"{home.name}: cannot read its openmrs-core version, so it cannot be "
                                f"checked against {slug}'s required platform {want}")
                continue
            if (version_tuple(got) or ()) < wanted:
                problems.append(
                    f"{home} runs openmrs-core {got}, but {slug} requires {want} — the module will "
                    f"not start there, so every verification on that slot fails for a reason that is "
                    f"about the instance and not the code. Point that slot at an instance running "
                    f"{want} or newer")
    return problems


def slot_problems(cfg: dict, workers: int) -> list[str]:
    """Fatal misconfigurations, reported at preflight rather than discovered by two verifiers.

    A single worker needs no standalone CONFIGURED: that is the behaviour that predates slots, it has
    no co-tenant to collide with, and the verifier's own `$OPENMRS_STANDALONE_HOME`-else-search still
    applies. But one that IS configured is still checked, at any width — handing a session an
    `$OPENMRS_STANDALONE_HOME` that does not exist fails later and further away than here.

    Ports are checked per port and not as a pair. Two instances agreeing on tomcat 8081 cannot run at
    once whatever their database ports are, and a pair key quietly passes exactly that case.
    """
    homes = [Path(x).expanduser() for x in cfg["parallel"].get("standalones") or []]
    problems = []
    if workers > 1 and len(homes) < workers:
        problems.append(
            f"{workers} workers but {len(homes)} standalone(s) configured — set "
            f"parallel.standalones to {workers} instances, or lower parallel.max_workers. Two runs "
            "sharing one standalone restart it underneath each other")
    used = homes[:workers]
    seen: dict[tuple[str, int], str] = {}
    for home in used:
        if not (home / "openmrs-standalone.jar").is_file():
            problems.append(f"{home} holds no openmrs-standalone.jar")
            continue
        ports = standalone_ports(home)
        if not ports["tomcatport"]:
            problems.append(f"{home} has no tomcatport in openmrs-runtime.properties")
        if workers <= 1:
            continue
        for which in PORT_KEYS:
            port = ports[which]
            if port is None:
                continue
            if (which, port) in seen:
                problems.append(
                    f"{home.name} and {Path(seen[(which, port)]).name} both bind {which} {port} — "
                    "they cannot run at the same time. Give one of them a different port in its "
                    "openmrs-runtime.properties")
            seen[(which, port)] = str(home)
    return problems


# ────────────────────────────────────────────────────────────────── claims ──


def pid_is_alive(pid) -> bool:
    """Whether a recorded pid still names a process.

    `ProcessLookupError` is the only answer that means dead. A `PermissionError` means the process is
    THERE and belongs to somebody else, and reading it as death is how a liveness check licenses
    overwriting a live session's row.
    """
    if not isinstance(pid, int) or pid <= 0:                # 0 and negatives address a group
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        return True
    return True


def lease_is_live(lease: dict) -> bool:
    """Whether the session a lease names is still there — the predicate, with no pruning.

    Separate from `active_leases` because two callers want the question and only one of them may
    answer it destructively: `--status` reports on leases and writes nothing at all, and a reader
    that deleted what it looked at would be the second thing in this file to do that by accident.

    A `--work` lease also records the session it belongs to, and a session that is gone cannot give
    its slot back: SIGINT, SIGHUP and SIGTERM are absorbed so the release still runs, but SIGKILL
    cannot be, and one `kill -9` would otherwise cost that slot until somebody noticed. A `--claim`
    lease records no session — the operator starts `claude` afterwards, so there is no pid to record
    — and its liveness stays the worktree. Absence of a pid is not death.
    """
    # A lease file is JSON somebody or something else wrote, so its fields are not to be trusted to
    # be the type they usually are: `Path(5)` raises, and raising here took out `claim_slot` and
    # every hand-launched start with it, over one corrupt file. A lease that cannot be read is not a
    # live one.
    worktree = lease.get("worktree")
    if not isinstance(worktree, str) or not Path(worktree).is_dir():
        return False
    pid = lease.get("session_pid")
    return pid_is_alive(pid) if pid is not None else True


def leased_tickets() -> set[str]:
    """The `slug#ticket` keys a live hand-launched session is holding, pruning nothing."""
    return {f"{lease['slug']}#{str(lease['ticket']).lstrip('#')}"
            for lease in all_leases().values()
            if lease.get("slug") and lease.get("ticket") and lease_is_live(lease)}


def work_row_death(entry: dict) -> str | None:
    """Why a `--work` row saying `running` can be PROVEN over, or None where it cannot be.

    The proof is a recorded pid that no longer exists, and nothing weaker. "No lease holds it" was
    very nearly shipped as if it were proof, and it is not: `release_claim` unlinks a lease with no
    liveness check at all, and `active_leases` prunes one whose worktree was removed — so an operator
    typing `--release` in a second terminal, or a pruned worktree, would have the next hand-launched
    session publish `error` over a run that is still working. `write_ledger` then keeps the flag
    saying so as a field it never saw, so the lie outlives the session that disproves it.

    A row with no pid — every row written before this existed — is therefore left alone. It cannot be
    shown dead, `--status` says as much, and `reap_running` under the machine lock still can.

    Driver rows are deliberately out of scope: they record no session here, and the driver's own reap
    holds the lock that makes the weaker argument sound.
    """
    if entry.get("status") != "running" or entry.get("launched_by") != "work":
        return None
    pid = entry.get("session_pid")
    if not isinstance(pid, int) or pid <= 0 or pid_is_alive(pid):
        return None
    return f"the session that held it (pid {pid}) is gone"


def stale_work_rows(ledger: dict) -> dict[str, str]:
    """Every `--work` row that `work_row_death` can prove is over, and why."""
    return {k: why for k, e in sorted(ledger.items()) if (why := work_row_death(e))}


def active_leases() -> dict[str, dict]:
    """Slot leases held by hand-launched sessions, minus the ones whose session is gone.

    A lease cannot be pid-owned: the operator claims first and starts `claude` afterwards, so there is
    no process to point at when the lease is written. What stands in for liveness is the WORKTREE — a
    lease whose worktree no longer exists belonged to a session that ended without releasing, and
    holding its standalone forever would be worse than reclaiming it.
    """
    live = {}
    for path in sorted(SLOTS.glob("*.json")) if SLOTS.is_dir() else []:
        lease = load_json(path, {})
        if lease_is_live(lease):
            live[path.stem] = lease
        else:
            path.unlink(missing_ok=True)
    return live


def all_leases() -> dict[str, dict]:
    """Every lease file, with no liveness filtering at all.

    `release_claim` reads THIS, not `active_leases`. The liveness filter exists so that another
    process can discover an abandoned slot — but applied to an owner releasing its own lease it is
    actively wrong: by then the session it names has exited, the filter calls the lease abandoned and
    deletes it, and the release finds nothing to do, so the worktree is never cleaned up. Measured by
    doing it: `no claim is held for o/r#266`, worktree left behind, on the normal exit path.
    """
    out = {}
    for path in sorted(SLOTS.glob("*.json")) if SLOTS.is_dir() else []:
        lease = load_json(path, {})
        if lease:
            out[path.stem] = lease
    return out


def record_session(slot: str, pid: int) -> None:
    """Attach the session's pid to its lease, once the session exists.

    Written after the spawn rather than at claim time, because the claim is what creates the worktree
    the session will run in — there is no process to point at until it has been started.
    """
    path = SLOTS / f"{slot}.json"
    lease = load_json(path, {})
    if lease:
        lease["session_pid"] = pid
        save_json(path, lease)


def claim_slot(cfg: dict, slug: str, ticket: str, repo: Path, base: str,
               say) -> dict | None:
    """Hand a hand-launched session the three things the driver gives a worker.

    A `claude` started by hand has no `OPENMRS_STANDALONE_HOME`, no `MAVEN_ARGS` and no
    `CLAUDE_PIPELINE_SLOT` — so two of them share one standalone, install the module's own jar over
    each other in `~/.m2`, and never engage the co-tenancy scoping in the skills, which is keyed on
    that last variable. They also share a checkout, and two sessions in one directory share ONE gate
    entry: the later writer wins and the first ticket's is silently gone.

    A claim is a worktree plus a leased slot. The lease is taken with an exclusive create, so two
    claims racing cannot pick one standalone — which is the part that is easy to get wrong by hand and
    the reason this exists at all rather than a page of instructions.
    """
    workers = max(1, int(cfg["parallel"]["max_workers"]))
    slots = build_slots(cfg, workers)
    held = active_leases()
    SLOTS.mkdir(parents=True, exist_ok=True)

    # ONE CLAIM PER TICKET, and this is a safety check rather than tidiness. The worktree path is
    # derived from the ticket, so a second claim for the same one resolves to the SAME directory —
    # and `make_worktree` releases whatever it finds there before recreating it. A running session
    # that has just committed has a CLEAN tree, so the release succeeds and the second claim wipes
    # the first session's checkout out from under it. Measured: the live session's committed file was
    # deleted and two leases were left pointing at one directory, which then made `release_claim`
    # ambiguous. Nothing errored on either count.
    # Matched on the REPOSITORY as well as the number. Issue numbers collide across repos freely, so
    # a ticket-only match refuses `o/b#266` because `o/a#266` is running — a legitimate claim turned
    # away, and the worktree paths were never in conflict since those carry the slug too.
    want = ticket.lstrip("#")
    for name, lease in sorted(held.items()):
        if lease.get("ticket") == want and lease.get("slug") == slug:
            say(f"  x {slug}#{want} is already claimed on {name} ({lease.get('worktree')}). One "
                f"claim per ticket: a second one resolves to that same worktree and would remove it. "
                f"If that session is finished, `pool-run --release {want}`.")
            return None

    # A lease reserves a STANDALONE, and the slot name is only how it is addressed. Editing
    # `parallel.standalones` while a session runs re-points that name at a different instance — and
    # then a free slot NAME can carry an instance somebody is already using. So the instance itself is
    # checked, not just the name it currently answers to.
    leased_instances = {l.get("standalone") for l in held.values() if l.get("standalone")}
    for slot in slots:
        if slot.name in held:
            continue
        if slot.standalone and str(slot.standalone) in leased_instances:
            say(f"  ! {slot.name} now points at {slot.standalone.name}, which another claim already "
                "holds — parallel.standalones changed under a running session. Skipping it.")
            continue
        lease_path = SLOTS / f"{slot.name}.json"
        try:
            fd = os.open(lease_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
        except FileExistsError:
            continue          # somebody claimed it between the listing and now
        wt, why = make_worktree(repo, slug, ticket, base, say)
        if wt is None:
            os.close(fd)
            lease_path.unlink(missing_ok=True)
            say(f"  x {why}")
            return None
        with os.fdopen(fd, "w") as fh:
            json.dump({"slot": slot.name, "ticket": ticket.lstrip("#"), "slug": slug,
                       "worktree": str(wt), "repo": str(repo),
                       "standalone": str(slot.standalone) if slot.standalone else None,
                       "since": now()}, fh, indent=2)
        return {"slot": slot, "worktree": wt, "env": slot.env(),
                "url": f"https://github.com/{slug}/issues/{ticket.lstrip('#')}"}

    say(f"  x every slot is claimed ({', '.join(sorted(held))}). Release one, or configure more "
        "standalones and raise parallel.max_workers.")
    return None


def release_claim(cfg: dict, ticket: str, say) -> dict | None:
    """Give a slot back. The worktree goes with it unless it still holds uncommitted work.

    The lease is freed either way, and deliberately: what the lease reserves is the STANDALONE, and
    that is idle the moment the session ends. A worktree kept for its unsaved changes only blocks
    re-claiming THAT ticket, which is the refusal it should be.
    """
    # `--release 266` or `--release owner/repo#266`. The qualified form exists because the bare
    # number is ambiguous the moment two repositories are configured, and picking one at random there
    # would delete a worktree belonging to a session that is still running.
    slug, _, number = ticket.rpartition("#")
    # Through `ticket_id` so `--release` accepts every form `--claim` does. A URL carries no `#`, so
    # `rpartition` hands the whole thing back as the number — and the lease it is looking for was
    # written under the IDENTIFIER, so comparing the raw URL finds nothing and the slot stays held.
    want = ticket_id(number or ticket)
    # A URL names its own repository, so it narrows the search exactly as it does for `--claim`.
    # Without this, `--release <url>` on a ticket number claimed in two repos hits the "name which
    # one" ambiguity instead of releasing the one the URL actually named.
    slug = slug or (ticket_repo(ticket) or "")
    # Both sides through `ticket_id`, not just the input. A lease written BEFORE this normalisation
    # existed stored the raw token, so comparing it against a normalised `want` never matches and
    # that slot stays held forever — no input the operator can type reaches it, because normalising
    # what they type cannot retroactively normalise what was stored.
    matches = {n: l for n, l in all_leases().items()
               if ticket_id(l.get("ticket") or "") == want
               and (not slug or l.get("slug") == slug)}
    if len(matches) > 1:
        say(f"  x #{want} is claimed in {len(matches)} repositories — name which one:")
        for n, l in sorted(matches.items()):
            say(f"      pool-run --release {l.get('slug')}#{want}   ({n})")
        return None
    for name, lease in matches.items():
        wt = Path(lease["worktree"])
        released = drop_worktree(Path(lease["repo"]), wt, say)
        # The gate entry goes with the worktree, exactly as it does on the driver's path. A claim of
        # the same ticket reuses the same PATH, so a leftover `phase: building` would be inherited by
        # the next session in it and block its Stop gate for the full six-hour expiry — a wedge with
        # nothing wrong with the run. Only when the directory is actually gone: a worktree kept for
        # its unsaved changes may still be somebody's, and its entry is theirs.
        if released.startswith("removed"):
            clear_gate_state(wt, say)
        (SLOTS / f"{name}.json").unlink(missing_ok=True)
        say(f"  released {name} ({released})")
        return {"slot": name, "worktree": released}
    say(f"  no claim is held for {ticket}")
    return None


def project_dir_name(worktree: Path) -> str:
    """`claude`'s directory name for a session whose cwd is `worktree`.

    OBSERVED and not a contract: every project directory on a machine running this matches
    `[A-Za-z0-9-]+`, i.e. every other character of the path is flattened to `-`. An earlier version
    mapped only `/` and `.`, which is right for most paths and silently wrong for any worktree leaf
    carrying an underscore — `safe_component` allows them — and a name that is wrong finds no
    directory and reports nothing, which looks exactly like a session that is fine.
    """
    return re.sub(r"[^A-Za-z0-9-]", "-", str(worktree))


def silence_since(worktree: Path, started_at: int) -> int | None:
    """How long THIS run has written nothing, or None when that cannot be said.

    The signal is the session's own transcripts under `~/.claude/projects/<project_dir_name>/`. It is
    the only one a hand-launched session gives a watcher at all: it inherits the terminal, so unlike
    a driven one there is no stream to read.

    Two things this gets right that the obvious version does not.

    The FLOOR. That directory is keyed on the worktree path, which is deterministic per ticket, so it
    outlives the worktree — #266's still held transcripts from 2026-08-27 with no worktree at all. A
    version without the floor calls the next run of that ticket "quiet for twelve days" on its first
    tick and, because the report latches, spends the only quiet report that run will ever make.

    The SUBTREE. A session's subagent transcripts sit under `<session-id>/`, and only the parent sits
    at the top level — 16 of #266's 17 files were below it. Measured over this pipeline's own
    transcripts, the largest gap in a PARENT jsonl of a `--work` run is hours (701 minutes on ticket
    356, 534 on 360), far past the 90-minute default: a top-level-only glob spends the quiet report
    on a session that is busy in its subagents.

    Fail-open, deliberately: nothing written yet is absence of evidence, not evidence of a stall, and
    the bound still catches a session that wedges before its first write.
    """
    project = PROJECTS / project_dir_name(worktree)
    if not project.is_dir():
        return None
    newest = None
    for path in project.rglob("*.jsonl"):
        try:
            at = int(path.stat().st_mtime)
        except OSError:
            continue
        if at >= started_at and (newest is None or at > newest):
            newest = at
    return None if newest is None else now() - newest


def process_start(pid: int) -> str | None:
    """When a pid's process started, in the same spelling `claude` records for itself."""
    got = sh(["ps", "-o", "lstart=", "-p", str(pid)])
    return got.stdout.strip() or None


def live_session(pid: int) -> dict | None:
    """`claude`'s OWN registry entry for a live session, or None if this pid is not one.

    A session publishes `~/.claude/sessions/<pid>.json` for itself, and it carries the two things an
    outside process needs in order to talk to it — the socket it is listening on and its session id
    — plus the one that makes talking to it SAFE. `procStart` is checked against the live process
    because pids are recycled, and the cost of getting that wrong is a resume prompt delivered into
    somebody else's unrelated session. Registry entries also outlive the sessions that wrote them.
    """
    entry = load_json(SESSIONS / f"{pid}.json", {})
    if not isinstance(entry, dict) or entry.get("pid") != pid:
        return None
    if not entry.get("messagingSocketPath") or not entry.get("sessionId"):
        return None
    started = entry.get("procStart")
    if started and process_start(pid) not in (None, started):
        return None
    return entry


def peer_send(entry: dict, payload: dict, timeout: float = 5.0) -> str | None:
    """Hand one message to a live session over the socket IT published. Returns an error, or None.

    Never raises. This is a convenience laid over a run in exactly the sense `notify` is: a session
    that cannot be reached costs a line in the log and nothing else, because the alternative — a
    launcher that dies trying to be helpful — is worse than the stall it was fixing.

    The transport is `claude`'s own local peer-message socket, which is how one session messages
    another on this machine, and it is not a published contract: the envelope carries a protocol
    version and can change. That is survivable ONLY because of where this is called from — a failed
    send leaves the session exactly as it was, stalled, which is what it did before any of this
    existed. Never build anything on this that a failure would corrupt.
    """
    path = entry.get("messagingSocketPath")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(timeout)
            sock.connect(path)
            sock.sendall((json.dumps(payload) + "\n").encode())
            sock.shutdown(socket.SHUT_WR)
    except (OSError, ValueError) as exc:
        return f"{type(exc).__name__}: {exc}"
    return None


def continue_session(pid: int, text: str) -> str | None:
    """Put one user turn into a live session's queue, the way another session would.

    `session_id` rides along deliberately: the receiver drops a message whose session id is not its
    own, which is the second guard after `procStart` against a recycled pid being handed a resume
    prompt meant for something else. Two guards because they fail differently — one is a stale
    registry file, the other a pid reissued between reading it and writing to it.
    """
    entry = live_session(pid)
    if not entry:
        return f"no live session is registered under pid {pid}"
    return peer_send(entry, {"type": "user", "from": "pool-run", "priority": "next",
                             "session_id": entry["sessionId"],
                             "message": {"content": text}})


def session_is_busy(pid: int) -> bool:
    """Whether the session says it is working. Absent or unreadable reads as NOT busy, deliberately:
    this only ever gates whether to spend a probe, and the decision to act needs the probe's answer
    as well as this one."""
    entry = live_session(pid)
    return bool(entry) and entry.get("status") == "busy"


def account_limit(cfg: dict, cwd: Path) -> dict | None:
    """Ask the ACCOUNT whether a usage limit is in force, and when it lifts. None means it is not.

    An interactive transcript records nothing machine-readable about a limit — the only trace is an
    assistant line in the operator's own locale ("resets 7:10am"), and reading a wall clock out of
    a localised sentence is a bug waiting for somebody in another timezone. A rate limit is an
    ACCOUNT fact, so this asks the account: the smallest possible headless session, read through the
    same `Session` and the same `limit_rejection` the driver uses. One reader of rate limits here,
    not two.

    It is free in the case that matters. A probe made while the window is shut is REJECTED, so it
    spends nothing; only a probe that finds the window OPEN costs a few tokens, and that is the
    answer that stops anything waiting. `pausable=False` because there is nothing to resume: this
    session is one question.
    """
    stem = LOGS / safe_component(f"{utc_stamp()}-limit-probe")
    run = Session("Reply with one word: ok", cwd, cfg, stem, 300, 300,
                  lambda *a, **k: None, pausable=False).run()
    return run.get("rate_limit")


def watch_hand_launched(cfg: dict, key: str, worktree: Path, started_at: int,
                        stop: threading.Event, say, pid: int | None = None) -> None:
    """Tell somebody when a hand-launched run passes its bound or goes quiet, and carry it past a
    usage limit. It NEVER kills.

    `Session` carries the driver's timeout and quiet window; `work_in_session` starts an ordinary
    interactive `claude` with `Popen`, so for as long as this path has existed neither bound applied
    to it. Measured off this pipeline's ledger on 2026-09-08: 32 of 34 rows were `launched_by: work`,
    and the five longest runs were all `--work` — 47.7h down to 19.7h, every one ending `error` —
    against a `ticket.timeout_seconds` of 8h.

    Killing is the wrong remedy here and the difference is not squeamishness: the driven path may
    kill on a clock because it is headless and its bound is the only thing that can end it, while
    this session has somebody who can answer it and may simply be slow. So the bound is reported and
    not enforced. Each reason is reported once — a bound that has passed stays passed, and saying so
    every tick is how a channel gets muted.
    """
    bound = int(cfg["ticket"]["timeout_seconds"])
    quiet = int(cfg["ticket"]["quiet_seconds"])
    tick = max(1, min(30, bound, quiet))
    told: set[str] = set()
    # The usage limit this session is blocked by, once observed, and the earliest the account may be
    # asked again. The CLI's own wait-for-the-reset is a feature of the SESSION and can be gated off
    # for an account; the driver's is for sessions it can suspend and re-enter, which a `--work`
    # session is not — it has no ledger row carrying it back. So what is left is to notice the
    # window reopening and say so. Unlike every other branch in this watcher that is an ACTION, and
    # it is guarded three times over: the session must be quiet, the account must have REFUSED a
    # probe rather than merely be suspected, and the reset must have arrived. A wrong nudge is a
    # turn injected into a session that was working.
    carry = bool(cfg["ticket"].get("limit_continue_work", True))
    cap = int(cfg["ticket"].get("limit_wait_max_seconds") or 0)
    jitter = max(0, int(cfg["ticket"].get("limit_wait_jitter_seconds") or 0))
    limit, fire_at, tries, next_probe = None, 0, 0, 0

    def report(reason: str, summary: str, **fields) -> None:
        # Said in the LOG as well as pushed. `notify` reaches `say` only when the channel fails, and
        # on the success path never — so an operator with no channel wired, or with notifications
        # off, had a watchdog that observed everything and recorded nothing anywhere.
        told.add(reason)
        say(f"! run-overdue ({reason}): {summary}")
        notify(cfg, "run-overdue", summary, say, needs_human=True, reason=reason, key=key,
               worktree=str(worktree), **fields)

    while not stop.wait(tick):
        if "past-its-bound" not in told and now() - started_at > bound:
            report("past-its-bound",
                   f"{key} has been running {hms(now() - started_at)}, past its {hms(bound)} "
                   "bound — it is NOT killed", running_for_s=now() - started_at)
        if "quiet" not in told:
            silent = silence_since(worktree, started_at)
            if silent is not None and silent > quiet:
                report("quiet", f"{key} has written nothing for {hms(silent)} — it may be waiting "
                                "for you, or wedged", quiet_for_s=silent)

        if not carry or pid is None or cap <= 0:
            continue
        if limit is not None:
            # `fire_at` was drawn ONCE, when the limit was observed. Drawing the margin here instead
            # would re-roll it every tick, so the moment being waited for would move each time it
            # was asked about — either firing early or never settling.
            if now() < fire_at:
                continue
            failed = continue_session(pid, WORK_CONTINUE_PROMPT)
            if not failed:
                say(f"the usage limit reset at {at_clock(limit['resets_at'])} — told {key}'s "
                    "session to continue where it stopped")
                # Cleared so a run that meets the limit twice is carried twice. The bounds above
                # latch deliberately; this must not, because each window is its own event.
                told.discard("limit-continue-failed")
                limit, tries, next_probe = None, 0, now() + max(tick, 600)
                continue
            # Retried across ticks rather than abandoned on the first refusal. Giving up here would
            # be permanent in practice: the next probe happens with the window OPEN, finds no limit,
            # and so never schedules another attempt — one dropped packet and the session sits
            # there. Bounded, because a send that fails three times is failing for a reason a
            # fourth will not fix, and that reason belongs in front of a person.
            tries += 1
            if tries < 3:
                continue
            if "limit-continue-failed" not in told:
                # Latched like the bounds above, and discarded on the next success: once per run of
                # failures, not once per window and not once per tick.
                report("limit-continue-failed",
                       f"{key}: the usage limit reset at {at_clock(limit['resets_at'])} but this "
                       f"session could not be told to continue after {tries} tries ({failed}) — "
                       "send it any message to pick it up", resets_at=limit["resets_at"])
            limit, tries, next_probe = None, 0, now() + max(tick, 600)
            continue
        # Asking the account costs a session, so it is asked only of a run that looks stopped: quiet
        # AND not busy by its own account. A long build is silent and says it is busy, which is what
        # keeps this from spending a probe a tick through a compile.
        silent = silence_since(worktree, started_at)
        if silent is None or silent < 300 or now() < next_probe or session_is_busy(pid):
            continue
        next_probe = now() + max(tick, 600)
        try:
            found = account_limit(cfg, worktree)
        except Exception as exc:   # a watcher must never take the session it watches with it
            say(f"! could not ask the account about usage limits: {type(exc).__name__}: {exc}")
            continue
        if found and found["resets_at"] - now() <= cap:
            limit = found
            fire_at = found["resets_at"] + (random.randint(jitter // 2, jitter) if jitter else 0)
            say(f"{key} is stopped by the claude.ai usage limit; its "
                f"{found['type'] or 'usage'} window reopens at {at_clock(found['resets_at'])} and "
                "this session will be told to continue then")


def reap_stale_work(ledger: dict, say) -> list[str]:
    """Close out what `stale_work_rows` names, as the next hand-launched session starts.

    Nothing reaps a `--work` row today: `reap_running` fires only when a DRIVER starts, and on this
    machine the driver has started twice against 32 hand-launched runs, leaving seven rows reporting
    a live session days after the fact (measured 2026-09-08, the oldest since 2026-09-03).

    Re-asserted under the ledger lock for the same reason `reap_running` is: a sibling session can
    record a real outcome for one of these while this pass is deciding, and publishing `error` over
    it would destroy a PR and then say no outcome was ever recorded.
    """
    if not stale_work_rows(ledger):
        return []
    reaped = []
    with ledger_held() as data:
        for key in list(stale_work_rows(ledger)):
            current = data.get(key) or ledger.get(key) or {}
            # Proven AGAIN, from the row on disk rather than from the snapshot the candidates were
            # chosen with. A sibling can start that very ticket in the window between the two — its
            # own `running` row and its own live pid — and a recheck that only asked "is it still
            # running?" would answer yes and overwrite it.
            why = work_row_death(current)
            if not why:
                ledger[key] = current
                continue
            entry = {**current, "status": "error", "attempts": current.get("attempts", 0) + 1}
            entry["flags"] = list(entry.get("flags") or []) + [
                f"left running by a hand-launched session that ended without recording an outcome; "
                f"{why}"]
            data[key] = entry
            ledger[key] = entry
            reaped.append(key)
    for key in reaped:
        say(f"  ! {key} was left running and no live session holds it — closed out as error")
    return reaped


def work_in_session(cfg: dict, slug: str, ticket: str, issue: dict, repo: Path, say) -> int:
    """Claim a slot, start an ordinary interactive `claude` in it, and release when it exits.

    `--claim` prints four lines to paste and `--release` takes them back, which is correct and is
    three things to remember at the moment you are trying to start work. This is the same sequence
    with the operator taken out of the middle: the cd, the three exports and the skill invocation all
    happen here, and the release happens when the session ends — including when it fails, or the
    terminal is interrupted, because a slot nobody gave back is a slot the next session cannot have.

    The session is a NORMAL interactive one. It inherits this terminal, so it looks and behaves
    exactly like starting `claude` by hand; the only difference is the directory it starts in and the
    three variables it starts with.
    """
    failure, where, base = prepare_repo(repo, say)
    if failure:
        say(f"  x {where}")
        say(f"    {PREPARE_REMEDY[failure]}")
        return 1
    claim = claim_slot(cfg, slug, ticket, repo, base, say)
    if not claim:
        return 1

    prompt = f"/resolve-ticket {issue.get('url') or claim['url']}"
    argv = [cfg["claude"].get("binary") or "claude"]
    if cfg["claude"].get("skip_permissions"):
        # Opt-in, unlike the headless path, because this session has somebody in front of it who
        # COULD answer a prompt — so bypassing is a choice rather than a structural necessity. What
        # it is scoped to is worth knowing: the session's own worktree, its own maven repository and
        # its own standalone, none of which is the operator's checkout.
        argv.append("--dangerously-skip-permissions")
    if cfg["claude"].get("remote_control"):
        # Named for the ticket. `--remote-control [name]` takes an optional value, and a name that
        # does not start with `-` binds to it, leaving the prompt as the positional it was.
        argv += ["--remote-control", f"{slug.split('/')[-1].replace('openmrs-module-', '')}"
                                     f"-{ticket.lstrip('#')}"]
    argv += common_claude_args(cfg)
    argv.append(prompt)
    say(f"{slug}#{ticket.lstrip('#')} on {claim['slot'].name} "
        f"({claim['slot'].describe().split(': ', 1)[1]})")
    say(f"  {claim['worktree']}")
    say("")

    # CTRL-C MUST REACH THE SESSION AND NOT THIS LAUNCHER. Ctrl-C is delivered to the whole
    # foreground process group, and the session is in ours — so without this, python raises
    # `KeyboardInterrupt` out of the wait below WHILE the session is still running, the `finally`
    # fires, and the release deletes the worktree out from under a live `claude`. Measured before the
    # fix: `subprocess.run` returned control after 2.3s against a child that caught SIGINT and ran on
    # for another 4. In Claude Code, Ctrl-C is how you interrupt a tool call — it is pressed
    # constantly, and it is not a request to end the session.
    #
    # A no-op HANDLER rather than `SIG_IGN`, and the difference is the whole trick: `exec` resets a
    # handled signal to its default in the child but leaves an IGNORED one ignored, so `SIG_IGN` here
    # would silently disable Ctrl-C inside the session as well. With a handler, the parent absorbs it
    # (PEP 475 resumes the interrupted wait) and the session gets the default disposition — its own
    # Ctrl-C, behaving exactly as it does when you start `claude` yourself.
    # SIGHUP and SIGTERM are absorbed for a DIFFERENT reason from SIGINT, and both are worth having.
    # They are delivered to the group as well, and their default action terminates this launcher
    # outright — so the `finally` never runs and the lease outlives the session that held it.
    # Measured: closing the terminal left `slot-1.json` and the worktree behind, and the operator had
    # to notice and `--release` by hand. Absorbed, the launcher outlives the signal by the moment it
    # takes the session (which received the same signal) to die, sees the wait return, and releases.
    # It cannot linger: it has nothing to do but wait, and the session is already going.
    def absorb(_signum, _frame):
        pass

    previous = {sig: signal.signal(sig, absorb)
                for sig in (signal.SIGINT, signal.SIGHUP, signal.SIGTERM)}
    key = f"{slug}#{ticket.lstrip('#')}"
    ledger = load_json(LEDGER, {})
    # Guarded, and for the same reason `record_work_outcome` is: this runs after the claim, so
    # anything raising here escapes with the slot, the worktree and the lease already taken and the
    # signals already absorbed — the release never happens and the operator has to find it by hand.
    try:
        reap_stale_work(ledger, say)
    except Exception as exc:
        say(f"! could not close out earlier hand-launched rows: {type(exc).__name__}: {exc}")
    started_at = now()
    write_ledger(ledger, key, {**ledger.get(key, {}), "status": "running", "launched_by": "work",
                               "slot": claim["slot"].name, "worktree": str(claim["worktree"]),
                               "last_run": datetime.now(timezone.utc).isoformat()})
    code = 1
    try:
        proc = subprocess.Popen(argv, cwd=str(claim["worktree"]), env=claim["env"])
        record_session(claim["slot"].name, proc.pid)
        # And the ROW carries it too, not only the lease. `--release` in a second terminal unlinks a
        # lease with no liveness check, and `active_leases` prunes one whose worktree was removed —
        # neither of which is death. The row is where the next session's reap looks for proof.
        write_ledger(ledger, key, {**ledger.get(key, {}), "session_pid": proc.pid})
        # The watcher writes to the LOG and not the screen: the session owns this terminal, and a
        # line printed into the middle of its TUI is worse than the thing being reported.
        stop = threading.Event()
        threading.Thread(target=watch_hand_launched, daemon=True,
                         args=(cfg, key, claim["worktree"], started_at, stop,
                               getattr(say, "quietly", say), proc.pid)).start()
        try:
            code = proc.wait()
        finally:
            stop.set()
        return code
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)
        # The ledger is how "is that ticket done?" gets answered later. A hand-launched run used to
        # leave no trace in it at all, so two tickets worked to ready PRs were invisible to
        # `--status` and had to be reconstructed from GitHub and the gate file by hand.
        # Guarded: recording what happened must never be able to cost the release below it. An
        # exception raised inside a `finally` skips the rest of that `finally`.
        try:
            record_work_outcome(cfg, ledger, key, slug, ticket, claim, code, started_at, say)
        except Exception as exc:
            say(f"! could not record the outcome in the ledger: {type(exc).__name__}: {exc}")
        # In `finally` deliberately: the release is the half an operator forgets, and it has to
        # happen on the paths they forget it on — a session that errored, or one that was killed.
        # QUALIFIED with the repository: a bare number is ambiguous once two repos are configured,
        # and an ambiguous release is refused — which would leave this session's own slot held.
        release_claim(cfg, key, say)


def driver_problems() -> list[str]:
    """A hand-launched session must not start while the DRIVER is working tickets.

    The mirror image of `claim_problems`, and without it the symmetry is decorative: the driver
    refuses to start while a claim is held, but a claim happily took a standalone a running driver
    was already using. Only a LIVE holder counts — a lock left by a killed driver is cleared by the
    next driver, and must not block an operator in the meantime.
    """
    if not LOCK.exists():
        return []
    pid = load_json(LOCK, {}).get("pid")
    if not isinstance(pid, int) or pid <= 0 or pid == os.getpid():
        return []
    try:
        os.kill(pid, 0)
    except OSError:
        return []          # the holder is gone; the next driver clears the file
    return [f"a pool driver is running (pid {pid}) and is using these standalones. Wait for it, or "
            f"stop it, before starting a session by hand"]


def claim_problems(cfg: dict) -> list[str]:
    """The driver must not run while hand-launched sessions hold slots.

    Both would be using the same standalones, and the driver cannot see what a session it did not
    start is doing with one. Refusing is the only honest answer; the remedy is one command.
    """
    held = active_leases()
    if not held:
        return []
    lines = ", ".join(f"{n} (#{l.get('ticket')})" for n, l in sorted(held.items()))
    return [f"{len(held)} slot claim(s) are outstanding — {lines}. A hand-launched session is using "
            f"that standalone. Finish those and `pool-run --release <ticket>`, or run "
            f"`pool-run --claims` to see them"]


# ────────────────────────────────────────────────────────────── preflight ──


def repo_slug(path: Path) -> str | None:
    got = sh(["git", "-C", str(path), "remote", "get-url", "origin"])
    if got.returncode != 0:
        return None
    url = got.stdout.strip()
    m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?$", url)
    return m.group(1) if m else None


def default_branch(path: Path) -> str:
    got = sh(["git", "-C", str(path), "rev-parse", "--abbrev-ref", "origin/HEAD"])
    if got.returncode == 0 and "/" in got.stdout:
        return got.stdout.strip().split("/", 1)[1]
    for candidate in ("main", "master"):
        if sh(["git", "-C", str(path), "rev-parse", "--verify", f"origin/{candidate}"]).returncode == 0:
            return candidate
    return "main"


def parity_problems(cfg: dict) -> list[str]:
    """Where the LIVE copies and the source repo's mirror disagree.

    Three separate copies of this machinery exist and only one of them is what actually runs: the
    skills under `~/.claude/skills`, the gate scripts registered under `~/.claude/hooks`, and the
    committed mirror in the source repo. `skill-retro` Step 6 is what keeps them in step; this reports
    when they are not. It is a warning before a run and a finding after a retro, and the same
    definition for both on purpose — two copies of a consistency check drift exactly like the thing
    they are checking.
    """
    problems = []
    for installed, shipped in GATE_PAIRS:
        if installed.is_file() and shipped.is_file() and installed.read_bytes() != shipped.read_bytes():
            problems.append(f"{installed.name}: the registered hook differs from the skill's own copy, "
                            "so the gate is running logic the skill no longer describes")
    src = cfg.get("source_repo")
    if not src:
        return problems
    for script in ("pool-run", "pool-watch", "gate-state"):
        mine, mirrored = PIPELINE / script, Path(src).expanduser() / ".claude/pipeline" / script
        if not mirrored.is_file():
            problems.append(f"{script} is not mirrored in the source repo")
        elif mine.is_file() and mirrored.read_bytes() != mine.read_bytes():
            problems.append(f"{script} differs from the source repo — what ran is not what the repo "
                            "records")
    for skill in MIRRORED_SKILLS:
        live, mirror = CLAUDE / "skills" / skill, Path(src).expanduser() / ".claude/skills" / skill
        if not mirror.is_dir():
            problems.append(f"{skill} is not mirrored in the source repo")
            continue
        for f in sorted(live.rglob("*")):
            if f.is_file():
                m = mirror / f.relative_to(live)
                if not m.is_file():
                    problems.append(f"{skill}/{f.relative_to(live)} is not in the source repo")
                elif m.read_bytes() != f.read_bytes():
                    problems.append(f"{skill}/{f.relative_to(live)} differs from the source repo")
    return problems


def preflight(cfg: dict, say: Say, want_label: bool, driving: bool = True) -> list[str]:
    """Returns a list of fatal problems. Non-fatal ones are said and carried.

    `driving` is False for a command that is not about to work tickets itself. It gates exactly one
    check — the outstanding-claims refusal — because that refusal is about the DRIVER and a
    hand-launched session sharing standalones. Applied to `--claim` it refuses the second claim, which
    is the entire feature: measured by doing it, `--claim 297` after `--claim 266` failed with the
    driver's own message and set nothing up.
    """
    fatal: list[str] = []

    for tool in ("claude", "gh", "jq", "git"):
        if not shutil.which(tool):
            fatal.append(f"{tool} is not on PATH")
    if shutil.which("gh") and sh(["gh", "auth", "status"]).returncode != 0:
        fatal.append("gh is not authenticated (`gh auth login`)")

    hooks = json.dumps(load_json(SETTINGS, {}).get("hooks", {}))
    for gate in ("pr-harden-gate.sh", "harden-cycle-gate.sh"):
        if gate not in hooks:
            fatal.append(
                f"{gate} is not registered as a Stop hook in ~/.claude/settings.json — without it "
                "the skills' termination contract is prose and an unattended run can stop early"
            )

    for skill in REQUIRED_SKILLS:
        if not (CLAUDE / "skills" / skill / "SKILL.md").is_file():
            fatal.append(f"skill {skill} is missing from ~/.claude/skills")

    for problem in parity_problems(cfg):
        say(f"  ! {problem}")

    workers = max(1, int(cfg["parallel"]["max_workers"]))
    fatal += slot_problems(cfg, workers)
    fatal += platform_problems(cfg, workers)
    # Each side refuses to start while the other is working, and the two checks are deliberately
    # separate: they are asked by different callers about different evidence.
    fatal += claim_problems(cfg) if driving else driver_problems()
    if workers > 1:
        # The per-slot maven repository is a SPLIT repository, which Maven only understands from
        # 3.9. Under an older one `maven.repo.local.tail` is ignored, the head repository is empty,
        # and an offline build fails on the first dependency — so this is fatal rather than a
        # warning, and it is checked here rather than discovered by the first `mvn -o` of a run.
        got = sh(["mvn", "-v"])
        m = re.search(r"Apache Maven (\d+)\.(\d+)", got.stdout)
        if not m:
            fatal.append("could not read the maven version, and a parallel run needs >= 3.9 for "
                         "the per-slot split local repository")
        elif (int(m.group(1)), int(m.group(2))) < (3, 9):
            fatal.append(f"maven {m.group(1)}.{m.group(2)} is too old for a parallel run: the "
                         "per-slot `maven.repo.local.tail` needs >= 3.9. Without it the workers "
                         "share ~/.m2 and overwrite each other's module jars")
        tail = shared_maven_repo(cfg)
        if not tail.is_dir():
            fatal.append(f"{tail} does not exist, so there is nothing for the per-slot repositories "
                         "to read through. Set parallel.shared_m2 if your local repository is "
                         "somewhere else")

    if not cfg["repos"]:
        fatal.append("no repos configured in pool.json")
    for slug, path in cfg["repos"].items():
        p = Path(path).expanduser()
        if not (p / ".git").exists():
            fatal.append(f"{path} is not a git checkout (repo {slug})")
            continue
        found = repo_slug(p)
        if found and found.lower() != slug.lower():
            fatal.append(f"{path} has origin {found}, but pool.json files it under {slug}")
        if want_label:
            got = sh(["gh", "label", "list", "--repo", slug, "--limit", "200", "--json", "name"])
            names = [x["name"] for x in load_json_str(got.stdout, [])]
            if got.returncode == 0 and cfg["label"] not in names:
                fatal.append(
                    f"label {cfg['label']!r} does not exist in {slug} — run `pool-run --init` "
                    "to create it, then label the issues you want worked"
                )

    src = cfg.get("source_repo")
    if cfg["retro"]["enabled"]:
        if not src:
            fatal.append("retro is enabled but source_repo is not configured")
        elif not (Path(src).expanduser() / ".git").exists():
            fatal.append(f"source_repo {src} is not a git checkout")

    return fatal


def load_json_str(text: str, default):
    try:
        return json.loads(text)
    except ValueError:
        return default


# ────────────────────────────────────────────────────────────────── queue ──


def open_prs(slug: str) -> list[dict]:
    got = sh(
        ["gh", "pr", "list", "--repo", slug, "--state", "open", "--limit", "100", "--json",
         "number,title,isDraft,headRefName,closingIssuesReferences,url,body,createdAt"]
    )
    return load_json_str(got.stdout, [])


def pr_for_ticket(prs: list[dict], ticket: str, since: int | None = None) -> dict | None:
    """The PR for a ticket, in three descending tiers of how sure the link is.

    Tier 1 is `closingIssuesReferences`, which only a `Fixes` keyword populates. Tier 2 is the ticket
    named in the title or the branch. **Tier 3 is the body, and it is not redundant:** the skill
    writes `Refs #n` instead of `Fixes #n` whenever the PR delivers something short of the ticket —
    an instrument, a diagnosis, one part of several — which is exactly what a careful run produces,
    and that keyword populates no field and may appear nowhere but the body. Its branch naming also
    permits `fix/<slug>` with no number in it, so tiers 1 and 2 can BOTH miss a PR the run really
    opened, and the driver would then report `no-pr` over a finished piece of work.

    Tier 3 needs a bound, because a body is prose and may mention any issue: it counts only for a PR
    created since `since`. So the two callers ask different questions with the same function — "does a
    PR for this ticket already exist?" passes no `since` and gets tiers 1-2 only, because a wrong yes
    there silently drops a ticket from the queue; "did THIS run open one?" passes the run's start and
    can afford the third tier, because recency is what makes it safe.
    """
    num = ticket.lstrip("#")
    digit = num.isdigit()
    named = rf"(?<!\d)#?{num}(?!\d)" if digit else re.escape(num)
    flags = 0 if digit else re.IGNORECASE
    best = None
    for pr in prs:
        tier = 0
        if num in [str(r.get("number")) for r in pr.get("closingIssuesReferences") or []]:
            tier = 3
        elif re.search(named, pr.get("title") or "", flags) or re.search(
                named, pr.get("headRefName") or "", flags):
            tier = 2
        elif since is not None and re.search(named, pr.get("body") or "", flags) and (
                pr_created_at(pr) or 0) >= since:
            tier = 1
        if tier and (best is None or (tier, pr["number"]) > (best[0], best[1]["number"])):
            best = (tier, pr)
    return best[1] if best else None


def pr_created_at(pr: dict) -> int | None:
    try:
        return int(datetime.fromisoformat(pr["createdAt"].replace("Z", "+00:00")).timestamp())
    except (KeyError, TypeError, ValueError):
        return None


def consider(slug: str, path: str, issue: dict, prs: list[dict], ledger: dict, say: Say,
             cfg: dict, forced: bool) -> dict | None:
    """One issue against the skips. `forced` is an operator naming it, which passes every one.

    Shared by both queue paths on purpose: the label path and the named path must agree about what
    "already worked", "already has a PR" and "out of attempts" mean, and two copies of that would
    drift into two answers.
    """
    ticket = str(issue.get("number") or issue.get("key"))
    key = f"{slug}#{ticket}"
    entry = ledger.get(key, {})
    if not entry:
        # Rows written before `ticket_id` existed are keyed on the RAW token (`slug#<url>`), so the
        # normalised key misses them and the row's whole history goes with it: `attempts` resets to
        # 0, and so does the `aborted` verdict that stops an identical second attempt. Matched on the
        # first `#` because a slug cannot contain one while a pasted URL can (`#issuecomment-…`).
        # Read-side only — nothing here rewrites the ledger, so a live driver's writes are not raced.
        entry = next((v for k, v in ledger.items()
                      if k.partition("#")[0] == slug
                      and ticket_id(k.partition("#")[2]) == ticket), {})
    url = issue.get("url") or (
        ticket if not ticket.isdigit() else f"https://github.com/{slug}/issues/{ticket}")

    # Forced past the skip below, and the operator is entitled to do that — but not to do it
    # unknowingly. The suspended session is abandoned here, and whether the restart even begins
    # depends on the worktree, so both are said rather than discovered afterwards.
    if forced and entry.get("status") in SUSPENDED:
        say(f"  ! {key}: named explicitly while PAUSED. This abandons the suspended session "
            f"{entry.get('session_id')} and works the ticket from the start; its transcript stays "
            "on disk under that id. `pool-run --resume` continues it instead.")
    if not forced:
        if entry.get("status") in DONE or entry.get("status") in NOT_OURS:
            return None
        if entry.get("status") in SUSPENDED:
            say(f"  - {key}: paused with its session suspended — `pool-run --resume` continues it "
                "where it stopped. Skipping.")
            return None
        if entry.get("status") in NEEDS_HUMAN:
            say(f"  - {key}: the run aborted and handed back — one of resolve-ticket's six "
                "conditions, which a second identical attempt cannot get past. Skipping.")
            return None
        # The ledger remembers the PR a previous attempt opened, and that memory beats re-matching
        # prose: an attempt that ended as a draft may have written `Refs` on a branch carrying no
        # number, which tiers 1-2 cannot see — and a second run on such a ticket opens a SECOND PR
        # for one issue.
        known = entry.get("pr")
        existing = next((x for x in prs if x["number"] == known), None) if known else None
        existing = existing or pr_for_ticket(prs, ticket)
        if existing:
            say(f"  - {key}: open PR #{existing['number']} already exists — that is "
                "`pr-harden`'s entry point, not this pipeline's. Skipping.")
            ledger[key] = {**entry, "status": "has-open-pr", "pr": existing["number"],
                           "pr_url": existing.get("url")}
            return None
        attempts = entry.get("attempts", 0)
        if attempts >= cfg["ticket"]["max_attempts"]:
            say(f"  - {key}: {attempts} attempts already, last {entry.get('status')} — "
                "needs a human before another attempt. Skipping.")
            return None

    return {"slug": slug, "path": Path(path).expanduser(), "ticket": ticket, "url": url,
            "title": issue.get("title", ""), "key": key}


def resolve_named(token: str, slug: str) -> dict | None:
    """One operator-named ticket against one repo, or None if that repo does not own it.

    The token is reduced to its identifier FIRST (`ticket_id`), so a GitHub issue URL, a JIRA browse
    URL and a bare number all name the same ticket everything downstream will. Before that a URL came
    back verbatim as a JIRA `key`, and the whole string then became the ledger key, the log stem and
    the worktree path — see `ticket_id` for what that cost.

    A GitHub URL also names its own repository, so it is matched against `slug` rather than tried
    against every repo in the pool: that is the difference between "this repo does not own it" and
    "no repo owns it", and only the URL form can tell them apart.
    """
    owner = ticket_repo(token)
    if owner and owner.lower() != slug.lower():
        return None
    ident = ticket_id(token)
    if ident.isdigit():
        got = sh(["gh", "issue", "view", ident, "--repo", slug, "--json", "number,title,url"])
        if got.returncode != 0:
            return None
        return load_json_str(got.stdout, {"number": int(ident), "title": "", "url": ""})
    return {"key": ident, "title": f"JIRA {ident}",
            "url": token.strip() if token.strip().startswith("http") else ident}


def build_queue(cfg: dict, ledger: dict, say: Say, named: list[str] | None) -> list[dict]:
    """The queue, either from the label or from tickets the operator named.

    **The named path keeps the operator's ORDER and does not sort.** Order has consequences the
    driver cannot weigh — the retro fires once the record threshold is met, so which tickets run
    first decide what evidence it reads and which ticket is worked by the skills it changed — and
    weighing those means judging the tickets, which is the one thing this driver does not do. So the
    operator's sequence is taken literally, and the label path's ascending issue number stays the
    default for the reason a default should be boring: the same labels give the same order every
    invocation.
    """
    queue: list[dict] = []
    pr_cache: dict[str, list[dict]] = {}

    def prs_for(slug: str) -> list[dict]:
        if slug not in pr_cache:
            pr_cache[slug] = open_prs(slug)
        return pr_cache[slug]

    if named:
        # Tokens in the OUTER loop, so the requested order survives even across several repos.
        for token in named:
            found = False
            for slug, path in cfg["repos"].items():
                issue = resolve_named(token, slug)
                if issue is None:
                    continue
                job = consider(slug, path, issue, prs_for(slug), ledger, say, cfg, forced=True)
                if job:
                    queue.append(job)
                found = True
                break
            if not found:
                say(f"  ! {token}: no configured repo has this issue. Skipping.")
        # Deduped HERE rather than at the call site: `build_queue` is the one place a queue is made,
        # and a guard wired in `main` was pinned by nothing — removing it reddened no test at all,
        # because the case drove `dedupe_queue` directly and never the path that uses it.
        return dedupe_queue(queue, say)

    for slug, path in cfg["repos"].items():
        # Enumerate the open issues and filter the label HERE, rather than passing --label.
        # Measured 2026-08-26: three issues labelled through `gh issue edit`, all three confirmed
        # by reading each issue, and `gh issue list --label` returned ONE of them — that filter is
        # search-indexed and the index lagged. It caught up unprompted a minute later. The queue is
        # built once at the start of an invocation, so labelling a ticket and starting the pool
        # loses it for that whole run, silently and fail-closed: no error, no count that looks
        # wrong, just work you queued that nobody does. An issue's own `labels` field is not
        # indexed, so this reads what is true now. It also makes the preflight label check
        # load-bearing rather than a courtesy — a mistyped label now yields an empty queue by the
        # same mechanism a correct one yields a full one.
        got = sh(
            ["gh", "issue", "list", "--repo", slug, "--state", "open",
             "--limit", "200", "--json", "number,title,url,updatedAt,labels"]
        )
        if got.returncode != 0:
            say(f"  ! could not list issues in {slug}: {got.stderr.strip()[:200]}")
            continue
        issues = [i for i in load_json_str(got.stdout, [])
                  if any(l.get("name") == cfg["label"] for l in i.get("labels") or [])]
        for issue in sorted(issues, key=lambda i: i.get("number", 0)):
            job = consider(slug, path, issue, prs_for(slug), ledger, say, cfg, forced=False)
            if job:
                queue.append(job)
    return dedupe_queue(queue, say)


# ───────────────────────────────────────────────────────── checkout prep ──


# What an operator has to DO about a repository this driver would not start on. The list is shorter
# than it was, and deliberately: the driver no longer checks out, resets or branches the operator's
# own checkout, so "uncommitted work in it" and "its default branch is ahead of origin" stopped being
# reasons to skip anything. It fetches, and it cuts each ticket a worktree from `origin/<default>`.
# That removed the pool's own worst case — one dirty checkout skipping every remaining ticket.
PREPARE_REMEDY = {
    "checkout-blocked": "Nothing was touched. The repository could not be fetched or its default "
                        "branch could not be resolved on origin (the line above says which); fix "
                        "that, then re-run.",
    "worktree-blocked": "Nothing was touched. A previous run left uncommitted work in that worktree. "
                        "Read it, then `git worktree remove --force <path>` to release the ticket.",
}


def prepare_repo(path: Path, say) -> tuple[str | None, str, str]:
    """`(None, where, base sha)` when the repository can be worked, else `(status, why, "")`.

    It returns the sha it resolved rather than leaving the caller to resolve it again. Two
    resolutions of "what are we cutting from" is two answers waiting to differ, and the second one
    would be the one every worktree actually used.

    This used to be `prepare_checkout`, and it used to CHECK OUT: it refused a dirty tree, switched
    to the default branch and fast-forwarded it, so every ticket for a repo took turns in one working
    tree and a single uncommitted file stalled the whole pool. Tickets now get a worktree each, cut
    straight from `origin/<default>`, so none of the local state matters and none of it is touched.
    What is left is the one thing that does matter: can we fetch, and does the remote branch resolve.

    Cutting from the REMOTE ref rather than local HEAD also settles the "ahead of origin" case this
    function used to have to detect. A local unpushed commit can no longer end up inside a ticket's
    PR, because no ticket branch is ever cut from local HEAD.
    """
    fetched = sh(["git", "-C", str(path), "fetch", "origin", "--prune"], timeout=600)
    if fetched.returncode != 0:
        return "checkout-blocked", f"could not fetch origin: {fetched.stderr.strip()[:300]}", ""
    branch = default_branch(path)
    sha = remote_head(path)
    if not sha:
        return "checkout-blocked", f"origin/{branch} does not resolve in {path}", ""
    return None, f"origin/{branch} @ {sha[:8]}", sha


def remote_head(path: Path) -> str:
    """The sha every worktree for this repo is cut from, for this invocation."""
    return sh(["git", "-C", str(path), "rev-parse",
               f"origin/{default_branch(path)}"]).stdout.strip()


# `git worktree add` and `remove` both write `.git/worktrees`, and several workers reach them at
# once. Git takes its own locks per worktree, not over the registration as a whole, so this is ours.
WORKTREE_LOCK = threading.Lock()


def ticket_id(token: str) -> str:
    """The identifier a ticket is KNOWN by, from whatever the operator typed.

    One normaliser because the token reaches four things that must agree about what ticket this is —
    the worktree path, the ledger key, the lease file and the log stem — and it used to reach all of
    them raw. Measured on the #238 run: the pool was handed
    `https://github.com/openmrs/openmrs-module-chartsearchai/issues/238`, and since `resolve_named`
    returns a non-digit token verbatim, `worktree_path` interpolated the whole URL. `Path` then ate
    the slashes, so the tree was created at `<worktrees>/…-https:/github.com/…/issues/238` — outside
    `WORKTREES`, three components deep, and carrying a COLON. javac splits its classpath on `:`, so
    nothing in that tree could compile its tests: `mvn` built `target/classes` and then failed every
    test with "cannot find symbol" against the classes it had just written.

    Accepts a GitHub issue/PR URL, a JIRA browse URL, a bare number, a `#`-prefixed number, or a bare
    JIRA key, and returns the number or the key. Anything it does not recognise comes back stripped
    of whitespace and a leading `#` — never expanded, because inventing an identifier for a token
    nobody can parse is how one ticket becomes two directories.
    """
    token = (token or "").strip().lstrip("#")
    gh = _GH_ISSUE.match(token)
    if gh:
        return gh.group(2)
    jira = _JIRA_BROWSE.match(token)
    if jira:
        return jira.group(1)
    return token


def ticket_repo(token: str) -> str | None:
    """The `owner/repo` a GitHub URL names, or None for any other token.

    Only a URL says which repository it belongs to. Everything else is resolved against each repo in
    turn, which is what `resolve_named` already does — so returning None here means "ask them all",
    the behaviour every non-URL token has always had.
    """
    got = _GH_ISSUE.match((token or "").strip())
    return got.group(1) if got else None


# One pattern for both questions a GitHub issue URL answers — which ticket, and which repo — so the
# two can never disagree about what counts as one. The scheme is optional and the host matched
# case-insensitively because those are what an operator's paste actually varies, and a trailing
# `?query` or `#fragment` is allowed and discarded: the address bar carries `#issuecomment-…` the
# moment you scroll to a comment, which is the likeliest paste of all and the one the first cut of
# this fix did not recognise.
_GH_ISSUE = re.compile(
    r"^(?:https?://)?(?:www\.)?github\.com/([^/]+/[^/]+)/(?:issues|pull)/(\d+)(?:[/?#].*)?$", re.I)
_JIRA_BROWSE = re.compile(
    r"^(?:https?://)?[^/\s]+/browse/([A-Za-z][A-Za-z0-9]*-\d+)(?:[/?#].*)?$", re.I)

# Anything outside this cannot go in a path component. It is not only about the colon that started
# this: a `/` silently NESTS the tree somewhere else entirely, and `..` walks out of WORKTREES.
_UNSAFE = re.compile(r"[^A-Za-z0-9._-]+")


def safe_component(raw: str) -> str:
    """One path COMPONENT from an arbitrary string, collision-free.

    Sanitising is many-to-one — `PROJ:123` and `PROJ/123` both reduce to `PROJ-123` — so anything
    this had to rewrite carries a digest of the ORIGINAL. `raw` comes back untouched only when it is
    already a usable component — non-empty, no disallowed character, no leading or trailing `-` or
    `.` — which is every number, every JIRA key and every URL `ticket_id` reduces. A string that is
    character-safe but ends in `-` or `.` IS rewritten and gains a digest, and so is the EMPTY
    string, which the equality test would otherwise hand back unchanged as a component that is not
    one.

    Shared because `ticket_id` deliberately passes an UNRECOGNISED token through almost unchanged,
    and three places then put that string in a filename: this ticket's worktree, its lesson record
    and its log stem. Guarding only the worktree left the same defect at the other two.
    """
    safe = _UNSAFE.sub("-", raw).strip("-.")
    if safe and safe == raw:
        return raw
    return f"{safe or 'ticket'}-{hashlib.sha1(raw.encode()).hexdigest()[:8]}"


def worktree_path(slug: str, ticket: str) -> Path:
    """One ticket, one directory, and the leaf is always a single safe component.

    Normalised THEN sanitised, and both halves earn their place: normalising is what makes a URL and
    its number the same tree rather than two, and sanitising is what keeps a token nobody thought of
    from reaching the filesystem at all. The sanitising itself lives in `safe_component`, which
    the lesson record and the log stem call too — this used to hold it inline, and holding it here is
    what left those two unguarded.
    """
    return WORKTREES / safe_component(f"{slug.replace('/', '-')}-{ticket_id(ticket)}")


def make_worktree(repo: Path, slug: str, ticket: str, base: str, say) -> tuple[Path | None, str]:
    """One ticket, one working tree, detached at the remote head.

    DETACHED and not on a branch, because the skill cuts its own branch as its first act and git
    refuses to check out one branch in two worktrees — so starting detached is what lets two tickets
    of one repository be in flight at all.

    An existing directory here is a previous run's leftover. If it is clean it is removed and
    recreated, since nothing is in it to lose; if it holds uncommitted work the ticket is REFUSED and
    the path is named, because deleting a killed run's evidence to get past it is the one thing this
    driver must not do quietly. That refusal now costs one ticket rather than the whole pool.
    """
    with WORKTREE_LOCK:
        sh(["git", "-C", str(repo), "worktree", "prune"])
        wt = worktree_path(slug, ticket)
        if wt.exists():
            dropped = drop_worktree(repo, wt, say, locked=True)
            if not dropped.startswith("removed"):
                return None, f"a previous run left it unreleased — {dropped}"
        wt.parent.mkdir(parents=True, exist_ok=True)
        made = sh(["git", "-C", str(repo), "worktree", "add", "--detach", str(wt), base])
        if made.returncode != 0:
            return None, f"could not create a worktree at {wt}: {made.stderr.strip()[:300]}"
        return wt, f"{wt} @ {base[:8]}"


def drop_worktree(repo: Path, wt: Path, say, force: bool = False, locked: bool = False) -> str:
    """Release a worktree, unless it still holds work nobody has seen.

    Committed work is never at risk here — removing a worktree does not delete the branch it was on,
    and the ticket's branch lives in the shared repository — so the only thing a removal can lose is
    an UNCOMMITTED change, which is exactly what this checks for. A run that pushed its PR leaves a
    clean tree and its directory goes; a run killed mid-edit keeps its directory and says so.
    """
    def release() -> str:
        if not force:
            dirty = sh(["git", "-C", str(wt), "status", "--porcelain"]).stdout.strip()
            if dirty:
                n = len(dirty.splitlines())
                return f"kept: {n} uncommitted change(s) in {wt}"
        gone = sh(["git", "-C", str(repo), "worktree", "remove", "--force", str(wt)])
        if gone.returncode != 0 and wt.exists():
            shutil.rmtree(wt, ignore_errors=True)
            sh(["git", "-C", str(repo), "worktree", "prune"])
        return f"removed {wt}"

    if locked:
        return release()
    with WORKTREE_LOCK:
        return release()


def tenant_key(path: Path) -> str:
    """The key both Stop hooks use for a working tree: its PHYSICAL path.

    The hooks resolve with `pwd -P` and `gate-state` with `realpath`, so anything here that keys on a
    logical path writes an entry the gate cannot find — and "no entry" is the gate's fail-OPEN case.
    """
    return os.path.realpath(path)


GATE_STATE = PIPELINE / "gate-state"


def gate_state_cmd(*argv: str) -> dict:
    """Every read and write of the gate files goes through `gate-state`, never through load/save here.

    Those two files are shared with LIVE claude sessions, which write them through `gate-state` under
    an exclusive `flock`. A read-modify-write here takes no lock and so is not serialised against
    them, nor against this driver's own ticket threads — and this driver is concurrent by
    construction (`ThreadPoolExecutor`, one worktree per ticket). The lost update resurrects an entry
    a finished run legitimately cleared, which then blocks the next session in that path for six
    hours, or drops another worktree's `awaiting`, which is the unattended death the marker exists to
    prevent. That is verbatim the race `gate-state`'s own docstring says it exists to remove, so the
    fix is to use it rather than to add a second lock here.

    Measured on the pre-fix code (2026-08-27, `pool-run` at 9866a1f, driving its own
    `clear_gate_state` from 20 threads over 20 worktrees, 5 trials): 16, 16, 17, 17 and 17 of the 20
    entries SURVIVED a clear that removed all 20, and 56 threads died of `FileNotFoundError` racing
    the shared `.tmp` path. Nothing in the driver noticed either. Every survivor blocks the next
    session in that worktree for six hours.

    Returns {} on any failure — a missing helper, a non-zero exit, unparseable output. The caller
    then reports nothing and clears nothing, which is the safe direction: racing the files is worse
    than leaving a leftover for `STALE_AFTER` to expire.
    """
    if not GATE_STATE.exists():
        return {}
    try:
        r = subprocess.run([str(GATE_STATE), *argv], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return {}
    if r.returncode != 0:
        return {}
    try:
        return json.loads(r.stdout or "{}")
    except ValueError:
        return {}


def clear_gate_state(path: Path, say) -> list[str]:
    """A crashed run leaves an entry that blocks turns in this working tree for up to 6 hours.

    The next run writes its own entry at its Step 1, so removing a leftover is not a loophole — but
    it IS evidence about the run that left it, so it is reported rather than quietly dropped. The
    report comes back FROM the clear, in one locked operation: reading it first and clearing it second
    would be two, and the gap between them is the race described on `gate_state_cmd`.
    """
    removed = gate_state_cmd("--cwd", str(path), "clear", "--json")
    names = {"pr": PR_STATE.name, "harden": HARDEN_STATE.name}
    cleared = [
        f"{names[w]}: phase={e.get('phase')} blocking={e.get('blocking')} "
        f"edits={e.get('edits')} pr={e.get('pr')} round={e.get('round')}"
        for w, e in sorted(removed.items()) if e
    ]
    for line in cleared:
        say(f"    cleared leftover gate state — {line}")
    return cleared


def read_gate_state(path: Path) -> dict:
    return gate_state_cmd("--cwd", str(path), "show", "--json").get("pr", {})


UNATTENDED_DIR = PIPELINE / "unattended"


def unattended_marker_path(path: Path) -> Path:
    return UNATTENDED_DIR / (tenant_key(path).replace("/", "_").lstrip("_") + ".json")


@contextlib.contextmanager
def unattended_marker(path: Path):
    """Tell the Stop-hook gate that this working tree is being driven with no human on the other end.

    The gate cannot read this off the state ENTRY, because the skill rewrites that entry as its own
    Step 1 and would drop any field we seeded there — silently, and fail-open straight back into the
    defect this marker exists to close. So it is a file, and it carries our pid: a driver killed with
    SIGKILL leaves the marker behind, and a stale marker whose owner is gone must not make an
    interactive session in this tree unattended.

    With several tickets in flight there is one marker per worktree and they all carry the SAME pid,
    the driver's. That is correct: the hook asks whether the marker's pid is an ANCESTOR of the
    session asking, and the driver is the ancestor of all of them, so each session is unattended in
    its own tree and none of them is foreign to another's.
    """
    UNATTENDED_DIR.mkdir(parents=True, exist_ok=True)
    marker = unattended_marker_path(path)
    marker.write_text(json.dumps({"pid": os.getpid(), "cwd": tenant_key(path), "since": now()}))
    try:
        yield marker
    finally:
        marker.unlink(missing_ok=True)


