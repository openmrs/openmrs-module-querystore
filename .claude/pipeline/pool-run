# ─────────────────────────────────────────────────────────────── plumbing ──


def now() -> int:
    return int(time.time())


def utc_date() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%d")


def utc_stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def hms(seconds: float) -> str:
    seconds = int(seconds)
    h, m = seconds // 3600, (seconds % 3600) // 60
    return f"{h}h{m:02d}m" if h else f"{m}m{seconds % 60:02d}s"


class Say:
    """stdout for the operator, and a markdown transcript of the same for the log.

    Serialised, because with several tickets in flight this has concurrent callers: the whole
    append-and-rewrite is one critical section, or two workers read the same `self.lines`, each
    appends its own line, and the second rewrite drops the first — losing operator output in exactly
    the run where there is most of it to read.

    `for_ticket` is how a worker writes: every line it produces is tagged with the ticket that
    produced it. Untagged interleaved output from N runs is not a log, it is noise.
    """

    def __init__(self, path: Path):
        self.path = path
        self.lines: list[str] = []
        self.lock = threading.Lock()
        path.parent.mkdir(parents=True, exist_ok=True)

    def __call__(self, line: str = "") -> None:
        with self.lock:
            print(line, flush=True)
            self.lines.append(line)
            try:
                self.path.write_text("\n".join(self.lines) + "\n")
            except OSError:
                pass

    def for_ticket(self, tag: str):
        """A `Say` for one worker: same sink, every line labelled with whose it is."""
        def tagged(line: str = "") -> None:
            self(f"{tag} {line}" if line else tag)
        return tagged


def sh(args: list[str], cwd: Path | None = None, timeout: int = 300) -> subprocess.CompletedProcess:
    return subprocess.run(
        args, cwd=str(cwd) if cwd else None, capture_output=True, text=True, timeout=timeout
    )


def iso_to_epoch(stamp) -> int | None:
    try:
        return int(datetime.fromisoformat(str(stamp).replace("Z", "+00:00")).timestamp())
    except (TypeError, ValueError):
        return None


def load_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def save_json(path: Path, data) -> None:
    """Write atomically, through a temp path NO other writer can be using.

    The rename is atomic, so a reader always sees one whole version — but a FIXED `.tmp` suffix is
    shared by every concurrent writer, and `write_text` truncates before it writes. Two writers then
    interleave inside one temp file and the rename publishes whichever truncation won. Scoped to the
    pid and thread, the temp path is private and the rename is the only thing that races, which is
    what atomic means.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(f"{path.suffix}.tmp{os.getpid()}.{threading.get_ident()}")
    try:
        tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
        tmp.replace(path)
    finally:
        tmp.unlink(missing_ok=True)


def merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in (over or {}).items():
        out[k] = merge(base[k], v) if isinstance(v, dict) and isinstance(base.get(k), dict) else v
    return out


# ───────────────────────────────────────────────────────────────── locking ──


def take_lock(say: Say) -> bool:
    if LOCK.exists():
        holder = load_json(LOCK, {})
        pid = holder.get("pid")
        alive = False
        if isinstance(pid, int):
            try:
                os.kill(pid, 0)
                alive = True
            except OSError:
                alive = False
        if alive:
            say(f"another pool-run holds the lock (pid {pid}, since {holder.get('started')}).")
            say("The lock is one per MACHINE, not one per checkout, and deliberately: two drivers "
                "would each retro over the other's records and race the one ledger. Several tickets "
                "at once is what --workers is for, inside one driver that can hold the wave barrier. "
                "Stopping.")
            return False
        say(f"clearing a stale lock from pid {pid} (no such process).")
    save_json(LOCK, {"pid": os.getpid(), "started": datetime.now(timezone.utc).isoformat()})
    return True


def drop_lock() -> None:
    """Release the lock only if it is OURS.

    An unconditional unlink here was a live hazard the moment a read-only mode stopped taking the lock:
    skipping `take_lock` does not skip the `finally`, so a `--dry-run` alongside a working pool DELETED
    that pool's lock and left the checkout open to a second driver — the exact collision the lock
    exists to prevent. Measured by doing it, to a real run, 18 minutes into its first ticket.
    """
    holder = load_json(LOCK, {})
    if holder.get("pid") != os.getpid():
        return
    try:
        LOCK.unlink()
    except OSError:
        pass


# ─────────────────────────────────────────────────────────────────── slots ──


PORT_KEYS = ("tomcatport", "dbport")


def standalone_ports(home: Path) -> dict[str, int | None]:
    """The two ports a standalone binds, read from its own runtime properties.

    Both matter and reading only the tomcat port is not enough: a standalone runs an embedded MariaDB
    as well, and two instances agreeing on 3316 fail to start for a reason that looks nothing like a
    port clash from the outside. Measured on this machine — five of the eight standalones on disk
    share 8081/3316, so "there are several standalones" is not the same as "several can run at once".
    """
    props = home / "openmrs-runtime.properties"
    ports: dict[str, int | None] = {"tomcatport": None, "dbport": None}
    try:
        text = props.read_text()
    except OSError:
        return ports
    for line in text.splitlines():
        if line.startswith("tomcatport="):
            with contextlib.suppress(ValueError):
                ports["tomcatport"] = int(line.split("=", 1)[1].strip())
        # Any host, not just 127.0.0.1: a standalone written with `localhost` published no database
        # port at all under the narrower pattern, so two of them agreeing on 3316 passed the
        # port-clash check and failed at startup instead.
        m = re.search(r"//[^/:@]+:(\d+)/", line)
        if m and line.startswith("connection.url="):
            ports["dbport"] = int(m.group(1))
    return ports


def shared_maven_repo(cfg: dict) -> Path:
    """The repository the per-slot heads read THROUGH, which is not always `~/.m2/repository`.

    A `<localRepository>` in `~/.m2/settings.xml` moves it, and a tail pointing at a directory maven
    is not using is a tail with nothing in it — every offline build then fails on its first
    dependency. Config wins, then settings.xml, then the default.
    """
    override = (cfg.get("parallel") or {}).get("shared_m2")
    if override:
        return Path(override).expanduser()
    settings = HOME / ".m2/settings.xml"
    try:
        m = re.search(r"<localRepository>\s*([^<]+?)\s*</localRepository>", settings.read_text())
    except OSError:
        m = None
    if m:
        return Path(os.path.expandvars(m.group(1).replace("${user.home}", str(HOME)))).expanduser()
    return SHARED_M2


class Slot:
    """The exclusive resources one concurrent run gets, and how they reach its session.

    Three things are shared by default and each is a way for two runs to corrupt each other:

      * the OpenMRS standalone — one per slot, handed over as `$OPENMRS_STANDALONE_HOME`, which is
        already the first thing the verifier resolves. Without this two verifiers restart one server
        under each other and both grade the wrong deploy.
      * the local maven repository — SPLIT, not replaced: installs go to this slot's own head and
        every read falls through to the shared `~/.m2/repository` behind it, so builds stay offline
        and fast while `chartsearchai-api-1.0.0-SNAPSHOT.jar` stops being one file two runs
        overwrite. That jar is exactly the one `omod` unpacks over `omod/target/classes`, so sharing
        it means run A's classes silently under run B's tests.
      * the working tree — a git worktree per ticket, which is `work_ticket`'s job rather than this
        one's, since it is per ticket and the slot is per worker.

    `CLAUDE_PIPELINE_SLOT` is the session's own notice that it has co-tenants: the skills read it and
    stop doing the things that are correct alone and destructive beside a sibling — killing whatever
    holds a port, taking whichever standalone is idle, restarting the shared inference server.
    """

    def __init__(self, name: str, standalone: Path | None, m2: Path, tail: Path | None = None):
        self.name = name
        self.standalone = standalone
        self.m2 = m2
        self.tail = tail or SHARED_M2
        ports = standalone_ports(standalone) if standalone else {}
        self.tomcatport = ports.get("tomcatport")
        self.dbport = ports.get("dbport")

    def env(self) -> dict[str, str]:
        self.m2.mkdir(parents=True, exist_ok=True)
        env = dict(os.environ)
        env["MAVEN_ARGS"] = (f"-Dmaven.repo.local={self.m2} "
                             f"-Dmaven.repo.local.tail={self.tail}")
        env["CLAUDE_PIPELINE_SLOT"] = self.name
        if self.standalone:
            env["OPENMRS_STANDALONE_HOME"] = str(self.standalone)
        return env

    def describe(self) -> str:
        if not self.standalone:
            return f"{self.name}: no standalone assigned (single-worker run)"
        # parent/name, not name: the instances are commonly several copies of one release, so the
        # basename alone prints two identical-looking slots and the log stops saying which is which.
        where = f"{self.standalone.parent.name}/{self.standalone.name}"
        return (f"{self.name}: {where} "
                f"(tomcat {self.tomcatport}, db {self.dbport}) · m2 {self.m2.name}")


def build_slots(cfg: dict, workers: int, root: Path | None = None) -> list[Slot]:
    """One slot per worker. Standalones are taken in configured order, so a slot keeps its instance
    across waves — which keeps its database warm and makes a run's log say which server it used."""
    root = root or SLOT_M2
    tail = shared_maven_repo(cfg)
    homes = [Path(x).expanduser() for x in cfg["parallel"].get("standalones") or []]
    slots = []
    for i in range(workers):
        name = f"slot-{i + 1}"
        slots.append(Slot(name, homes[i] if i < len(homes) else None, root / name, tail))
    return slots


def slot_problems(cfg: dict, workers: int) -> list[str]:
    """Fatal misconfigurations, reported at preflight rather than discovered by two verifiers.

    A single worker needs no standalone CONFIGURED: that is the behaviour that predates slots, it has
    no co-tenant to collide with, and the verifier's own `$OPENMRS_STANDALONE_HOME`-else-search still
    applies. But one that IS configured is still checked, at any width — handing a session an
    `$OPENMRS_STANDALONE_HOME` that does not exist fails later and further away than here.

    Ports are checked per port and not as a pair. Two instances agreeing on tomcat 8081 cannot run at
    once whatever their database ports are, and a pair key quietly passes exactly that case.
    """
    homes = [Path(x).expanduser() for x in cfg["parallel"].get("standalones") or []]
    problems = []
    if workers > 1 and len(homes) < workers:
        problems.append(
            f"{workers} workers but {len(homes)} standalone(s) configured — set "
            f"parallel.standalones to {workers} instances, or lower parallel.max_workers. Two runs "
            "sharing one standalone restart it underneath each other")
    used = homes[:workers]
    seen: dict[tuple[str, int], str] = {}
    for home in used:
        if not (home / "openmrs-standalone.jar").is_file():
            problems.append(f"{home} holds no openmrs-standalone.jar")
            continue
        ports = standalone_ports(home)
        if not ports["tomcatport"]:
            problems.append(f"{home} has no tomcatport in openmrs-runtime.properties")
        if workers <= 1:
            continue
        for which in PORT_KEYS:
            port = ports[which]
            if port is None:
                continue
            if (which, port) in seen:
                problems.append(
                    f"{home.name} and {Path(seen[(which, port)]).name} both bind {which} {port} — "
                    "they cannot run at the same time. Give one of them a different port in its "
                    "openmrs-runtime.properties")
            seen[(which, port)] = str(home)
    return problems


# ────────────────────────────────────────────────────────────── preflight ──


def repo_slug(path: Path) -> str | None:
    got = sh(["git", "-C", str(path), "remote", "get-url", "origin"])
    if got.returncode != 0:
        return None
    url = got.stdout.strip()
    m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?$", url)
    return m.group(1) if m else None


def default_branch(path: Path) -> str:
    got = sh(["git", "-C", str(path), "rev-parse", "--abbrev-ref", "origin/HEAD"])
    if got.returncode == 0 and "/" in got.stdout:
        return got.stdout.strip().split("/", 1)[1]
    for candidate in ("main", "master"):
        if sh(["git", "-C", str(path), "rev-parse", "--verify", f"origin/{candidate}"]).returncode == 0:
            return candidate
    return "main"


def parity_problems(cfg: dict) -> list[str]:
    """Where the LIVE copies and the source repo's mirror disagree.

    Three separate copies of this machinery exist and only one of them is what actually runs: the
    skills under `~/.claude/skills`, the gate scripts registered under `~/.claude/hooks`, and the
    committed mirror in the source repo. `skill-retro` Step 6 is what keeps them in step; this reports
    when they are not. It is a warning before a run and a finding after a retro, and the same
    definition for both on purpose — two copies of a consistency check drift exactly like the thing
    they are checking.
    """
    problems = []
    for installed, shipped in GATE_PAIRS:
        if installed.is_file() and shipped.is_file() and installed.read_bytes() != shipped.read_bytes():
            problems.append(f"{installed.name}: the registered hook differs from the skill's own copy, "
                            "so the gate is running logic the skill no longer describes")
    src = cfg.get("source_repo")
    if not src:
        return problems
    for script in ("pool-run", "pool-watch"):
        mine, mirrored = PIPELINE / script, Path(src).expanduser() / ".claude/pipeline" / script
        if not mirrored.is_file():
            problems.append(f"{script} is not mirrored in the source repo")
        elif mine.is_file() and mirrored.read_bytes() != mine.read_bytes():
            problems.append(f"{script} differs from the source repo — what ran is not what the repo "
                            "records")
    for skill in MIRRORED_SKILLS:
        live, mirror = CLAUDE / "skills" / skill, Path(src).expanduser() / ".claude/skills" / skill
        if not mirror.is_dir():
            problems.append(f"{skill} is not mirrored in the source repo")
            continue
        for f in sorted(live.rglob("*")):
            if f.is_file():
                m = mirror / f.relative_to(live)
                if not m.is_file():
                    problems.append(f"{skill}/{f.relative_to(live)} is not in the source repo")
                elif m.read_bytes() != f.read_bytes():
                    problems.append(f"{skill}/{f.relative_to(live)} differs from the source repo")
    return problems


def preflight(cfg: dict, say: Say, want_label: bool) -> list[str]:
    """Returns a list of fatal problems. Non-fatal ones are said and carried."""
    fatal: list[str] = []

    for tool in ("claude", "gh", "jq", "git"):
        if not shutil.which(tool):
            fatal.append(f"{tool} is not on PATH")
    if shutil.which("gh") and sh(["gh", "auth", "status"]).returncode != 0:
        fatal.append("gh is not authenticated (`gh auth login`)")

    hooks = json.dumps(load_json(SETTINGS, {}).get("hooks", {}))
    for gate in ("pr-harden-gate.sh", "harden-cycle-gate.sh"):
        if gate not in hooks:
            fatal.append(
                f"{gate} is not registered as a Stop hook in ~/.claude/settings.json — without it "
                "the skills' termination contract is prose and an unattended run can stop early"
            )

    for skill in REQUIRED_SKILLS:
        if not (CLAUDE / "skills" / skill / "SKILL.md").is_file():
            fatal.append(f"skill {skill} is missing from ~/.claude/skills")

    for problem in parity_problems(cfg):
        say(f"  ! {problem}")

    workers = max(1, int(cfg["parallel"]["max_workers"]))
    fatal += slot_problems(cfg, workers)
    if workers > 1:
        # The per-slot maven repository is a SPLIT repository, which Maven only understands from
        # 3.9. Under an older one `maven.repo.local.tail` is ignored, the head repository is empty,
        # and an offline build fails on the first dependency — so this is fatal rather than a
        # warning, and it is checked here rather than discovered by the first `mvn -o` of a run.
        got = sh(["mvn", "-v"])
        m = re.search(r"Apache Maven (\d+)\.(\d+)", got.stdout)
        if not m:
            fatal.append("could not read the maven version, and a parallel run needs >= 3.9 for "
                         "the per-slot split local repository")
        elif (int(m.group(1)), int(m.group(2))) < (3, 9):
            fatal.append(f"maven {m.group(1)}.{m.group(2)} is too old for a parallel run: the "
                         "per-slot `maven.repo.local.tail` needs >= 3.9. Without it the workers "
                         "share ~/.m2 and overwrite each other's module jars")
        tail = shared_maven_repo(cfg)
        if not tail.is_dir():
            fatal.append(f"{tail} does not exist, so there is nothing for the per-slot repositories "
                         "to read through. Set parallel.shared_m2 if your local repository is "
                         "somewhere else")

    if not cfg["repos"]:
        fatal.append("no repos configured in pool.json")
    for slug, path in cfg["repos"].items():
        p = Path(path).expanduser()
        if not (p / ".git").exists():
            fatal.append(f"{path} is not a git checkout (repo {slug})")
            continue
        found = repo_slug(p)
        if found and found.lower() != slug.lower():
            fatal.append(f"{path} has origin {found}, but pool.json files it under {slug}")
        if want_label:
            got = sh(["gh", "label", "list", "--repo", slug, "--limit", "200", "--json", "name"])
            names = [x["name"] for x in load_json_str(got.stdout, [])]
            if got.returncode == 0 and cfg["label"] not in names:
                fatal.append(
                    f"label {cfg['label']!r} does not exist in {slug} — run `pool-run --init` "
                    "to create it, then label the issues you want worked"
                )

    src = cfg.get("source_repo")
    if cfg["retro"]["enabled"]:
        if not src:
            fatal.append("retro is enabled but source_repo is not configured")
        elif not (Path(src).expanduser() / ".git").exists():
            fatal.append(f"source_repo {src} is not a git checkout")

    return fatal


def load_json_str(text: str, default):
    try:
        return json.loads(text)
    except ValueError:
        return default


# ────────────────────────────────────────────────────────────────── queue ──


def open_prs(slug: str) -> list[dict]:
    got = sh(
        ["gh", "pr", "list", "--repo", slug, "--state", "open", "--limit", "100", "--json",
         "number,title,isDraft,headRefName,closingIssuesReferences,url,body,createdAt"]
    )
    return load_json_str(got.stdout, [])


def pr_for_ticket(prs: list[dict], ticket: str, since: int | None = None) -> dict | None:
    """The PR for a ticket, in three descending tiers of how sure the link is.

    Tier 1 is `closingIssuesReferences`, which only a `Fixes` keyword populates. Tier 2 is the ticket
    named in the title or the branch. **Tier 3 is the body, and it is not redundant:** the skill
    writes `Refs #n` instead of `Fixes #n` whenever the PR delivers something short of the ticket —
    an instrument, a diagnosis, one part of several — which is exactly what a careful run produces,
    and that keyword populates no field and may appear nowhere but the body. Its branch naming also
    permits `fix/<slug>` with no number in it, so tiers 1 and 2 can BOTH miss a PR the run really
    opened, and the driver would then report `no-pr` over a finished piece of work.

    Tier 3 needs a bound, because a body is prose and may mention any issue: it counts only for a PR
    created since `since`. So the two callers ask different questions with the same function — "does a
    PR for this ticket already exist?" passes no `since` and gets tiers 1-2 only, because a wrong yes
    there silently drops a ticket from the queue; "did THIS run open one?" passes the run's start and
    can afford the third tier, because recency is what makes it safe.
    """
    num = ticket.lstrip("#")
    digit = num.isdigit()
    named = rf"(?<!\d)#?{num}(?!\d)" if digit else re.escape(num)
    flags = 0 if digit else re.IGNORECASE
    best = None
    for pr in prs:
        tier = 0
        if num in [str(r.get("number")) for r in pr.get("closingIssuesReferences") or []]:
            tier = 3
        elif re.search(named, pr.get("title") or "", flags) or re.search(
                named, pr.get("headRefName") or "", flags):
            tier = 2
        elif since is not None and re.search(named, pr.get("body") or "", flags) and (
                pr_created_at(pr) or 0) >= since:
            tier = 1
        if tier and (best is None or (tier, pr["number"]) > (best[0], best[1]["number"])):
            best = (tier, pr)
    return best[1] if best else None


def pr_created_at(pr: dict) -> int | None:
    try:
        return int(datetime.fromisoformat(pr["createdAt"].replace("Z", "+00:00")).timestamp())
    except (KeyError, TypeError, ValueError):
        return None


def consider(slug: str, path: str, issue: dict, prs: list[dict], ledger: dict, say: Say,
             cfg: dict, forced: bool) -> dict | None:
    """One issue against the skips. `forced` is an operator naming it, which passes every one.

    Shared by both queue paths on purpose: the label path and the named path must agree about what
    "already worked", "already has a PR" and "out of attempts" mean, and two copies of that would
    drift into two answers.
    """
    ticket = str(issue.get("number") or issue.get("key"))
    key = f"{slug}#{ticket}"
    entry = ledger.get(key, {})
    url = issue.get("url") or (
        ticket if not ticket.isdigit() else f"https://github.com/{slug}/issues/{ticket}")

    if not forced:
        if entry.get("status") in DONE or entry.get("status") in NOT_OURS:
            return None
        if entry.get("status") in NEEDS_HUMAN:
            say(f"  - {key}: the run aborted and handed back — one of resolve-ticket's six "
                "conditions, which a second identical attempt cannot get past. Skipping.")
            return None
        # The ledger remembers the PR a previous attempt opened, and that memory beats re-matching
        # prose: an attempt that ended as a draft may have written `Refs` on a branch carrying no
        # number, which tiers 1-2 cannot see — and a second run on such a ticket opens a SECOND PR
        # for one issue.
        known = entry.get("pr")
        existing = next((x for x in prs if x["number"] == known), None) if known else None
        existing = existing or pr_for_ticket(prs, ticket)
        if existing:
            say(f"  - {key}: open PR #{existing['number']} already exists — that is "
                "`pr-harden`'s entry point, not this pipeline's. Skipping.")
            ledger[key] = {**entry, "status": "has-open-pr", "pr": existing["number"],
                           "pr_url": existing.get("url")}
            return None
        attempts = entry.get("attempts", 0)
        if attempts >= cfg["ticket"]["max_attempts"]:
            say(f"  - {key}: {attempts} attempts already, last {entry.get('status')} — "
                "needs a human before another attempt. Skipping.")
            return None

    return {"slug": slug, "path": Path(path).expanduser(), "ticket": ticket, "url": url,
            "title": issue.get("title", ""), "key": key}


def resolve_named(token: str, slug: str) -> dict | None:
    """One operator-named ticket against one repo, or None if that repo does not own it."""
    if token.isdigit():
        got = sh(["gh", "issue", "view", token, "--repo", slug, "--json", "number,title,url"])
        if got.returncode != 0:
            return None
        return load_json_str(got.stdout, {"number": int(token), "title": "", "url": ""})
    return {"key": token, "title": f"JIRA {token}", "url": token}


def build_queue(cfg: dict, ledger: dict, say: Say, named: list[str] | None) -> list[dict]:
    """The queue, either from the label or from tickets the operator named.

    **The named path keeps the operator's ORDER and does not sort.** Order has consequences the
    driver cannot weigh — the retro fires once the record threshold is met, so which tickets run
    first decide what evidence it reads and which ticket is worked by the skills it changed — and
    weighing those means judging the tickets, which is the one thing this driver does not do. So the
    operator's sequence is taken literally, and the label path's ascending issue number stays the
    default for the reason a default should be boring: the same labels give the same order every
    invocation.
    """
    queue: list[dict] = []
    pr_cache: dict[str, list[dict]] = {}

    def prs_for(slug: str) -> list[dict]:
        if slug not in pr_cache:
            pr_cache[slug] = open_prs(slug)
        return pr_cache[slug]

    if named:
        # Tokens in the OUTER loop, so the requested order survives even across several repos.
        for token in named:
            found = False
            for slug, path in cfg["repos"].items():
                issue = resolve_named(token, slug)
                if issue is None:
                    continue
                job = consider(slug, path, issue, prs_for(slug), ledger, say, cfg, forced=True)
                if job:
                    queue.append(job)
                found = True
                break
            if not found:
                say(f"  ! {token}: no configured repo has this issue. Skipping.")
        return queue

    for slug, path in cfg["repos"].items():
        # Enumerate the open issues and filter the label HERE, rather than passing --label.
        # Measured 2026-08-26: three issues labelled through `gh issue edit`, all three confirmed
        # by reading each issue, and `gh issue list --label` returned ONE of them — that filter is
        # search-indexed and the index lagged. It caught up unprompted a minute later. The queue is
        # built once at the start of an invocation, so labelling a ticket and starting the pool
        # loses it for that whole run, silently and fail-closed: no error, no count that looks
        # wrong, just work you queued that nobody does. An issue's own `labels` field is not
        # indexed, so this reads what is true now. It also makes the preflight label check
        # load-bearing rather than a courtesy — a mistyped label now yields an empty queue by the
        # same mechanism a correct one yields a full one.
        got = sh(
            ["gh", "issue", "list", "--repo", slug, "--state", "open",
             "--limit", "200", "--json", "number,title,url,updatedAt,labels"]
        )
        if got.returncode != 0:
            say(f"  ! could not list issues in {slug}: {got.stderr.strip()[:200]}")
            continue
        issues = [i for i in load_json_str(got.stdout, [])
                  if any(l.get("name") == cfg["label"] for l in i.get("labels") or [])]
        for issue in sorted(issues, key=lambda i: i.get("number", 0)):
            job = consider(slug, path, issue, prs_for(slug), ledger, say, cfg, forced=False)
            if job:
                queue.append(job)
    return queue


# ───────────────────────────────────────────────────────── checkout prep ──


# What an operator has to DO about a repository this driver would not start on. The list is shorter
# than it was, and deliberately: the driver no longer checks out, resets or branches the operator's
# own checkout, so "uncommitted work in it" and "its default branch is ahead of origin" stopped being
# reasons to skip anything. It fetches, and it cuts each ticket a worktree from `origin/<default>`.
# That removed the pool's own worst case — one dirty checkout skipping every remaining ticket.
PREPARE_REMEDY = {
    "checkout-blocked": "Nothing was touched. The repository could not be fetched or its default "
                        "branch could not be resolved on origin (the line above says which); fix "
                        "that, then re-run.",
    "worktree-blocked": "Nothing was touched. A previous run left uncommitted work in that worktree. "
                        "Read it, then `git worktree remove --force <path>` to release the ticket.",
}


def prepare_repo(path: Path, say) -> tuple[str | None, str, str]:
    """`(None, where, base sha)` when the repository can be worked, else `(status, why, "")`.

    It returns the sha it resolved rather than leaving the caller to resolve it again. Two
    resolutions of "what are we cutting from" is two answers waiting to differ, and the second one
    would be the one every worktree actually used.

    This used to be `prepare_checkout`, and it used to CHECK OUT: it refused a dirty tree, switched
    to the default branch and fast-forwarded it, so every ticket for a repo took turns in one working
    tree and a single uncommitted file stalled the whole pool. Tickets now get a worktree each, cut
    straight from `origin/<default>`, so none of the local state matters and none of it is touched.
    What is left is the one thing that does matter: can we fetch, and does the remote branch resolve.

    Cutting from the REMOTE ref rather than local HEAD also settles the "ahead of origin" case this
    function used to have to detect. A local unpushed commit can no longer end up inside a ticket's
    PR, because no ticket branch is ever cut from local HEAD.
    """
    fetched = sh(["git", "-C", str(path), "fetch", "origin", "--prune"], timeout=600)
    if fetched.returncode != 0:
        return "checkout-blocked", f"could not fetch origin: {fetched.stderr.strip()[:300]}", ""
    branch = default_branch(path)
    sha = remote_head(path)
    if not sha:
        return "checkout-blocked", f"origin/{branch} does not resolve in {path}", ""
    return None, f"origin/{branch} @ {sha[:8]}", sha


def remote_head(path: Path) -> str:
    """The sha every worktree for this repo is cut from, for this invocation."""
    return sh(["git", "-C", str(path), "rev-parse",
               f"origin/{default_branch(path)}"]).stdout.strip()


# `git worktree add` and `remove` both write `.git/worktrees`, and several workers reach them at
# once. Git takes its own locks per worktree, not over the registration as a whole, so this is ours.
WORKTREE_LOCK = threading.Lock()


def worktree_path(slug: str, ticket: str) -> Path:
    return WORKTREES / f"{slug.replace('/', '-')}-{ticket.lstrip('#')}"


def make_worktree(repo: Path, slug: str, ticket: str, base: str, say) -> tuple[Path | None, str]:
    """One ticket, one working tree, detached at the remote head.

    DETACHED and not on a branch, because the skill cuts its own branch as its first act and git
    refuses to check out one branch in two worktrees — so starting detached is what lets two tickets
    of one repository be in flight at all.

    An existing directory here is a previous run's leftover. If it is clean it is removed and
    recreated, since nothing is in it to lose; if it holds uncommitted work the ticket is REFUSED and
    the path is named, because deleting a killed run's evidence to get past it is the one thing this
    driver must not do quietly. That refusal now costs one ticket rather than the whole pool.
    """
    with WORKTREE_LOCK:
        sh(["git", "-C", str(repo), "worktree", "prune"])
        wt = worktree_path(slug, ticket)
        if wt.exists():
            dropped = drop_worktree(repo, wt, say, locked=True)
            if not dropped.startswith("removed"):
                return None, f"a previous run left work in {wt}: {dropped}"
        wt.parent.mkdir(parents=True, exist_ok=True)
        made = sh(["git", "-C", str(repo), "worktree", "add", "--detach", str(wt), base])
        if made.returncode != 0:
            return None, f"could not create a worktree at {wt}: {made.stderr.strip()[:300]}"
        return wt, f"{wt} @ {base[:8]}"


def drop_worktree(repo: Path, wt: Path, say, force: bool = False, locked: bool = False) -> str:
    """Release a worktree, unless it still holds work nobody has seen.

    Committed work is never at risk here — removing a worktree does not delete the branch it was on,
    and the ticket's branch lives in the shared repository — so the only thing a removal can lose is
    an UNCOMMITTED change, which is exactly what this checks for. A run that pushed its PR leaves a
    clean tree and its directory goes; a run killed mid-edit keeps its directory and says so.
    """
    def release() -> str:
        if not force:
            dirty = sh(["git", "-C", str(wt), "status", "--porcelain"]).stdout.strip()
            if dirty:
                n = len(dirty.splitlines())
                return f"kept: {n} uncommitted change(s) in {wt}"
        gone = sh(["git", "-C", str(repo), "worktree", "remove", "--force", str(wt)])
        if gone.returncode != 0 and wt.exists():
            shutil.rmtree(wt, ignore_errors=True)
            sh(["git", "-C", str(repo), "worktree", "prune"])
        return f"removed {wt}"

    if locked:
        return release()
    with WORKTREE_LOCK:
        return release()


def tenant_key(path: Path) -> str:
    """The key both Stop hooks use for a working tree: its PHYSICAL path.

    The hooks resolve with `pwd -P` and `gate-state` with `realpath`, so anything here that keys on a
    logical path writes an entry the gate cannot find — and "no entry" is the gate's fail-OPEN case.
    """
    return os.path.realpath(path)


GATE_STATE = PIPELINE / "gate-state"


def gate_state_cmd(*argv: str) -> dict:
    """Every read and write of the gate files goes through `gate-state`, never through load/save here.

    Those two files are shared with LIVE claude sessions, which write them through `gate-state` under
    an exclusive `flock`. A read-modify-write here takes no lock and so is not serialised against
    them, nor against this driver's own ticket threads — and this driver is concurrent by
    construction (`ThreadPoolExecutor`, one worktree per ticket). The lost update resurrects an entry
    a finished run legitimately cleared, which then blocks the next session in that path for six
    hours, or drops another worktree's `awaiting`, which is the unattended death the marker exists to
    prevent. That is verbatim the race `gate-state`'s own docstring says it exists to remove, so the
    fix is to use it rather than to add a second lock here.

    Measured on the pre-fix code (2026-08-27, `pool-run` at 9866a1f, driving its own
    `clear_gate_state` from 20 threads over 20 worktrees, 5 trials): 16, 16, 17, 17 and 17 of the 20
    entries SURVIVED a clear that removed all 20, and 56 threads died of `FileNotFoundError` racing
    the shared `.tmp` path. Nothing in the driver noticed either. Every survivor blocks the next
    session in that worktree for six hours.

    Returns {} on any failure — a missing helper, a non-zero exit, unparseable output. The caller
    then reports nothing and clears nothing, which is the safe direction: racing the files is worse
    than leaving a leftover for `STALE_AFTER` to expire.
    """
    if not GATE_STATE.exists():
        return {}
    try:
        r = subprocess.run([str(GATE_STATE), *argv], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return {}
    if r.returncode != 0:
        return {}
    try:
        return json.loads(r.stdout or "{}")
    except ValueError:
        return {}


def clear_gate_state(path: Path, say) -> list[str]:
    """A crashed run leaves an entry that blocks turns in this working tree for up to 6 hours.

    The next run writes its own entry at its Step 1, so removing a leftover is not a loophole — but
    it IS evidence about the run that left it, so it is reported rather than quietly dropped. The
    report comes back FROM the clear, in one locked operation: reading it first and clearing it second
    would be two, and the gap between them is the race described on `gate_state_cmd`.
    """
    removed = gate_state_cmd("--cwd", str(path), "clear", "--json")
    names = {"pr": PR_STATE.name, "harden": HARDEN_STATE.name}
    cleared = [
        f"{names[w]}: phase={e.get('phase')} blocking={e.get('blocking')} "
        f"edits={e.get('edits')} pr={e.get('pr')} round={e.get('round')}"
        for w, e in sorted(removed.items()) if e
    ]
    for line in cleared:
        say(f"    cleared leftover gate state — {line}")
    return cleared


def read_gate_state(path: Path) -> dict:
    return gate_state_cmd("--cwd", str(path), "show", "--json").get("pr", {})


UNATTENDED_DIR = PIPELINE / "unattended"


def unattended_marker_path(path: Path) -> Path:
    return UNATTENDED_DIR / (tenant_key(path).replace("/", "_").lstrip("_") + ".json")


@contextlib.contextmanager
def unattended_marker(path: Path):
    """Tell the Stop-hook gate that this working tree is being driven with no human on the other end.

    The gate cannot read this off the state ENTRY, because the skill rewrites that entry as its own
    Step 1 and would drop any field we seeded there — silently, and fail-open straight back into the
    defect this marker exists to close. So it is a file, and it carries our pid: a driver killed with
    SIGKILL leaves the marker behind, and a stale marker whose owner is gone must not make an
    interactive session in this tree unattended.

    With several tickets in flight there is one marker per worktree and they all carry the SAME pid,
    the driver's. That is correct: the hook asks whether the marker's pid is an ANCESTOR of the
    session asking, and the driver is the ancestor of all of them, so each session is unattended in
    its own tree and none of them is foreign to another's.
    """
    UNATTENDED_DIR.mkdir(parents=True, exist_ok=True)
    marker = unattended_marker_path(path)
    marker.write_text(json.dumps({"pid": os.getpid(), "cwd": tenant_key(path), "since": now()}))
    try:
        yield marker
    finally:
        marker.unlink(missing_ok=True)


# ──────────────────────────────────────────────────────────────── session ──


class Session:
    """One headless `claude -p` run, streamed to a .jsonl and watched for death."""

    def __init__(self, prompt: str, cwd: Path, cfg: dict, log_stem: Path, timeout: int,
                 quiet: int, say, env: dict | None = None):
        self.prompt, self.cwd, self.cfg = prompt, cwd, cfg
        # The slot's environment, or this process's. Everything a run must not share with a sibling
        # travels here rather than in the prompt: the skills read it, and a pipeline instruction
        # bolted onto the prompt would be governance no retro can see.
        self.env = env or dict(os.environ)
        self.jsonl = log_stem.with_suffix(".jsonl")
        self.err = log_stem.with_suffix(".err")
        self.timeout, self.quiet, self.say = timeout, quiet, say
        self.session_id = str(uuid.uuid4())
        self.killed_for = None
        self.turns = 0
        self.last_tool = ""
        self.result = {}

    def argv(self) -> list[str]:
        c = self.cfg["claude"]
        argv = [c.get("binary") or "claude",
                "-p", self.prompt, "--output-format", "stream-json", "--verbose",
                "--dangerously-skip-permissions", "--session-id", self.session_id]
        if c.get("model"):
            argv += ["--model", c["model"]]
        if c.get("effort"):
            argv += ["--effort", c["effort"]]
        if c.get("max_budget_usd"):
            argv += ["--max-budget-usd", str(c["max_budget_usd"])]
        argv += list(c.get("extra_args") or [])
        return argv

    def run(self) -> dict:
        started = now()
        with open(self.jsonl, "w") as out, open(self.err, "w") as errf:
            proc = subprocess.Popen(
                self.argv(), cwd=str(self.cwd), stdout=subprocess.PIPE, stderr=errf,
                text=True, bufsize=1, start_new_session=True, env=self.env,
            )
            last_line = [now()]
            live_add(proc)

            def kill(why: str) -> None:
                self.killed_for = why
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
                    time.sleep(20)
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
                except OSError:
                    pass

            def watchdog() -> None:
                while proc.poll() is None:
                    time.sleep(15)
                    if now() - started > self.timeout:
                        return kill(f"exceeded the ticket timeout of {hms(self.timeout)}")
                    if now() - last_line[0] > self.quiet:
                        return kill(f"produced nothing for {hms(self.quiet)}")

            threading.Thread(target=watchdog, daemon=True).start()
            last_report = now()
            for line in proc.stdout:
                out.write(line)
                out.flush()
                last_line[0] = now()
                self._absorb(line)
                if now() - last_report >= 300:
                    last_report = now()
                    self.say(f"    … {hms(now() - started)} · {self.turns} turns"
                             + (f" · last: {self.last_tool}" if self.last_tool else ""))
            code = proc.wait()
            live_drop(proc)

        return {"exit": code, "seconds": now() - started, "session_id": self.session_id,
                "killed_for": self.killed_for, "turns": self.turns, "jsonl": str(self.jsonl),
                "cost_usd": self.result.get("total_cost_usd"),
                "is_error": bool(self.result.get("is_error")) or code != 0,
                "summary": (self.result.get("result") or "")[-1200:]}

    def _absorb(self, line: str) -> None:
        try:
            event = json.loads(line)
        except ValueError:
            return
        kind = event.get("type")
        if kind == "assistant":
            self.turns += 1
            for block in event.get("message", {}).get("content", []) or []:
                if block.get("type") == "tool_use":
                    name = block.get("name", "")
                    arg = block.get("input", {}) or {}
                    detail = arg.get("command") or arg.get("prompt") or arg.get("skill") or ""
                    self.last_tool = f"{name}({str(detail)[:60]})" if detail else name
        elif kind == "result":
            self.result = event


# ─────────────────────────────────────────────────────── record  capture ──


DRIVER_HEADER = "## Driver capture (pool-run)"


def lesson_files() -> dict[Path, float]:
    if not LESSONS.is_dir():
        return {}
    return {p: p.stat().st_mtime for p in LESSONS.glob("*.md") if p.name != "REJECTED.md"}


def record_written(before: dict[Path, float], ticket: str | None = None,
                   others: set[str] | None = None) -> Path | None:
    """The record file this run created or appended to, if any.

    The `ticket` and `others` arguments are what make this safe with several runs in flight. A
    snapshot taken before run A starts cannot contain a record run B writes WHILE A is running, so
    the naive "newest fresh file" answer hands A a record B wrote — and that record is then quoted in
    A's ledger entry, appended to with A's driver capture, and read by the retro as evidence about
    the wrong ticket. Nothing errors; the evidence is just wrong.

    So: the skills name a record `<date>-<repo>-<ticket>.md`, and a fresh file carrying THIS ticket's
    number is taken first. Failing that — a run may name a record for the lesson rather than the
    ticket — a fresh file is accepted only if it does not carry a CONCURRENT ticket's number, which
    is the case where attributing it here would be attributing it away from its owner.
    """
    after = lesson_files()
    fresh = [p for p, m in after.items() if before.get(p) != m]
    if not fresh:
        return None
    if ticket:
        num = ticket.lstrip("#")
        mine = [p for p in fresh if re.search(rf"[-_]{re.escape(num)}(-driver)?$", p.stem)]
        if mine:
            return sorted(mine, key=lambda p: after[p])[-1]
    for num in sorted(others or ()):
        fresh = [p for p in fresh
                 if not re.search(rf"[-_]{re.escape(num)}(-driver)?$", p.stem)]
    return sorted(fresh, key=lambda p: after[p])[-1] if fresh else None


# The ledger is one dict and one file, mutated by every worker. Read-modify-write it under this.
LEDGER_LOCK = threading.Lock()


def write_ledger(ledger: dict, key: str, entry: dict) -> None:
    with LEDGER_LOCK:
        ledger[key] = entry
        save_json(LEDGER, ledger)


def record_says_aborted(record: Path | None) -> bool:
    """Whether the run reported one of `resolve-ticket`'s abort conditions.

    This is the ONE place the driver reads the run's own account of itself, and it is bounded twice.
    It is consulted only where the driver's own evidence — a PR, or the absence of one — cannot tell a
    deliberate hand-back from a crash, since both leave no PR. And it can only make the driver do
    LESS: the ticket waits for a human instead of being retried. A crashed run that mislabelled itself
    therefore costs an attempt nobody spends, never a wrong PR.
    """
    if not record:
        return False
    for line in record.read_text().splitlines()[:12]:
        if line.lower().startswith("outcome:") and "abort" in line.lower():
            return True
    return False


def capture_record(slug: str, ticket: str, outcome: str, run: dict, gate: dict, cleared: list[str],
                   own: Path | None, say) -> Path | None:
    """Write, or append to, the run record — but only with what the driver itself observed.

    A run that dies cannot write its own record, and the death is exactly the kind of evidence a
    retro needs. So: no record from the run -> write one, marked as driver capture, whose middle
    sections are absent and which says they are absent rather than empty. A record plus something the run could
    not have known (it was killed, it exited non-zero, it left the gate wedged) -> append that.
    Nothing to add -> touch nothing, because a record the run wrote is the better artifact.
    """
    # `own` is resolved by the caller, which is the only place that knows which fresh record files
    # belong to THIS ticket rather than to a sibling running beside it.
    notes = []
    if run.get("killed_for"):
        notes.append(f"the driver killed this session: it {run['killed_for']}")
    if run.get("exit") not in (0, None) and not run.get("killed_for"):
        notes.append(f"`claude -p` exited {run['exit']} (see {Path(run['jsonl']).with_suffix('.err')})")
    # A converged run leaves its entry behind with blocking 0 — that is the normal end state, not
    # evidence, and noting it would append a line to every clean record. Only an entry that says the
    # run did NOT finish is worth carrying: a pre-terminal phase, findings still outstanding, or the
    # labelled override, which is the skill's own record of a deviation.
    unfinished = gate.get("override") or gate.get("phase") in ("building", "init", "fixing") or (
        gate.get("blocking") or 0) > 0
    if gate and unfinished:
        notes.append(
            f"the run left its gate entry unfinished: phase={gate.get('phase')} "
            f"blocking={gate.get('blocking')} round={gate.get('round')} override={gate.get('override')}"
        )
    for line in cleared:
        notes.append(f"this run started on a checkout whose gate state a previous run left behind — {line}")

    body = "\n".join(f"- {n}" for n in notes) or "- nothing the run could not observe itself."
    stamp = (f"{DRIVER_HEADER}\n"
             f"outcome as the driver measured it: {outcome}\n"
             f"session: {run.get('session_id')} · {hms(run.get('seconds', 0))} · "
             f"{run.get('turns')} assistant turns · stream: {run.get('jsonl')}\n"
             f"{body}\n")

    if own:
        if notes:
            with open(own, "a") as f:
                f.write("\n" + stamp)
            say(f"    appended driver capture to {own.name}")
        return own

    LESSONS.mkdir(parents=True, exist_ok=True)
    path = LESSONS / f"{utc_date()}-{slug.split('/')[-1]}-{ticket}-driver.md"
    path.write_text(
        f"# pool-run · {slug} · {ticket} · {utc_date()}\n"
        f"outcome: {outcome}\n"
        f"rounds: unknown   cycles: unknown   verifier: unknown\n"
        f"context: not surfaced\n"
        f"transcript: ~/.claude/projects/<cwd-slug>/{run.get('session_id')}.jsonl\n\n"
        "**This record was written by the pool driver, not by the run.** The run ended without "
        "writing one, so the four sections a retro reads for signal — refuted by measurement, raised "
        "by a fresh agent, where a skill blocked the run, declined — are ABSENT rather than empty: "
        "nobody observed them. Corroborate nothing from this file except what it states below. What "
        "it is evidence of is that a run ended this way at all.\n\n"
        f"{stamp}")
    say(f"    wrote driver capture {path.name} (the run left no record of its own)")
    return path


# ───────────────────────────────────────────────────────────────── ticket ──


def work_ticket(job: dict, slot: Slot, cfg: dict, ledger: dict, say_all: Say,
                bases: dict[str, str], siblings: set[str] | None = None) -> str:
    """One ticket, in its own worktree, on its own slot. Safe to call from several threads.

    Everything this touches is either per ticket (the worktree, the gate-state entry keyed on it, the
    unattended marker, the log stem) or per slot (the standalone, the maven repository) or guarded
    (the ledger, the operator's log). Nothing is shared and unguarded, which is the whole of what
    "ready to run in parallel" means here.

    `siblings` is every OTHER ticket in this wave — the whole wave, fixed before it starts, and not a
    live view of what is running. The live view is wrong in one direction that matters: a sibling that
    FINISHES first leaves the set, so the record it just wrote stops being excluded and the last run
    standing can attribute it to itself. The wave is the right unit because a wave is a barrier: no
    other ticket can have written a record while this one ran.
    """
    key, repo, ticket = job["key"], job["path"], job["ticket"]
    say = say_all.for_ticket(f"[{key}]")
    say_all("")
    say_all(f"── {key}  {job['title'][:80]}   ({slot.name})")

    wt, why = make_worktree(repo, job["slug"], ticket, bases[str(repo)], say)
    if wt is None:
        say(f"skipped: {why}")
        say(f"{PREPARE_REMEDY['worktree-blocked']}")
        # Nothing ran, so there is nothing to have failed twice: no attempt is spent.
        write_ledger(ledger, key, {**ledger.get(key, {}), "status": "worktree-blocked",
                                   "note": why[:500],
                                   "last_run": datetime.now(timezone.utc).isoformat()})
        return "worktree-blocked"
    say(f"worktree: {wt.name} @ {bases[str(repo)][:8]}  ·  {slot.describe()}")
    cleared = clear_gate_state(wt, say)
    # Mark it running BEFORE the session starts. Two reasons, and the second is the load-bearing one:
    # `--status` during a parallel run would otherwise show each in-flight ticket's PREVIOUS outcome,
    # and the wave's crash handler needs to be able to tell "this worker died before recording
    # anything" from "it recorded an outcome and then died" — without that it overwrites a complete
    # entry, PR number and all, with a bare error.
    write_ledger(ledger, key, {**ledger.get(key, {}), "status": "running", "slot": slot.name,
                               "worktree": str(wt),
                               "last_run": datetime.now(timezone.utc).isoformat()})

    before = lesson_files()
    started_at = now()
    stem = LOGS / f"{utc_stamp()}-{key.replace('/', '_').replace('#', '-')}"
    say(f"running /resolve-ticket {job['url']}")
    with unattended_marker(wt):
        run = Session(f"/resolve-ticket {job['url']}", wt, cfg, stem,
                      cfg["ticket"]["timeout_seconds"], cfg["ticket"]["quiet_seconds"], say,
                      env=slot.env()).run()

    # Outcome from evidence, never from the session's own closing prose.
    gate = read_gate_state(wt)
    pr = pr_for_ticket(open_prs(job["slug"]), ticket, since=started_at)
    own_record = record_written(before, ticket, siblings)

    if run.get("killed_for"):
        status = "timeout"
    elif pr and not pr.get("isDraft"):
        status = "ready"
    elif pr:
        status = "draft"
    elif run["is_error"]:
        status = "error"
    else:
        status = "no-pr"
    if status in ("no-pr", "error") and record_says_aborted(own_record):
        status = "aborted"
    # Ended with an agent still outstanding. Distinct from no-pr because the cause is known and is
    # not the run's judgement: it yielded, and an unattended run has no next turn to yield into.
    if status == "no-pr" and (gate.get("awaiting") or []):
        status = "died-yielding"

    flags = []
    if status == "ready" and gate and not (gate.get("phase") == "reviewed" and gate.get("blocking") == 0):
        flags.append(f"PR is ready but the gate entry says phase={gate.get('phase')} "
                     f"blocking={gate.get('blocking')} — one of the two is wrong; read the round log")
    if status == "ready" and gate.get("override"):
        flags.append("the run took the labelled override — read its reason in the state entry")

    record = capture_record(job["slug"], ticket, status, run, gate, cleared, own_record, say)
    for f in flags:
        say(f"! {f}")

    # The worktree goes only if the run left nothing uncommitted in it. Its BRANCH survives either
    # way — removing a worktree does not delete a ref — so what a removal can cost is only work the
    # run never committed, and that is exactly what is worth keeping to look at.
    released = drop_worktree(repo, wt, say)
    if not released.startswith("removed"):
        say(f"! {released}")
        flags.append(released)
    # The entry stays behind otherwise: this worktree is gone, and a leftover keyed on a path that no
    # longer exists is 6 hours of a gate the next run in that path cannot see past.
    if released.startswith("removed"):
        clear_gate_state(wt, say)

    entry = ledger.get(key, {})
    write_ledger(ledger, key, {
        **entry,
        "status": status,
        "attempts": entry.get("attempts", 0) + 1,
        "pr": pr["number"] if pr else None,
        "pr_url": pr.get("url") if pr else None,
        "last_run": datetime.now(timezone.utc).isoformat(),
        "duration_s": run["seconds"],
        "turns": run["turns"],
        "cost_usd": run.get("cost_usd"),
        "session_id": run["session_id"],
        "stream": run["jsonl"],
        "record": str(record) if record else None,
        "slot": slot.name,
        "standalone": str(slot.standalone) if slot.standalone else None,
        "worktree": str(wt),
        "worktree_release": released,
        "flags": flags,
        "killed_for": run.get("killed_for"),
    })

    verdict = {"ready": f"PR #{pr['number'] if pr else '?'} marked ready for review",
               "draft": f"PR #{pr['number'] if pr else '?'} left as a DRAFT — the loop did not converge",
               "timeout": f"killed — {run.get('killed_for')}",
               "error": "the session errored and opened no PR",
               "no-pr": "ended with no PR — read the run's own report in the stream",
               "died-yielding": ("ended while still awaiting a background agent — it yielded, and an "
                                 "unattended run has no next turn; see the gate entry's awaiting list"),
               "aborted": "the run aborted and handed back — it will not be retried"}[status]
    say(f"{status}: {verdict}  ({hms(run['seconds'])}, {run['turns']} turns"
        + (f", ${run['cost_usd']:.2f}" if run.get("cost_usd") else "") + ")")
    return status


# ─────────────────────────────────────────────────────────────── scheduling ──


def plan_waves(queue: list, width: int) -> list[list]:
    """The queue, cut into waves of at most `width` tickets.

    WAVES rather than a rolling pool, and the reason is the retro. `skill-retro` rewrites the skills,
    and the pipeline's guarantee is that a run started after it reads what it changed — which needs a
    moment when nothing is in flight. A rolling pool never has one. A wave boundary is that moment,
    bought at the cost of the width's slowest ticket, and it keeps the forecast honest: "the retro
    fires after wave 2" is a statement an operator can act on before spending anything.
    """
    width = max(1, int(width))
    return [queue[i:i + width] for i in range(0, len(queue), width)]


def reap_running(ledger: dict, say: Say) -> list[str]:
    """Close out tickets a previous driver left marked `running`.

    Sound because of the lock: this runs having just taken the one machine-wide pool lock, so no
    other driver is alive, so nothing can still be running. An entry that says otherwise belongs to a
    driver that was killed outright — SIGKILL, a closed terminal, a reboot — which is precisely the
    death that leaves no record of itself, and leaving it as `running` reports a live run forever.

    It spends the attempt. A session did start and did cost real tokens, and a ticket whose driver
    keeps being killed would otherwise be retried without limit.
    """
    reaped = []
    for key, entry in sorted(ledger.items()):
        if entry.get("status") != "running":
            continue
        entry["status"] = "error"
        entry["attempts"] = entry.get("attempts", 0) + 1
        entry["flags"] = list(entry.get("flags") or []) + [
            "a previous pool driver was killed while this ticket was running; no outcome was ever "
            "recorded for it"]
        reaped.append(f"{key} (started {str(entry.get('last_run'))[:19]})")
    if reaped:
        save_json(LEDGER, ledger)
        for line in reaped:
            say(f"  ! a previous driver died mid-ticket: {line}")
    return reaped


def crash_entry(ledger: dict, key: str, exc: BaseException) -> str:
    """Record a worker that raised, WITHOUT overwriting an outcome it had already recorded.

    `work_ticket` writes its full entry — pr, session, cost, record — and only then formats the line
    it prints. A handler that replaced the entry wholesale would throw all of that away for a crash
    in the last few statements, and the ledger is the only place some of it exists. So the crash is
    always appended as a flag, and the STATUS is forced to `error` only when the entry is still the
    `running` sentinel, i.e. nothing was recorded for this attempt.
    """
    with LEDGER_LOCK:
        entry = dict(ledger.get(key, {}))
        entry["flags"] = list(entry.get("flags") or []) + [
            f"the driver's own worker raised {type(exc).__name__}: {exc}"[:500]]
        if entry.get("status") in (None, "running"):
            entry["status"] = "error"
            entry["attempts"] = entry.get("attempts", 0) + 1
        entry["last_run"] = datetime.now(timezone.utc).isoformat()
        ledger[key] = entry
        save_json(LEDGER, ledger)
        return entry["status"]


def run_wave(jobs: list[dict], slots: list[Slot], cfg: dict, ledger: dict, say: Say,
             bases: dict[str, str]) -> list[tuple[str, str]]:
    """One wave: every ticket in it at once, one slot each, and nothing returns until all have."""
    members = {j["ticket"].lstrip("#") for j in jobs}

    def others(job: dict) -> set[str]:
        return members - {job["ticket"].lstrip("#")}

    if len(jobs) == 1:
        return [(jobs[0]["key"],
                 work_ticket(jobs[0], slots[0], cfg, ledger, say, bases, others(jobs[0])))]
    results: list[tuple[str, str]] = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(jobs)) as pool_exec:
        futures = {
            pool_exec.submit(work_ticket, job, slots[i], cfg, ledger, say, bases, others(job)): job
            for i, job in enumerate(jobs)
        }
        for future in concurrent.futures.as_completed(futures):
            job = futures[future]
            try:
                results.append((job["key"], future.result()))
            except Exception as exc:  # a worker that dies must not take the wave with it
                say(f"[{job['key']}] ! the worker itself raised {type(exc).__name__}: {exc}")
                results.append((job["key"], crash_entry(ledger, job["key"], exc)))
    return results


# ────────────────────────────────────────────────────────────────── retro ──


def un_retroed() -> list[Path]:
    """Records newer than the retro's own LAST marker. Mtime, not the date in the filename: two
    records written on the retro's own day sit either side of it and a date cannot tell which."""
    files = lesson_files()
    if not LAST.exists():
        return sorted(files)
    cut = LAST.stat().st_mtime
    return sorted(p for p, m in files.items() if m > cut)


# Set when a retro leaves LAST where it was. The threshold is computed from LAST, so without this
# every remaining ticket in the invocation would trigger another retro over the same records.
RETRO_STOPPED: dict = {"why": None}


def run_retro(cfg: dict, say: Say, force: bool) -> dict | None:
    if not cfg["retro"]["enabled"]:
        return None
    if RETRO_STOPPED["why"] and not force:
        say(f"    retro: not run — {RETRO_STOPPED['why']}")
        return None
    pending = un_retroed()
    need = cfg["retro"]["min_records"]
    if not force and len(pending) < need:
        say(f"    retro: {len(pending)} un-retroed record(s), threshold {need} — not yet. "
            "One record cannot corroborate a lesson, which is the skill's own rule.")
        return None

    src = Path(cfg["source_repo"]).expanduser()
    say("")
    say(f"── retro over {len(pending)} record(s): {', '.join(p.name for p in pending) or 'all'}")
    dirty = sh(["git", "-C", str(src), "status", "--porcelain"]).stdout.strip()
    if dirty:
        say(f"    skipped: {src} has uncommitted changes, and the retro's last step is a commit "
            "there. Clean it and re-run.")
        return {"status": "skipped-dirty"}
    sh(["git", "-C", str(src), "fetch", "origin", "--prune"], timeout=600)
    branch = default_branch(src)
    sh(["git", "-C", str(src), "checkout", branch])
    sh(["git", "-C", str(src), "merge", "--ff-only", f"origin/{branch}"])
    before_head = sh(["git", "-C", str(src), "rev-parse", "HEAD"]).stdout.strip()
    before_last = LAST.stat().st_mtime if LAST.exists() else 0

    stem = LOGS / f"{utc_stamp()}-retro"
    run = Session("/skill-retro", src, cfg, stem, cfg["retro"]["timeout_seconds"],
                  cfg["ticket"]["quiet_seconds"], say).run()

    after_head = sh(["git", "-C", str(src), "rev-parse", "HEAD"]).stdout.strip()
    ahead = sh(["git", "-C", str(src), "status", "-sb"]).stdout.splitlines()[:1]
    problems = []
    if run.get("killed_for"):
        problems.append(f"killed — {run['killed_for']}")
    if after_head == before_head:
        problems.append("no commit landed in the source repo. The skill commits even when it "
                        "applies nothing, because the records and the parked counts are its output")
    if (LAST.stat().st_mtime if LAST.exists() else 0) <= before_last:
        problems.append("LAST was not advanced, so the next retro will re-read these same records")
        RETRO_STOPPED["why"] = ("the last retro did not advance LAST, so the threshold still counts "
                                "the same records — retros are off for the rest of this run")
    if ahead and "ahead" in ahead[0]:
        problems.append(f"the commit was not pushed ({ahead[0].strip()})")
    problems += parity_problems(cfg)

    say(f"    retro finished in {hms(run['seconds'])}, {run['turns']} turns"
        + (f", ${run['cost_usd']:.2f}" if run.get("cost_usd") else ""))
    if after_head != before_head:
        say("    " + sh(["git", "-C", str(src), "log", "-1", "--oneline"]).stdout.strip())
    for p in problems:
        say(f"    ! {p}")
    if not problems:
        say("    verified: committed, pushed, LAST advanced, live copies and the mirror identical.")
    return {"status": "problems" if problems else "ok", "problems": problems,
            "records": [p.name for p in pending], "commit": after_head,
            "seconds": run["seconds"], "stream": run["jsonl"]}


def retro_forecast(count: int, pending: int, cfg: dict) -> dict[int, list[str]]:
    """Which WAVE a retro will follow, and which wave is the first to read what it changed.

    Keyed on the wave and not the ticket, because that is where the retro can actually run: it
    rewrites the skills, and a run already in flight has read the old ones. With one worker a wave is
    one ticket and this is the mark it always printed.

    A FORECAST, not a fact. It assumes each run leaves exactly one record — which holds on the normal
    path, since the driver writes one when a run does not — and that each retro advances `LAST`. A
    retro that does not turns retros off for the rest of the invocation, and then no mark after that
    point happens at all.

    It exists because the order is otherwise an invisible choice with visible consequences: which
    tickets' records the retro reads, and which ticket is worked by the skills it changed. Printing it
    does not make the default order right — it makes it VISIBLE, early enough to reorder with
    `--ticket` before anything has been spent. Deciding the order remains the operator's, for the
    reason the skill's own Order section gives.
    """
    if not cfg["retro"]["enabled"]:
        return {}
    need = max(1, int(cfg["retro"]["min_records"]))
    width = max(1, int(cfg["parallel"]["max_workers"]))
    waves = plan_waves(list(range(count)), width)
    marks: dict[int, list[str]] = {}
    records = pending
    for i, wave in enumerate(waves, 1):
        records += len(wave)
        if records >= need:
            marks.setdefault(i, []).append("retro fires after this wave")
            records = 0
            if i < len(waves):
                marks.setdefault(i + 1, []).append("first wave reading changed skills")
    return marks


def refresh_outcomes(ledger: dict, say: Say, loud: bool = True) -> int:
    """Record what BECAME of each PR this pipeline opened.

    Everything else here measures the pipeline's own activity — rounds, turns, whether a PR was marked
    ready. None of that says whether the work was any good. The only honest evidence for that is
    downstream and it arrives days later: did the PR merge, was it closed unmerged, did someone push
    commits on top of it. Without this the ledger can only ever report that the machine ran.

    `commits_after_pipeline` is named for exactly what it counts — commits whose `committedDate` is
    after this ticket's run finished — and NOT "human rework", which it is not: a later attempt on the
    same ticket would also land here, and its own `last_run` then moves the boundary. Read it with
    `attempts`. This is deliberately a count of something checkable rather than an inference about who
    did what and why.

    Read-only against GitHub, one `gh pr view` per PR the ledger knows about.
    """
    checked = 0
    for key in sorted(ledger):
        entry = ledger[key]
        pr = entry.get("pr")
        if not pr:
            continue
        slug = key.split("#")[0]
        got = sh(["gh", "pr", "view", str(pr), "--repo", slug, "--json",
                  "state,isDraft,mergedAt,closedAt,url,commits,changedFiles,additions,deletions,"
                  "comments,reviews,reviewDecision"])
        if got.returncode != 0:
            if loud:
                say(f"  ! {key}: could not read PR #{pr}: {got.stderr.strip()[:120]}")
            continue
        pr_json = load_json_str(got.stdout, {})
        since = iso_to_epoch(entry.get("last_run"))
        commits = pr_json.get("commits") or []
        after = sum(1 for c in commits
                    if since and (iso_to_epoch(c.get("committedDate")) or 0) > since)
        entry["outcome"] = {
            "pr_state": pr_json.get("state"),
            "is_draft": pr_json.get("isDraft"),
            "merged_at": pr_json.get("mergedAt"),
            "closed_at": pr_json.get("closedAt"),
            "commits": len(commits),
            "commits_after_pipeline": after,
            "changed_files": pr_json.get("changedFiles"),
            "additions": pr_json.get("additions"),
            "deletions": pr_json.get("deletions"),
            "review_decision": pr_json.get("reviewDecision"),
            "comments": len(pr_json.get("comments") or []),
            "reviews": len(pr_json.get("reviews") or []),
            "checked": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        }
        checked += 1
        if loud:
            o = entry["outcome"]
            say(f"  {key}  PR #{pr} {o['pr_state']}"
                + (" (draft)" if o["is_draft"] else "")
                + f" · {o['commits']} commits, {o['commits_after_pipeline']} after the pipeline"
                + f" · {o['reviews']} review(s), {o['comments']} comment(s)")
    return checked


# ─────────────────────────────────────────────────────────────────── main ──


def cmd_status(cfg: dict, say: Say) -> int:
    ledger = load_json(LEDGER, {})
    if not ledger:
        say("the ledger is empty — nothing has been worked yet.")
    for key, e in sorted(ledger.items()):
        say(f"{key:52s} {e.get('status','?'):13s} attempts={e.get('attempts',0)} "
            f"pr={e.get('pr')} {hms(e.get('duration_s') or 0)} {e.get('last_run','')[:19]}")
        o = e.get("outcome")
        if o:
            say(f"{'':52s} → PR {o.get('pr_state')}"
                + (" (draft)" if o.get("is_draft") else "")
                + f", {o.get('commits_after_pipeline')} commit(s) after the pipeline"
                + f", {o.get('reviews')} review(s), checked {str(o.get('checked'))[:10]}")
        for f in e.get("flags") or []:
            say(f"{'':52s} ! {f}")
    pending = un_retroed()
    say("")
    say(f"un-retroed records: {len(pending)} (threshold {cfg['retro']['min_records']})")
    for p in pending:
        say(f"  {p.name}")
    return 0


def cmd_init(cfg: dict, say: Say) -> int:
    for slug in cfg["repos"]:
        got = sh(["gh", "label", "create", cfg["label"], "--repo", slug, "--color", "5319e7",
                  "--description", "Queued for the unattended resolve-ticket pipeline"])
        say(f"{slug}: {(got.stdout + got.stderr).strip()[:160]}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True, description="work a pool of tickets to reviewed PRs")
    ap.add_argument("--config", default=str(PIPELINE / "pool.json"))
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--limit", type=int, default=0)
    ap.add_argument("--ticket", help="one ticket, or several comma-separated and worked IN THE "
                                     "ORDER GIVEN, past every skip")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--retro-now", action="store_true")
    ap.add_argument("--no-retro", action="store_true")
    ap.add_argument("--workers", type=int, default=0,
                    help="how many tickets to work AT ONCE; overrides parallel.max_workers. Bounded "
                         "by parallel.standalones — one OpenMRS instance per worker")
    ap.add_argument("--init", action="store_true")
    ap.add_argument("--outcomes", action="store_true",
                    help="refresh what became of every PR the ledger knows about, and stop")
    args = ap.parse_args()

    cfg = merge(DEFAULTS, load_json(Path(args.config).expanduser(), {}))
    if args.no_retro:
        cfg["retro"]["enabled"] = False
    if args.workers:
        cfg["parallel"]["max_workers"] = args.workers
    LOGS.mkdir(parents=True, exist_ok=True)
    say = Say(LOGS / f"pool-{utc_stamp()}.md")
    say(f"# pool-run · {datetime.now(timezone.utc).isoformat(timespec='seconds')}")
    say(f"config: {args.config}")

    if args.status:
        return cmd_status(cfg, say)
    if args.init:
        return cmd_init(cfg, say)

    say("")
    say("preflight")
    fatal = preflight(cfg, say, want_label=not (args.ticket or args.retro_now))
    for f in fatal:
        say(f"  x {f}")
    if fatal:
        say("")
        say("Fix the above and re-run. Nothing was started.")
        return 1
    say("  ok")

    # A dry run starts nothing, so it takes no lock and writes no ledger — "nothing was started" has to
    # mean nothing was written either, and the useful moment to preview a queue is often while a batch
    # is already working one. Reads are safe against a live run: every write here is atomic
    # (temp file, then replace), so a concurrent reader sees one version or the other, never a torn one.
    if not args.dry_run and not take_lock(say):
        return 1
    if args.outcomes:
        try:
            led = load_json(LEDGER, {})
            say("")
            say("outcomes")
            n = refresh_outcomes(led, say)
            save_json(LEDGER, led)
            say(f"  ({n} PR(s) checked)")
            return 0
        finally:
            drop_lock()
    stopping = {"flag": False}

    def on_signal(signum, _frame):
        procs = live_procs()
        if stopping["flag"] and procs:
            say(f"\nsignal {signum} again — killing {len(procs)} live session(s) now. Their "
                "branches are left as they are, and any worktree still holding uncommitted work is "
                "kept and named, for you to read before the ticket can be started again.")
            for proc in procs:
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
                except OSError:
                    pass
            return
        stopping["flag"] = True
        say(f"\ncaught signal {signum} — will stop after the current wave finishes "
            f"({len(procs)} session(s) in flight). Signal again to kill them instead.")

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)

    try:
        if args.retro_now:
            run_retro(cfg, say, force=True)
            return 0

        ledger = load_json(LEDGER, {})
        if not args.dry_run:
            reap_running(ledger, say)
        if not args.dry_run and any(e.get("pr") for e in ledger.values()):
            say("")
            say("outcomes of earlier tickets")
            refresh_outcomes(ledger, say)
        say("")
        say("queue")
        named = [t.strip() for t in args.ticket.split(",") if t.strip()] if args.ticket else None
        queue = build_queue(cfg, ledger, say, named)
        if not args.dry_run:
            # build_queue records what it skipped (a ticket whose PR now exists, say). That is a real
            # observation worth keeping — but only when this invocation is going to act on it.
            save_json(LEDGER, ledger)
        if args.limit:
            queue = queue[: args.limit]
        if args.once:
            queue = queue[:1]
        workers = max(1, int(cfg["parallel"]["max_workers"]))
        waves = plan_waves(queue, workers)
        pending = len(un_retroed())
        marks = retro_forecast(len(queue), pending, cfg)
        for n, wave in enumerate(waves, 1):
            prefix = f"  wave {n}: " if workers > 1 else "  "
            for job in wave:
                say(f"{prefix}{job['key']}  {job['title'][:70]}")
                prefix = " " * len(prefix)
            for mark in marks.get(n, []):
                say(f"        \u21b3 {mark}")
        if cfg["retro"]["enabled"]:
            say(f"  ({pending} un-retroed record(s) now, threshold "
                f"{cfg['retro']['min_records']} — the marks above are a forecast, one record per run)")
        else:
            say("  (retro disabled for this invocation)")
        if not queue:
            say(f"  (nothing to work — label an issue {cfg['label']!r} to queue it)")
            return 0
        slots = build_slots(cfg, workers)
        if workers > 1:
            say("")
            say(f"slots ({workers} tickets at once)")
            for slot in slots:
                say(f"  {slot.describe()}")

        # Printed BEFORE the dry-run exits: which standalone a ticket will take is exactly the kind
        # of thing worth previewing, and it is the setting most likely to be wrong the first time.
        if args.dry_run:
            say("")
            say("--dry-run: preflight passed and the queue is above. Nothing was started.")
            return 0

        # One fetch per repository per invocation, here rather than per ticket: every worktree in
        # every wave is cut from the sha resolved now, so the whole invocation works one base and
        # concurrent workers never fetch into one object store at the same time.
        bases: dict[str, str] = {}
        seen: set[str] = set()
        for job in queue:
            repo = str(job["path"])
            if repo in seen:
                continue
            seen.add(repo)
            failure, where, sha = prepare_repo(job["path"], say)
            if failure:
                say(f"  x {job['slug']}: {where.splitlines()[0]}")
                say(f"    {PREPARE_REMEDY[failure]}")
                for blocked in [j for j in queue if str(j["path"]) == repo]:
                    write_ledger(ledger, blocked["key"],
                                 {**ledger.get(blocked["key"], {}), "status": failure,
                                  "note": where[:500],
                                  "last_run": datetime.now(timezone.utc).isoformat()})
                continue
            bases[repo] = sha
            say(f"  {job['slug']}: {where}")
        queue = [j for j in queue if str(j["path"]) in bases]
        waves = plan_waves(queue, workers)
        if not queue:
            say("")
            say("no repository in the queue could be prepared; nothing was started.")
            return 1

        results = []
        for i, wave in enumerate(waves, 1):
            if stopping["flag"]:
                say("stopping as asked; the rest of the queue is untouched.")
                break
            say("")
            say(f"[wave {i}/{len(waves)}]" if workers > 1 else f"[{i}/{len(waves)}]")
            results += run_wave(wave, slots, cfg, ledger, say, bases)
            # The barrier. `skill-retro` rewrites the skills that a run reads, so it runs only when
            # nothing is in flight — which a wave boundary is and a rolling pool never is.
            if not stopping["flag"]:
                run_retro(cfg, say, force=False)

        say("")
        say("## summary")
        for key, status in results:
            e = load_json(LEDGER, {}).get(key, {})
            say(f"  {status:13s} {key:48s} pr={e.get('pr')} {hms(e.get('duration_s') or 0)}")
        needs = [k for k, s in results if s != "ready"]
        if needs:
            say("")
            say("needs a human: " + ", ".join(needs))
        say("")
        say(f"log: {say.path}")
        return 0
    finally:
        drop_lock()


if __name__ == "__main__":
    sys.exit(main())
