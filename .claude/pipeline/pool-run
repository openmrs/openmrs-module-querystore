def cmd_status(cfg: dict, say: Say) -> int:
    ledger = load_json(LEDGER, {})
    if not ledger:
        say("the ledger is empty — nothing has been worked yet.")
    # Read-only, deliberately, and that is why it is `stale_work_rows` and not `active_leases`: the
    # latter deletes the leases it filters out, which is right for a caller about to take a slot and
    # wrong for one that only looks. A row saying `running` days after its session ended is the
    # commonest wrong thing this command has told an operator.
    dead = stale_work_rows(ledger)
    held = leased_tickets()
    for key, e in sorted(ledger.items()):
        since = iso_to_epoch(e.get("last_run"))
        running_for = f", running for {hms(now() - since)}" if since else ""
        if key in dead:
            note = f"  ← {dead[key]}{running_for}"
        elif (e.get("status") == "running" and e.get("launched_by") == "work"
                and key not in held):
            # Weaker and said as such: no lease holds it, which is not the same as proving the
            # session gone. Scoped to `--work` rows because a DRIVER takes no lease at all, and
            # annotating its live tickets with "no live session holds it" would be simply false.
            note = f"  ← no live session holds it{running_for}"
        elif e.get("status") in SUSPENDED and isinstance(e.get("resume_at"), int):
            # The one row `--resume` is not the answer to: the driver comes back to it on its own,
            # unless it died in the wait — which is what the reset time in the past reads as.
            note = (f"  ← {e.get('paused_for') or 'paused'}; resets at "
                    f"{at_clock(e['resume_at'])}"
                    + (" (already past — nothing picked it up)" if e["resume_at"] < now() else ""))
        else:
            note = ""
        say(f"{key:52s} {e.get('status','?'):13s} attempts={e.get('attempts',0)} "
            f"pr={e.get('pr')} {hms(e.get('duration_s') or 0)} {e.get('last_run','')[:19]}{note}")
        o = e.get("outcome")
        if o:
            say(f"{'':52s} → PR {o.get('pr_state')}"
                + (" (draft)" if o.get("is_draft") else "")
                + f", {o.get('commits_after_pipeline')} commit(s) after the pipeline"
                + f", {o.get('reviews')} review(s), checked {str(o.get('checked'))[:10]}")
        for f in e.get("flags") or []:
            say(f"{'':52s} ! {f}")
    plan = read_pause_plan()
    if not plan and any(e.get("status") in SUSPENDED for e in ledger.values()):
        say("")
        say("PAUSED tickets are in the ledger with no resume plan beside them — a driver died after "
            "the pause. `pool-run --resume` continues them anyway.")
    if plan:
        say("")
        say(f"PAUSED {hms(now() - plan.get('at', now()))} ago — `pool-run --resume` continues it")
        for job in plan.get("suspended") or []:
            say(f"  suspended mid-run: {job.get('key')}")
        for job in plan.get("queue") or []:
            say(f"  never started:     {job.get('key')}")
    pending = un_retroed()
    say("")
    say(f"un-retroed records: {len(pending)} (threshold {cfg['retro']['min_records']})")
    for p in pending:
        say(f"  {p.name}")
    return 0


def cmd_pause(cfg: dict, say: Say, immediate: bool) -> int:
    """Ask the running driver to stop. This runs in a SECOND terminal, beside a working pool.

    It takes no lock and writes no ledger, deliberately: the pool it is talking to holds the lock and
    is mid-ticket. All it does is leave the request where the driver's wave loop and every live
    session watchdog already look.

    It refuses when no driver is live, and that refusal is the useful half of the command. A request
    written with nothing to read it sits on disk until the NEXT driver starts, which would then pause
    in its first wave for a reason nobody remembers asking for.
    """
    if not driver_problems():
        say("no pool driver is running, so there is nothing to pause.")
        if read_pause_plan():
            say("a resume plan is already on disk — `pool-run --resume` continues from it.")
        return 1
    ask_pause(immediate)
    if immediate:
        say("asked the running driver to pause NOW.")
        say("Every session in flight is suspended within seconds: SIGTERM to its process group, its "
            "transcript kept under its session id, its worktree kept, its gate state kept, and no "
            "attempt spent. `--resume` re-enters each one with `claude --resume`.")
    else:
        say("asked the running driver to pause at the next ticket boundary.")
        say("The tickets in flight run to their own end first, which can be hours. `--pause --now` "
            "stops them where they are instead, and loses nothing by it.")
    say("`pool-run --resume` picks the pool up from where it stopped.")
    return 0


def cmd_claim(cfg: dict, say: Say, token: str) -> int:
    """Set a hand-launched session up the way the driver sets up a worker, then print how to start it."""
    problems = preflight(cfg, say, want_label=False, driving=False)
    for problem in problems:
        say(f"  x {problem}")
    if problems:
        return 1
    # A `--claim` is a hand-launched start too, and what the skill promises is that a hand-launched
    # START closes out what an earlier one left — not that `--work` specifically does. Before
    # anything is claimed, so nothing here can leak a lease. Guarded for the same reason as there.
    try:
        reap_stale_work(load_json(LEDGER, {}), say)
    except Exception as exc:
        say(f"! could not close out earlier hand-launched rows: {type(exc).__name__}: {exc}")
    for slug, path in cfg["repos"].items():
        issue = resolve_named(token, slug)
        if issue is None:
            continue
        repo = Path(path).expanduser()
        failure, where, base = prepare_repo(repo, say)
        if failure:
            say(f"  x {where}")
            say(f"    {PREPARE_REMEDY[failure]}")
            return 1
        prs = open_prs(slug)
        # The IDENTIFIER from here on, never the operator's raw token: it becomes the lease file's
        # `ticket`, the duplicate-claim comparison against leases already held, the ledger key and
        # the session's log stem, and a URL in any of those makes one ticket look like two. The
        # worktree path guards itself (`worktree_path`), which is why this was invisible until the
        # ledger was read. `ticket_id` is the same reduction `resolve_named` applied a moment ago.
        ident = ticket_id(token)
        existing = pr_for_ticket(prs, ident)
        if existing:
            say(f"  ! #{existing['number']} is already open for this ticket — that is `pr-harden`'s "
                "entry point, not `resolve-ticket`'s. Claiming anyway, since you asked by name.")
        claim = claim_slot(cfg, slug, ident, repo, base, say)
        if not claim:
            return 1
        env = claim["env"]
        say("")
        say(f"slot {claim['slot'].name} is yours for {slug}#{ident} "
            f"({claim['slot'].describe().split(': ', 1)[1]})")
        say("")
        say("Paste this into the terminal you want the session in:")
        say("")
        say(f"cd {claim['worktree']}")
        say(f"export OPENMRS_STANDALONE_HOME={env['OPENMRS_STANDALONE_HOME']}")
        say(f'export MAVEN_ARGS="{env["MAVEN_ARGS"]}"')
        say(f"export CLAUDE_PIPELINE_SLOT={env['CLAUDE_PIPELINE_SLOT']}")
        say("claude")
        say("")
        if existing:
            # The warning above says `pr-harden` owns an open PR, and then this printed
            # `/resolve-ticket` anyway -- so the operator was told one skill and handed the command
            # for the other, twice (#353 and #348, reported in two records). The worktree is detached
            # at the base BY DESIGN (`make_worktree`: git refuses one branch in two worktrees), so
            # something has to bring the head in for `pr-harden` Step 0, which wants the head branch
            # TRACKING the remote. The branch form is printed first because it is the one that
            # satisfies that; the ref form is the fallback for a branch another worktree holds, and
            # it is detached, so it satisfies the checkout and not the tracking.
            say("the PR is open, so bring its head into this worktree first:")
            say(f"git fetch origin {existing['headRefName']} && "
                f"git checkout -B {existing['headRefName']} --track origin/{existing['headRefName']}")
            say(f"  (refused where another worktree holds that branch; then "
                f"git fetch origin pull/{existing['number']}/head && git checkout FETCH_HEAD,")
            say("   and `pr-harden` Step 0's tracking requirement is what you are trading away)")
            say("")
            say(f"then, in that session:   /pr-harden {existing['number']}")
        else:
            say(f"then, in that session:   /resolve-ticket {issue.get('url') or claim['url']}")
        say("")
        say(f"When it is done:         pool-run --release {token.lstrip('#')}")
        return 0
    say(f"  x no configured repo has issue {token}")
    return 1


def cmd_work(cfg: dict, say: Say, token: str) -> int:
    """One command per terminal: `pool-run --work 266`."""
    # `--work` launches an INTERACTIVE Claude Code session, which needs a terminal to draw on and to
    # read keys from. Without this the failure is silent and confusing: the session starts with no
    # tty, renders none of its interface, and there is nothing on screen to say why. It catches the
    # mistake worth catching — running this from INSIDE a Claude Code session, where `pool-run` looks
    # like it ought to be a skill. It is not; skills are what you type inside a session, and this is
    # a shell script that starts one.
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        say("  x --work starts an interactive Claude Code session, so it needs a terminal.")
        say("    Run it in a terminal — not from inside a Claude Code session, a pipe or a script.")
        say(f"    To prepare a session without launching it: pool-run --claim {token}")
        return 1
    problems = preflight(cfg, say, want_label=False, driving=False)
    for problem in problems:
        say(f"  x {problem}")
    if problems:
        return 1
    if os.environ.get("CLAUDE_PIPELINE_SLOT"):
        say(f"  x this terminal is already inside {os.environ['CLAUDE_PIPELINE_SLOT']}. Start the "
            "second ticket from a fresh terminal, not from inside a session.")
        return 1
    for slug, path in cfg["repos"].items():
        issue = resolve_named(token, slug)
        if issue is None:
            continue
        # The IDENTIFIER onward, never the raw token — this is the entry point that produced the
        # defect `ticket_id` documents: `pool-run --work https://github.com/o/r/issues/238` put the
        # whole URL into the lease, the ledger key and the worktree path. `resolve_named` has already
        # reduced it; passing `token` here is what un-reduced it again.
        ident = ticket_id(token)
        existing = pr_for_ticket(open_prs(slug), ident)
        if existing:
            say(f"  ! #{existing['number']} is already open for this ticket — `pr-harden` owns it "
                "from here, not `resolve-ticket`. Starting anyway, since you named it.")
        return work_in_session(cfg, slug, ident, issue, Path(path).expanduser(), say)
    say(f"  x no configured repo has issue {token}")
    return 1


def cmd_release(cfg: dict, say: Say, token: str) -> int:
    return 0 if release_claim(cfg, token, say) else 1


def cmd_claims(cfg: dict, say: Say) -> int:
    held = active_leases()
    if not held:
        say("no slots are claimed; the driver is free to run.")
        return 0
    for name, lease in sorted(held.items()):
        say(f"{name}  #{lease.get('ticket')}  {lease.get('slug')}  "
            f"{Path(lease['standalone']).name if lease.get('standalone') else '(no standalone)'}  "
            f"since {datetime.fromtimestamp(lease.get('since', 0), timezone.utc).isoformat(timespec='minutes')}")
        say(f"{'':6s}  {lease.get('worktree')}")
    say("")
    say("`pool-run --release <ticket>` gives one back. The driver will not start while any is held.")
    return 0


def cmd_init(cfg: dict, say: Say) -> int:
    for slug in cfg["repos"]:
        got = sh(["gh", "label", "create", cfg["label"], "--repo", slug, "--color", "5319e7",
                  "--description", "Queued for the unattended resolve-ticket pipeline"])
        say(f"{slug}: {(got.stdout + got.stderr).strip()[:160]}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True, description="work a pool of tickets to reviewed PRs")
    ap.add_argument("--config", default=str(PIPELINE / "pool.json"))
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--limit", type=int, default=0)
    ap.add_argument("--ticket", help="one ticket, or several comma-separated and worked IN THE "
                                     "ORDER GIVEN, past every skip")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--retro-now", action="store_true")
    ap.add_argument("--no-retro", action="store_true")
    ap.add_argument("--workers", type=int, default=0,
                    help="how many tickets to work AT ONCE; overrides parallel.max_workers. Bounded "
                         "by parallel.standalones — one OpenMRS instance per worker")
    ap.add_argument("--init", action="store_true")
    ap.add_argument("--work", metavar="TICKET",
                    help="work ONE ticket in this terminal: claims a worktree and a standalone, "
                         "starts an ordinary interactive claude in it with /resolve-ticket already "
                         "invoked, and gives the slot back when you are done. One per terminal")
    ap.add_argument("--skip-permissions", action="store_true", default=None,
                    help="with --work: start the session with --dangerously-skip-permissions so it "
                         "runs without stopping to ask. Also settable as claude.skip_permissions")
    ap.add_argument("--no-skip-permissions", dest="skip_permissions", action="store_false",
                    help="with --work: override claude.skip_permissions for this one session")
    ap.add_argument("--remote-control", action="store_true", default=None,
                    help="with --work: start the session with Remote Control enabled, named for the "
                         "ticket, so it can be monitored from a phone. Also settable as "
                         "claude.remote_control in pool.json")
    ap.add_argument("--no-remote-control", dest="remote_control", action="store_false",
                    help="with --work: override claude.remote_control for this one session")
    ap.add_argument("--claim", metavar="TICKET",
                    help="set up a worktree and lease a standalone for a HAND-LAUNCHED session, then "
                         "print the cd and exports to paste before starting `claude`")
    ap.add_argument("--release", metavar="TICKET", help="give a claimed slot back")
    ap.add_argument("--claims", action="store_true", help="list the slots hand-launched sessions hold")
    ap.add_argument("--outcomes", action="store_true",
                    help="refresh what became of every PR the ledger knows about, and stop")
    ap.add_argument("--pause", action="store_true",
                    help="ask the RUNNING driver to stop and leave a resume plan behind. Run this "
                         "from a second terminal; without --now the tickets in flight finish first")
    ap.add_argument("--now", action="store_true",
                    help="with --pause: suspend the sessions in flight too, within seconds, keeping "
                         "each transcript and worktree so --resume can re-enter them")
    ap.add_argument("--resume", action="store_true",
                    help="continue a paused pool from its plan: the suspended sessions first, then "
                         "the queue it had left, in the order it had it")
    args = ap.parse_args()
    if args.now and not args.pause:
        ap.error("--now says HOW to pause; it means nothing without --pause")
    if args.pause and args.resume:
        ap.error("--pause asks a running driver to stop and --resume starts one; pick one")
    if args.resume and args.ticket:
        ap.error("--resume works the queue the pause left, in the order it left it; --ticket names "
                 "a new one. Pick one")

    cfg = merge(DEFAULTS, load_json(Path(args.config).expanduser(), {}))
    if args.no_retro:
        cfg["retro"]["enabled"] = False
    if args.workers:
        cfg["parallel"]["max_workers"] = args.workers
    if args.remote_control is not None:
        cfg["claude"]["remote_control"] = args.remote_control
    if args.skip_permissions is not None:
        cfg["claude"]["skip_permissions"] = args.skip_permissions
    LOGS.mkdir(parents=True, exist_ok=True)
    say = Say(LOGS / f"pool-{utc_stamp()}.md")
    say(f"# pool-run · {datetime.now(timezone.utc).isoformat(timespec='seconds')}")
    say(f"config: {args.config}")

    if args.pause:
        return cmd_pause(cfg, say, args.now)
    if args.status:
        return cmd_status(cfg, say)
    if args.claims:
        return cmd_claims(cfg, say)
    if args.init:
        return cmd_init(cfg, say)
    if args.work:
        return cmd_work(cfg, say, args.work.strip())
    if args.claim:
        return cmd_claim(cfg, say, args.claim.strip())
    if args.release:
        return cmd_release(cfg, say, args.release.strip())

    say("")
    say("preflight")
    # A resume works a queue it already has, so it no more needs the label to exist than a named
    # run does — and refusing to resume because a label was renamed mid-pool would strand the
    # suspended sessions.
    fatal = preflight(cfg, say, want_label=not (args.ticket or args.retro_now or args.resume))
    for f in fatal:
        say(f"  x {f}")
    if fatal:
        say("")
        say("Fix the above and re-run. Nothing was started.")
        # The same argument the all-repositories-blocked exit carries: an expired `gh` token, a lease
        # a killed session left, a gate hook a settings edit dropped — every one of these is an
        # unattended failure, and the invocation is over. Not on a dry run: that is somebody here.
        if not args.dry_run:
            notify(cfg, "finished",
                   f"pool refused to start: {fatal[0]}" + (f" (+{len(fatal) - 1} more)"
                                                           if len(fatal) > 1 else ""),
                   say, needs_human=True, counts={}, needs=[], tickets=0, problems=fatal,
                   log=str(say.path))
        return 1
    say("  ok")

    # A dry run starts nothing, so it takes no lock and writes no ledger — "nothing was started" has to
    # mean nothing was written either, and the useful moment to preview a queue is often while a batch
    # is already working one. Reads are safe against a live run: every write here is atomic
    # (temp file, then replace), so a concurrent reader sees one version or the other, never a torn one.
    if not args.dry_run and not take_lock(say):
        return 1
    # The lock we now hold proves no other driver is alive, so a pause request still on disk was
    # asked of one that is gone. Clearing it here is what stops this run pausing in its first wave
    # for a reason nobody remembers asking for — and `cmd_pause` refuses to write one with no driver
    # to read it, so reaching this is already a sign something died.
    if not args.dry_run:
        stale = pause_requested()
        if stale:
            say(f"clearing a pause request asked {hms(now() - stale.get('asked', now()))} ago — the "
                "driver it was meant for is gone.")
            clear_pause_request()
    if args.outcomes:
        try:
            say("")
            say("outcomes")
            led = load_json(LEDGER, {})
            before = ledger_snapshot(led)
            n = refresh_outcomes(led, say)
            merge_ledger_changes(before, led)
            say(f"  ({n} PR(s) checked)")
            return 0
        finally:
            drop_lock()
    stopping = {"flag": False}

    def on_signal(signum, _frame):
        procs = live_procs()
        if stopping["flag"] and procs:
            say(f"\nsignal {signum} again — killing {len(procs)} live session(s) now. Their "
                "branches are left as they are, and any worktree still holding uncommitted work is "
                "kept and named, for you to read before the ticket can be started again.")
            for proc in procs:
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
                except OSError:
                    pass
            return
        stopping["flag"] = True
        say(f"\ncaught signal {signum} — will stop after the current wave finishes "
            f"({len(procs)} session(s) in flight). Signal again to kill them instead.")

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)

    try:
        if args.retro_now:
            run_retro(cfg, say, force=True)
            return 0

        ledger = load_json(LEDGER, {})
        ledger_before = ledger_snapshot(ledger)
        if not args.dry_run:
            reap_running(ledger, say)
        if not args.dry_run and any(e.get("pr") for e in ledger.values()):
            say("")
            say("outcomes of earlier tickets")
            refresh_outcomes(ledger, say)
        say("")
        say("queue")
        if args.resume:
            plan = read_pause_plan()
            if not (plan.get("queue") or plan.get("suspended")
                    or any(e.get("status") in SUSPENDED for e in ledger.values())):
                say("  nothing is paused — no resume plan on disk, and no ticket the ledger calls "
                    "paused.")
                return 1
            if plan.get("at"):
                say(f"  resuming a pool paused {hms(now() - plan['at'])} ago")
            else:
                say("  no resume plan on disk — resuming what the ledger itself calls paused")
            if plan.get("config") and plan["config"] != args.config:
                say(f"  ! it was paused under {plan['config']} and this is {args.config}. The queue "
                    "carries its own repo paths, but which repos a LEDGER-only pause can be resumed "
                    "into is read from the config in use.")
            # The plan carries the width and the retro setting the paused run was using, so a resume
            # typed with no flags continues on the same terms rather than on the defaults. A flag
            # given HERE still wins: it is this invocation's instruction, and the plan is only a
            # memory of the last one.
            if not args.workers and plan.get("workers"):
                cfg["parallel"]["max_workers"] = int(plan["workers"])
            if plan.get("no_retro"):
                cfg["retro"]["enabled"] = False
            queue = dedupe_queue(resume_jobs(plan, ledger, cfg, say), say)
            # The un-started tail was screened at PAUSE time, and a pause is an invitation to come
            # back much later. Re-screening it through the same predicate a fresh run uses is what
            # stops a resume opening a SECOND PR for a ticket somebody took to one by hand in the
            # meantime — which is `consider`'s own stated reason for existing, and which the plan
            # cannot know about because it was written before it happened. Screened as the PAUSED
            # run would have screened it (`forced`), not as this invocation looks: the operator's
            # `--ticket` decision belongs to the queue, and it is the same queue.
            #
            # A SUSPENDED ticket is deliberately not re-screened. It is mid-attempt with its
            # worktree and session open, the ledger row it would be judged against is its own
            # `paused`, and every skip would fire on it.
            open_by_slug: dict[str, list[dict]] = {}
            screened = []
            for job in queue:
                if job.get("resume"):
                    screened.append(job)
                    continue
                if job["slug"] not in open_by_slug:
                    open_by_slug[job["slug"]] = open_prs(job["slug"])
                token = str(job.get("ticket") or "")
                still = consider(job["slug"], str(job["path"]),
                                 {"number": int(token) if token.isdigit() else None,
                                  "key": token, "title": job.get("title", ""),
                                  "url": job.get("url")},
                                 open_by_slug[job["slug"]], ledger, say, cfg,
                                 forced=bool(plan.get("forced")))
                if still:
                    screened.append(still)
            queue = screened
            # Consumed here rather than at the end: a resume that dies mid-way has already written
            # each ticket's own state, and re-reading a plan whose tickets have moved on would work
            # the queue twice. What survives a death is the ledger, which is where it belongs.
            # Not on a dry run, which starts nothing and must therefore consume nothing — the same
            # rule that keeps it from taking the lock, and `--dry-run --resume` is exactly how you
            # look at what a pause left before committing to it.
            if not args.dry_run:
                clear_pause_plan()
            queue_forced = bool(plan.get("forced"))
        else:
            named = [t.strip() for t in args.ticket.split(",") if t.strip()] if args.ticket else None
            queue = build_queue(cfg, ledger, say, named)
            queue_forced = bool(named)
        if not args.dry_run:
            # build_queue records what it skipped (a ticket whose PR now exists, say). That is a real
            # observation worth keeping — but only when this invocation is going to act on it. Merged
            # by CHANGED key, so a subcommand running beside this one keeps everything it recorded —
            # publishing every key of this snapshot would clobber those just as the whole file did.
            merge_ledger_changes(ledger_before, ledger)
        full_queue = list(queue)
        if args.limit:
            queue = queue[: args.limit]
        if args.once:
            queue = queue[:1]
        workers = max(1, int(cfg["parallel"]["max_workers"]))
        # A resume that is ALSO limited leaves tickets the plan held and this run will not reach.
        # The plan was consumed when it was read, so the remainder is written straight back: for a
        # labelled pool it would be re-found, but a `--ticket` queue is recorded nowhere else, and
        # its ORDER is recorded nowhere else at all.
        if args.resume and not args.dry_run and len(queue) < len(full_queue):
            held = full_queue[len(queue):]
            # Split by what they ARE, not by where they sat. `resume_jobs` puts suspended tickets
            # first, so a limit smaller than their number holds one back — and writing it into the
            # un-started queue would have the next resume work it from scratch, abandoning the very
            # session the pause was taken to keep.
            write_pause_plan(args.config, workers, not cfg["retro"]["enabled"],
                             [j for j in held if not j.get("resume")],
                             [j for j in held if j.get("resume")], say, forced=queue_forced)
            say(f"  ({len(full_queue) - len(queue)} ticket(s) of the paused queue are held back by "
                "--once/--limit and stay in the plan)")
        waves = plan_waves(queue, workers)
        pending = len(un_retroed())
        marks = retro_forecast(len(queue), pending, cfg)
        for n, wave in enumerate(waves, 1):
            prefix = f"  wave {n}: " if workers > 1 else "  "
            for job in wave:
                say(f"{prefix}{job['key']}  {job['title'][:70]}")
                prefix = " " * len(prefix)
            for mark in marks.get(n, []):
                say(f"        \u21b3 {mark}")
        if cfg["retro"]["enabled"]:
            say(f"  ({pending} un-retroed record(s) now, threshold "
                f"{cfg['retro']['min_records']} — the marks above are a forecast, one record per run)")
        else:
            say("  (retro disabled for this invocation)")
        if not queue:
            # A resume that empties says why in its own terms: its tickets were worked, or handed
            # back, while it was paused. Telling that operator to label an issue would be an answer
            # to a question they did not ask.
            say("  (everything the pause left has since been worked or handed back — nothing to "
                "resume)" if args.resume
                else f"  (nothing to work — label an issue {cfg['label']!r} to queue it)")
            return 0
        slots = build_slots(cfg, workers)
        if workers > 1:
            say("")
            say(f"slots ({workers} tickets at once)")
            for slot in slots:
                say(f"  {slot.describe()}")

        # Printed BEFORE the dry-run exits: which standalone a ticket will take is exactly the kind
        # of thing worth previewing, and it is the setting most likely to be wrong the first time.
        if args.dry_run:
            say("")
            say("--dry-run: preflight passed and the queue is above. Nothing was started.")
            return 0

        bases = prepare_bases(queue, cfg, ledger, say)
        queue = [j for j in queue if str(j["path"]) in bases]
        waves = plan_waves(queue, workers)
        if not queue:
            say("")
            say("no repository in the queue could be prepared; nothing was started.")
            # `summarise` is never reached on this path, so without this the invocation ends having
            # told nobody it ended. Each repository is already escalated by name above; this one
            # says the pool is over and the machine is free.
            notify(cfg, "finished", "pool finished: nothing could be prepared, no ticket started",
                   say, needs_human=True, counts={}, needs=[], tickets=0, log=str(say.path))
            return 1

        def pause_here(remaining: list[dict], suspended: list[dict]) -> None:
            """Stop, and leave behind everything `--resume` needs to carry on.

            The request is consumed at the same moment the plan is written, so the two cannot
            disagree about whether the pause has happened: a request that survived its own pause
            would stop the resumed run in its first wave.
            """
            clear_pause_request()
            if not (remaining or suspended):
                # Asked for during the last wave, which then finished. There is nothing to resume,
                # and writing an empty plan would leave `--resume` reporting a pause that never
                # cost anything.
                say("")
                say("a pause was asked for, but the queue finished first — nothing is left to "
                    "resume.")
                return
            write_pause_plan(args.config, workers, not cfg["retro"]["enabled"],
                             remaining, suspended, say, forced=queue_forced)
            say("")
            say(f"paused: {len(suspended)} ticket(s) suspended mid-run, {len(remaining)} not "
                "started. `pool-run --resume` continues from here.")

        def hand_back(left: list[list[dict]], suspended_now: list[dict] | None = None) -> None:
            """Pause, splitting what is LEFT by what each job is rather than by where it sat.

            The front of the queue can hold a wave that was suspended and re-entered, which the
            un-started queue must never receive: `resume_jobs` puts suspended tickets first, and one
            written into the other list would have the next resume work it from scratch, abandoning
            the very session the pause was taken to keep. That is `write_pause_plan`'s own rule; it
            reaches here because waiting out a reset is what first put such a job back on the queue.
            """
            held = [j for w in left for j in w]
            pause_here([j for j in held if not j.get("resume")],
                       (suspended_now or []) + [j for j in held if j.get("resume")])

        results = []
        # Consumed from the FRONT rather than iterated, because a wave the usage limit suspended goes
        # back on it: those tickets are mid-attempt with their sessions open, and what re-enters them
        # is another wave. The denominator moves with it, and truthfully — a run that waited out a
        # reset really does have one more wave to work than it did when it started.
        waves_left, done = list(waves), 0
        while waves_left:
            if stopping["flag"]:
                # "Untouched" is true of an un-started queue and false of a suspended session, which
                # holds a worktree and a transcript. Stopping over one without a plan would leave it
                # for `--resume` to find in the ledger alone, which works and reads as a crash.
                if any(j.get("resume") for w in waves_left for j in w):
                    hand_back(waves_left)
                else:
                    say("stopping as asked; the rest of the queue is untouched.")
                break
            if pause_requested():
                hand_back(waves_left)
                break
            wave, done = waves_left.pop(0), done + 1
            say("")
            total = done + len(waves_left)
            say(f"[wave {done}/{total}]" if workers > 1 else f"[{done}/{total}]")
            outcome = run_wave(wave, slots, cfg, ledger, say, bases)
            results += outcome
            # Two ways a wave can end in a pause, and the plan is the same either way: its own
            # sessions suspended themselves on an immediate pause, or a boundary pause was asked for
            # while it worked. Asked AFTER the wave rather than only before the next one so the last
            # wave of a queue can pause too — otherwise `--pause` during it is silently ignored and
            # the pool reports itself finished.
            suspended = [j for j in wave if dict(outcome).get(j["key"]) == "paused"]
            if suspended and not pause_requested() and not stopping["flag"]:
                # A pause with a clock on it. The window resets at an instant the CLI reported and
                # nothing is waiting on a decision, so the driver waits rather than ending the
                # invocation — which is what it used to do, leaving the box idle for the rest of the
                # window and the tickets for whenever somebody next looked at the terminal.
                again = wait_for_limit_reset(
                    suspended, load_json(LEDGER, {}), cfg, say,
                    lambda: stopping["flag"] or pause_requested() is not None)
                if again:
                    # The attempt is not over, so its `paused` is not an outcome: the summary counts
                    # outcomes, and a ticket that paused and then finished must appear once.
                    resumed = {j["key"] for j in again}
                    results = [(k, st) for k, st in results
                               if not (st == "paused" and k in resumed)]
                    waves_left.insert(0, again)
                    # And the retro barrier is not crossed on the way: it rewrites the skills a run
                    # reads, and this one is coming back to finish a ticket that started under the
                    # ones it has.
                    continue
            if suspended or pause_requested():
                hand_back(waves_left, suspended)
                break
            # The barrier. `skill-retro` rewrites the skills that a run reads, so it runs only when
            # nothing is in flight — which a wave boundary is and a rolling pool never is.
            if not stopping["flag"]:
                run_retro(cfg, say, force=False)

        # Asked for while the last wave, or the retro after it, was still running. The retro is
        # deliberately not interruptible, so this is the ordinary way a pause arrives too late.
        if pause_requested():
            clear_pause_request()
            say("")
            say("a pause was asked for, but the run finished first — nothing is left to resume.")

        summarise(results, cfg, say)
        say("")
        say(f"log: {say.path}")
        return 0
    except Exception as exc:
        # Nothing else can report this one: no summary is printed, the ledger keeps whatever each
        # ticket was last called, and the operator is not at the terminal — which is the premise of
        # pushing anything at all. Re-raised, so the traceback an operator reads is unchanged.
        notify(cfg, "driver-died", f"pool-run died: {type(exc).__name__}: {exc}"[:200], say,
               needs_human=True, error=f"{type(exc).__name__}: {exc}"[:500])
        raise
    finally:
        drop_lock()


if __name__ == "__main__":
    sys.exit(main())
