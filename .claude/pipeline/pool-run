# The sessions running right now, so a second interrupt can reach them. A first interrupt asks the
# driver to stop after the current wave — which is usually what you want, since a killed
# resolve-ticket leaves a half-worked branch — and a second one means it now. A SET, because with
# several tickets in flight "the current session" is not one thing, and an interrupt that reached
# only the most recently started one would leave the others running unattended with no driver.
LIVE: set = set()
LIVE_LOCK = threading.Lock()


def live_add(proc) -> None:
    with LIVE_LOCK:
        LIVE.add(proc)


def live_drop(proc) -> None:
    with LIVE_LOCK:
        LIVE.discard(proc)


def live_procs() -> list:
    with LIVE_LOCK:
        return [p for p in LIVE if p.poll() is None]

